		});
		function check_change(id){
		val=$("#checkbox"+id).attr("checked");
			if(val==true){
				if(id==1){
				$("#checkbox2").attr("checked","");
				$("#checkbox3").attr("checked","");
				}else{
					if(id==2){
					$("#checkbox1").attr("checked","");
					$("#checkbox3").attr("checked","");
					}else{
						if(id==3){
						$("#checkbox1").attr("checked","");
						$("#checkbox2").attr("checked","");
						}
					}
				}
			}
		}
	</script>

