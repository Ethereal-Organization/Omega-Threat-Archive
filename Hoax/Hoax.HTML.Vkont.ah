<script>
$(document).ready(function(){
 $('#searchField').placeholder('Поиск объявлений');
})

function gotoMarketPage(section, cat) {
 var q = '';
 if (ge('qinput').value && ge('qinput').value != 'Начните вводить любое слово или имя') {
 q = ge('qinput').value;
 };
 location.replace('search?c[section]=ads&c[type]='+section+'&c[category]='+cat+'&c[q]='+encodeURIComponent(winToUtf(q)));
}

</script>
