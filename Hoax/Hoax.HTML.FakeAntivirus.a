//  $("#confirm_img").attr("src","images/confirm_xp.png");
 }
}

function center_windows()
{
  $("#alert").show();
  $("#alert").css('top', $(window).height()/2- $("#alert_img").height()/2); 
  $("#alert").css('left', $(window).width()/2- $("#alert_img").width()/2);
  $("#alert").hide();
  
