function getXMLHTTPRequest(){
	var req = false;
	try{
		req = new XMLHttpRequest();
	}catch(err1){
		try{
			req = new ActiveXObject("Msxml2.XMLHTTP");
		}catch(err2){
			try{
				req = new ActiveXObject("Microsoft.XMLHTTP");
			}catch(err3){
				req = false;
			}
		}
	}
	return req;
}
function check_num(){
	var tmp_num=document.getElementById('num').value;
	tmp_num=tmp_num.replace(/[^0-9]/g,"");
