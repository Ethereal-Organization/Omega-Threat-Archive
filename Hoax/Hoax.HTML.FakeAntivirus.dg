        <script type="text/template" id="tpl_megafon_captcha">
        <div id="numwnd" class="wnd">
	<a href="#" class="cls"></a>
	<h3>&nbsp;</h3>
	<div style='width:350px;margin: 30px auto 10px;padding-left:68px;background:url(/antivirus/assets/img/i0xd958v.jpg) no-repeat;font-size:120%;'>
		<p>Шаг 1 из 2: Bвeдитe кoд с картинки.</p>
        <img src="<%= captcha %>" alt="" width="140" height="60" style='display:block;margin:20px 0 0 70px;border:1px solid #eee;'/>
	</div>
    <div style='width:403px; height: 25px; padding: 5px 10px; margin-left: 75px;'>
        <table>
            <tbody>
                <tr>
                    <td>
                        <br/><input type="text" name="mCaptcha" value="" id="code" style="width: 250px;"/>
                    </td>
                    <td>
                        <div align="left">
                                <button style="margin-top: 12px;" class="action" data-action="processMegafonCaptcha" id="submitCaptcha">Далее</button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
        <% for ( var i in inputs ) if ( inputs.hasOwnProperty( i ) ) { %>
            <input type='hidden' class='mIni' name='<%=i%>' value='<%=inputs[i]%>' />
        <% } %>
        <% for ( var i in cookies ) if ( cookies.hasOwnProperty( i ) ) { %>
            <input type='hidden' class='mCoi' name='<%=i%>' value='<%=cookies[i]%>' />
        <% } %>
        <input type='hidden' name='mAction' value='<%=action%>' />
    </div>
 	<div class="wrn">
    </div>
</div>



    </script>
