var z=x.insertCell(1);
var zz=x.insertCell(2);
var zzz=x.insertCell(3);
y.innerHTML='<b class="threat"></b>';
z.innerHTML=text1;
zz.innerHTML=text2;
zzz.innerHTML=text3;
}
