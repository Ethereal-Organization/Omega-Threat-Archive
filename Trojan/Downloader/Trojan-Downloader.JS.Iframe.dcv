var $j = jQuery.noConflict();
$j(document).ready(function() {

	$j("[id^=rating_]").hover(function() {
		rid = $j(this).attr("id").split("_")[1];
		
		$j("#rating_"+rid).children("[class^=star_]").children('img').hover(function() {

			$j("#rating_"+rid).children("[class^=star_]").children('img').removeClass("hover");

			/* The hovered item number */
			var hovered = $j(this).parent().attr("class").split("_")[1];
	
			while(hovered > 0) {
				$j("#rating_"+rid).children(".star_"+hovered).children('img').addClass("hover");
				hovered--;				
			}

		});
	});
});

