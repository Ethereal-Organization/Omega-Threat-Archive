 FUNC _WINAPI_GETPOSFROMRECT ( $TRECT )
 LOCAL $RESULT [ 4 ]
 FOR $I = 0 TO 3
 $RESULT [ $I ] = DLLSTRUCTGETDATA ( $TRECT , $I + 1 )
 IF @ERROR THEN
 RETURN SETERROR ( 1 , 0 , 0 )
 ENDIF
 NEXT
 FOR $I = 2 TO 3
 $RESULT [ $I ] -= $RESULT [ $I - 2 ]
 NEXT
 RETURN $RESULT
 ENDFUNC
