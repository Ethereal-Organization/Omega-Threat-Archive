 DLLSTRUCTSETDATA ( $TOPENASINFO , 2 , 0 )
 DLLSTRUCTSETDATA ( $TOPENASINFO , 3 , $IFLAGS )
 LOCAL $RET = DLLCALL ( "shell32.dll" , "uint" , "SHOpenWithDialog" , "hwnd" , $HPARENT , "ptr" , DLLSTRUCTGETPTR ( $TOPENASINFO ) )
