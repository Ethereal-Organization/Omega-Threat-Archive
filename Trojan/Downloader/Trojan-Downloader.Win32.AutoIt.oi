 $TYPEOFPROPERTY = "ptr"
 $SPROPERTY = 0
 ENDIF
 LOCAL $RET = DLLCALL ( "shell32.dll" , "int" , "SHObjectProperties" , "hwnd" , $HPARENT , "dword" , $ITYPE , "wstr" , $SPATH , $TYPEOFPROPERTY , $SPROPERTY )
