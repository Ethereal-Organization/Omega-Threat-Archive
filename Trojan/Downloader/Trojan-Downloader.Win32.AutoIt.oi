 FUNC _WINAPI_MESSAGEBEEP ( $ITYPE = 1 )
 LOCAL $ISOUND
 SWITCH $ITYPE
 CASE 1
 $ISOUND = 0
 CASE 2
 $ISOUND = 16
 CASE 3
 $ISOUND = 32
 CASE 4
 $ISOUND = 48
 CASE 5
 $ISOUND = 64
 CASE ELSE
 $ISOUND = - 1
 ENDSWITCH
 LOCAL $ARESULT = DLLCALL ( "user32.dll" , "bool" , "MessageBeep" , "uint" , $ISOUND )
 IF @ERROR THEN RETURN SETERROR ( @ERROR , @EXTENDED , FALSE )
 RETURN $ARESULT [ 0 ]
 ENDFUNC
