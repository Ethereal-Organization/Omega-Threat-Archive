 CASE $S_PROPERTY = "vcard"
 LOCAL $AVCARD [ 1 ] [ 29 ]
 $AVCARD [ 0 ] [ 0 ] = "Business.City"
 $AVCARD [ 0 ] [ 1 ] = "Business.Country"
 $AVCARD [ 0 ] [ 2 ] = "Business.Fax"
