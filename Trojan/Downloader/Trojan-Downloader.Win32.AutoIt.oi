 $S_HTML &= "<p>" & @CR
 $S_HTML &= "<div id=line2><a href='http://www.autoitscript.com'>AutoIt</a> is a wonderful automation scripting language.</div>" & @CR
 $S_HTML &= "<p>" & @CR
