 ENDIF
 ENDIF
 SWITCH $IATTRIBUTE
 CASE $DWMWA_NCRENDERING_ENABLED
 RETURN DLLSTRUCTGETDATA ( $TDATA , 1 )
 CASE ELSE
 RETURN $TDATA
 ENDSWITCH
 ENDFUNC
