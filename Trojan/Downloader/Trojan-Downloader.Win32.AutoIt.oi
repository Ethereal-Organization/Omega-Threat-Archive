 DLLSTRUCTSETDATA ( $TFLASH , "Timeout" , $ITIMEOUT )
 LOCAL $ARESULT = DLLCALL ( "user32.dll" , "bool" , "FlashWindowEx" , "ptr" , $PFLASH )
