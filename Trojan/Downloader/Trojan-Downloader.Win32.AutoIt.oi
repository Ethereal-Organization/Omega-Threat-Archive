 FUNC _WINAPI_STRLEN ( $HSTRING , $FUNICODE = 1 )
 LOCAL $W = ""
 IF $FUNICODE THEN
 $W = "W"
 ENDIF
 LOCAL $RET = DLLCALL ( "kernel32.dll" , "int" , "lstrlen" & $W , "ptr" , $HSTRING )
 IF @ERROR THEN
 RETURN SETERROR ( 1 , 0 , 0 )
 ENDIF
