 ENDIF
 DLLCALLBACKFREE ( $HENUMPROC )
 IF ISSTRING ( $SMODULE ) THEN
 _WINAPI_FREELIBRARY ( $HMODULE )
 ENDIF
 RETURN SETERROR ( NUMBER ( NOT $__DATA ) , 0 , $__DATA )
 ENDFUNC
