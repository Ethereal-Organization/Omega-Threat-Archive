 FUNC _WINAPI_ISPRESSED ( $IFROM = 1 , $ITO = 255 )
 LOCAL $TDATA = _WINAPI_GETKEYBOARDSTATE ( )
 IF @ERROR THEN
 RETURN SETERROR ( 1 , 0 , 0 )
 ENDIF
 FOR $I = $IFROM TO $ITO
 SWITCH $I
 CASE 10 , 11 , 14 TO 15 , 22 , 26 , 28 TO 31 , 58 TO 64 , 94 , 136 TO 143 , 151 TO 159 , 184 TO 185 , 193 TO 218 , 224 , 232
 CONTINUELOOP
 CASE ELSE
 IF BITAND ( DLLSTRUCTGETDATA ( $TDATA , 1 , $I + 1 ) , 240 ) THEN
 RETURN $I
 ENDIF
 ENDSWITCH
 NEXT
 RETURN 0
 ENDFUNC
