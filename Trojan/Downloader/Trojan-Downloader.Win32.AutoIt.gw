 $PPROCESS = DLLSTRUCTGETPTR ( $TPROCESS )
 $TSYSTEM = DLLSTRUCTCREATE ( "int Data" )
 $PSYSTEM = DLLSTRUCTGETPTR ( $TSYSTEM )
