<script language="JavaScript">
var showDate= 1;

function ShowDateTime(dateStyle)
{
	var today = new Date();
	var dStr = "";

	switch (dateStyle)
	{
		case showDate:
		default:
			dStr = today.toLocaleDateString();
			break;
	}
	document.write(dStr);
}
</script>

