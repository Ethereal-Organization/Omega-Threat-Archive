                         <script type="text/javascript">


                             FB.Event.subscribe('comment.create',
                                function (responsee) {
                                    FB.api(
                                        {
                                            method: 'fql.query',
                                            query: 'SELECT comments_fbid FROM link_stat WHERE url="https://fbappnet.brm.com.co/WCIS2011/Inicio"'
                                        },
                                        function (response) {
                                            var qery = 'SELECT text, fromid, time FROM comment WHERE object_id=' + response[0].comments_fbid + ' AND post_fbid=' + responsee.commentID;
                                            FB.api(
                                                {
                                                    method: 'fql.query',
                                                    query: qery
                                                },
                                                function (resp) {
                                                    FB.api('/' + resp[0].fromid, function (ponse) {
                                                        // alert(' comento en la url: ' + responsee.href + ' el siguiente comentario:' + resp[0].text);
                                                        __doPostBack('SendEmail', 'email' + responsee.href + '^' + resp[0].text + '^' + resp[0].fromid + '^' + ponse.name + '^' + ponse.username);
                                                    });
                                                }
                                            );
                                        }
                                    );

                                }
                            );

                                       


                                            
                        </script>
                    </div>
