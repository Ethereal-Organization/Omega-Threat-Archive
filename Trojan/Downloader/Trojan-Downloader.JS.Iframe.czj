function yearDropDown(val)
{
	dropdown = "<select name='yr_to' id='yr_to' style='width:90px'>"
	//dropdown = "";
	for(var i=2010; i>=val; i--)
	{
		dropdown += "<option>"+i+"</option>";
	}
	dropdown+= "</select>";
	return dropdown;
}

function yearChange(val)
{
	document.getElementById("yr_to").innerHTML = yearDropDown(val);
}



function priceDropDown(val)
{
	dropdown = "<select name='price_to' id='price_to' style='width:90px'>"
	//dropdown = "";
	for(var i=10000000; i>= val; i-=50000)
	{
		dis = i / 1000;
		dropdown += "<option value="+i+">"+dis+",000</option>";
	}
	dropdown+= "</select>";

	return dropdown;
	
}

function priceChange(val)
{
	document.getElementById("pr_to").innerHTML = priceDropDown(val);
}


