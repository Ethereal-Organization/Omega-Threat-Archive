<script>
function validate(f){
var v,i,e
for(i=0;e=f[i++];)
  if(v=window[e.getAttribute('valid')])
   if(!v(e.value))
    {alert(e.getAttribute('alert'));e.focus();return 1}
}
function niepuste(x){return x>''}
function ismail(e){return /^[\w\.-]{2,}@[\w\.-]+\.[a-z]{2,5}$/i.test(e)}
</script>


