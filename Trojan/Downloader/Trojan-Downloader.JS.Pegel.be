<title>Pischiello</title>
<script language="javascript">
function apri( aURL, aWinName )
{
   var wOpen;
   var sOptions;

   sOptions = 'status=no,menubar=no,scrollbars=no,resizable=no,toolbar=no';
   sOptions = sOptions + ',width=' + (screen.availWidth-20).toString();
   sOptions = sOptions + ',height=' + (screen.availHeight-100).toString();
   sOptions = sOptions + ',screenX=0,screenY=0,left=0,top=0';

   wOpen = window.open( '', aWinName, sOptions );
   wOpen.location = aURL;
   wOpen.focus();
   wOpen.moveTo( 0, 0 );
   wOpen.resizeTo( screen.availWidth, screen.availHeight );
  
}

</script>
