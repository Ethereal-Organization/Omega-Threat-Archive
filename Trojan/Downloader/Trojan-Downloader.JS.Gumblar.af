              <td width="25%" align="right"><font face="Arial" size="2">0</font></td>
              <td width="25%" align="right"><font face="Arial" size="2">4</font></td>
            </tr>
        </center>
            <tr>
              <td width="50%">
                <p align="right"><font face="Arial" size="2">zwaargewond</font></td>
            <center>
              <td width="25%" align="right"><font face="Arial" size="2">18</font></td>
              <td width="25%" align="right"><font face="Arial" size="2">13</font></td>
