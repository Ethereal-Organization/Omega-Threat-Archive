}
function ImageOff()
{
	for (x=1; x<=5; x++)
	{
		document['rating_' + x].src = '../../images/star_fade.gif';
	}
}	
function SubmitVote(id,rating)
{
	url='../../vote.php?id=' + id + '&r=' + rating;
	document.getElementById("rating").innerHTML='<img src="../../images/working.gif" /><br />';
