    <tr>
      <td height="53" bgcolor="#FF0000"><div align="center" class="style42">
        <hr />
        <p class="style43">&#3648;&#3588;&#3619;&#3639;&#3656;&#3629;&#3591;&#3592;&#3633;&#3585;&#3626;&#3634;&#3609;&#3616;&#3634;&#3588;&#3648;&#3627;&#3609;&#3639;&#3629;</p>
        <hr />
      </div></td></tr>
    <tr>
      <td height="371" bordercolor="#000000" bgcolor="#000000"><p align="left">&nbsp;</p>
        <p align="justify"><span class="style45"><span class="style47">&#3595;&#3657;&#3634;&#3627;&#3623;&#3604;</span> &#3648;&#3611;&#3655;&#3609;&#3616;&#3634;&#3594;&#3609;&#3632;&#3626;&#3634;&#3609;&#3604;&#3657;&#3623;&#3618;&#3652;&#3617;&#3657;&#3652;&#3612;&#3656; &#3626;&#3641;&#3591;&#3611;&#3619;&#3632;&#3617;&#3634;&#3603; 9 &#3609;&#3636;&#3657;&#3623; &#3648;&#3626;&#3657;&#3609;&#3619;&#3629;&#3610;&#3623;&#3591;&#3611;&#3619;&#3632;&#3617;&#3634;&#3603; 30 &#3609;&#3636;&#3657;&#3623; &#3585;&#3657;&#3609;&#3648;&#3627;&#3621;&#3637;&#3656;&#3618;&#3617; <br />
  &#3611;&#3634;&#3585;&#3585;&#3621;&#3617;&#3651;&#3594;&#3657;&#3651;&#3626;&#3656;&#3586;&#3657;&#3634;&#3623;&#3648;&#3627;&#3609;&#3637;&#3618;&#3623;&#3627;&#3621;&#3633;&#3591; &#3592;&#3634;&#3585;&#3649;&#3594;&#3656;&#3609;&#3657;&#3635;&#3652;&#3623;&#3657;&#3611;&#3621;&#3656;&#3629;&#3618;&#3651;&#3627;&#3657;&#3626;&#3632;&#3648;&#3604;&#3655;&#3604;&#3609;&#3657;&#3635;   &#3585;&#3656;&#3629;&#3609;&#3609;&#3635;&#3652;&#3611;&#3651;&#3626;&#3656;&#3652;&#3627;&#3586;&#3657;&#3634;&#3623;&#3609;&#3638;&#3656;&#3591; <br />
        </span></p>
        <p align="center"><img src="../../image/33333333333333.jpg" width="187" height="115" /></p>
        <p align="justify"><span class="style45"><span class="style47">&#3585;&#3656;&#3629;&#3591;&#3586;&#3657;&#3634;&#3623;</span> &#3648;&#3611;&#3655;&#3609;&#3616;&#3634;&#3594;&#3609;&#3632;&#3626;&#3635;&#3627;&#3619;&#3633;&#3610;&#3651;&#3626;&#3656;&#3586;&#3657;&#3634;&#3623;&#3627;&#3609;&#3637;&#3618;&#3623; </span><span class="style49"><br />
          </span></p>
        <p align="justify"><span class="style49"><span class="style47">&#3649;&#3629;&#3657;&#3610;&#3586;&#3657;&#3634;&#3623;</span></span> <span class="style45">&#3627;&#3619;&#3639;&#3629;   &#3649;&#3629;&#3610;&#3586;&#3657;&#3634;&#3623; &#3648;&#3611;&#3655;&#3609;&#3616;&#3634;&#3594;&#3609;&#3632;&#3651;&#3626;&#3656;&#3586;&#3657;&#3634;&#3623;&#3648;&#3627;&#3609;&#3637;&#3618;&#3623;&#3648;&#3627;&#3617;&#3639;&#3629;&#3609;&#3585;&#3656;&#3629;&#3591;&#3586;&#3657;&#3634;&#3623;&#3649;&#3605;&#3656;&#3586;&#3609;&#3634;&#3604;&#3648;&#3621;&#3655;&#3585;&#3585;&#3623;&#3656;&#3634; <br />
        </span></p>
        <p align="justify"><span class="style45"><span class="style48"><strong>&#3650;&#3605;&#3585;</strong></span> &#3648;&#3611;&#3655;&#3609;&#3607;&#3637;&#3656;&#3623;&#3634;&#3591;&#3585;&#3633;&#3610;&#3586;&#3657;&#3634;&#3623;&#3588;&#3621;&#3657;&#3634;&#3618;&#3650;&#3605;&#3658;&#3632;&#3629;&#3634;&#3627;&#3634;&#3619; &#3617;&#3637;&#3619;&#3641;&#3611;&#3619;&#3656;&#3634;&#3591;&#3585;&#3621;&#3617;   &#3617;&#3637;&#3586;&#3634;&#3626;&#3641;&#3591;&#3611;&#3619;&#3632;&#3617;&#3634;&#3603; 1 &#3615;&#3640;&#3605;&#3617;&#3637;&#3607;&#3633;&#3657;&#3591;&#3607;&#3637;&#3656;&#3626;&#3634;&#3609;&#3604;&#3657;&#3623;&#3618; <br />
  &#3652;&#3617;&#3657;&#3652;&#3612;&#3656;&#3649;&#3621;&#3632;&#3627;&#3623;&#3634;&#3618; &#3649;&#3621;&#3632;&#3607;&#3637;&#3656;&#3607;&#3635;&#3604;&#3657;&#3623;&#3618;&#3652;&#3617;&#3657;&#3626;&#3633;&#3585;   &#3610;&#3634;&#3591;&#3607;&#3637;&#3585;&#3655;&#3648;&#3619;&#3637;&#3618;&#3585; &#3586;&#3633;&#3609;&#3650;&#3605;&#3585; <br />
        </span></p>
        <p align="justify"><span class="style45"><strong><span class="style48">&#3585;&#3640;&#3658;&#3610; </span>&#3627;&#3619;&#3639;&#3629; <span class="style48">&#3627;&#3617;&#3623;&#3585;&#3591;&#3629;&#3610;</span></strong> &#3626;&#3634;&#3609;&#3604;&#3657;&#3623;&#3618;&#3651;&#3610;&#3605;&#3634;&#3621;&#3627;&#3619;&#3639;&#3629;&#3651;&#3610;&#3652;&#3617;&#3657;&#3652;&#3612;&#3656; &#3585;&#3640;&#3658;&#3610;&#3607;&#3637;&#3656;&#3621;&#3635;&#3611;&#3634;&#3591;&#3588;&#3621;&#3657;&#3634;&#3618;&#3591;&#3629;&#3610;&#3616;&#3634;&#3588;&#3585;&#3621;&#3634;&#3591;&#3649;&#3605;&#3656;&#3648;&#3605;&#3637;&#3657;&#3618; <br />
  &#3649;&#3621;&#3632;&#3649;&#3610;&#3609;&#3585;&#3623;&#3656;&#3634;   &#3626;&#3656;&#3623;&#3609;&#3585;&#3640;&#3658;&#3610;&#3586;&#3629;&#3591;&#3648;&#3594;&#3637;&#3618;&#3591;&#3651;&#3627;&#3617;&#3656;&#3617;&#3637;&#3650;&#3588;&#3619;&#3591;&#3585;&#3621;&#3617;&#3588;&#3621;&#3657;&#3634;&#3618;&#3612;&#3621;&#3626;&#3657;&#3617;&#3612;&#3656;&#3634;&#3595;&#3637;&#3585; &#3611;&#3637;&#3585;&#3585;&#3623;&#3657;&#3634;&#3591; &#3585;&#3640;&#3658;&#3610;&#3648;&#3617;&#3639;&#3629;&#3591; <br />
  &#3649;&#3614;&#3619;&#3656;&#3626;&#3656;&#3623;&#3609;&#3607;&#3637;&#3656;&#3648;&#3611;&#3655;&#3609;&#3605;&#3633;&#3623;&#3591;&#3629;&#3610;&#3592;&#3632;&#3588;&#3656;&#3629;&#3618;&#3654;&#3621;&#3604;&#3594;&#3633;&#3657;&#3609;&#3648;&#3621;&#3655;&#3585;&#3654;&#3621;&#3591;&#3652;&#3611; 2 &#3594;&#3633;&#3657;&#3609; &#3592;&#3609;&#3606;&#3638;&#3591;&#3585;&#3619;&#3632;&#3627;&#3617;&#3656;&#3629;&#3617;&#3591;&#3629;&#3610; <br />
        </span></p>
        <p align="center"><img src="../../image/5555555555.jpg" width="220" height="123" /></p>
        <p align="justify"><span class="style45"><span class="style48"><strong>&#3627;&#3617;&#3623;&#3585;&#3626;&#3634;&#3609;</strong></span> &#3648;&#3611;&#3655;&#3609;&#3648;&#3588;&#3619;&#3639;&#3656;&#3629;&#3591;&#3626;&#3623;&#3617;&#3624;&#3619;&#3637;&#3625;&#3632;&#3611;&#3619;&#3632;&#3648;&#3616;&#3607;&#3585;&#3640;&#3658;&#3610;&#3627;&#3619;&#3639;&#3629;&#3591;&#3629;&#3610; &#3609;&#3636;&#3618;&#3617;&#3607;&#3635;&#3585;&#3633;&#3609;&#3617;&#3634;&#3585;&#3607;&#3637;&#3656; &#3592;. &#3621;&#3635;&#3614;&#3641;&#3609; &#3650;&#3604;&#3618;&#3648;&#3593;&#3614;&#3634;&#3632;&#3607;&#3637;&#3656; <br />
  &#3605;.&#3610;&#3657;&#3634;&#3609;&#3649;&#3611;&#3657;&#3609; <br />
        </span></p>
        <p align="justify"><span class="style45"><span class="style48"><strong>&#3585;&#3659;&#3623;&#3618;</strong></span> &#3648;&#3611;&#3655;&#3609;&#3616;&#3634;&#3594;&#3609;&#3632;&#3648;&#3594;&#3656;&#3609;&#3648;&#3604;&#3637;&#3618;&#3623;&#3585;&#3633;&#3610;&#3648;&#3586;&#3656;&#3591;&#3586;&#3629;&#3591;&#3616;&#3634;&#3588;&#3585;&#3621;&#3634;&#3591; &#3651;&#3594;&#3657;&#3651;&#3626;&#3656;&#3626;&#3636;&#3656;&#3591;&#3586;&#3629;&#3591;&#3605;&#3656;&#3634;&#3591;&#3654; &#3606;&#3657;&#3634;&#3651;&#3626;&#3656;&#3627;&#3617;&#3641;&#3648;&#3619;&#3637;&#3618;&#3585; &#3585;&#3659;&#3623;&#3618;&#3627;&#3617;&#3641; <br />
  &#3651;&#3626;&#3656;&#3652;&#3585;&#3656;&#3648;&#3619;&#3637;&#3618;&#3585; &#3585;&#3659;&#3623;&#3618;&#3652;&#3585;&#3656; &#3631;&#3621;&#3631; <br />
        </span></p>
        <p align="justify"><span class="style45"><span class="style48"><strong>&#3648;&#3586;&#3656;&#3591;&#3621;&#3635;&#3652;&#3618;</strong></span> &#3648;&#3611;&#3655;&#3609;&#3616;&#3634;&#3594;&#3609;&#3632;&#3626;&#3634;&#3609;&#3604;&#3657;&#3623;&#3618;&#3652;&#3617;&#3657;&#3652;&#3612;&#3656; &#3651;&#3594;&#3657;&#3651;&#3626;&#3656;&#3621;&#3635;&#3651;&#3618; &#3585;&#3657;&#3609;&#3648;&#3627;&#3621;&#3637;&#3656;&#3618;&#3617; &#3611;&#3634;&#3585;&#3585;&#3621;&#3617; &#3617;&#3637;&#3586;&#3629;&#3610;&#3611;&#3634;&#3585;&#3648;&#3617;&#3657;&#3617;&#3604;&#3657;&#3623;&#3618;&#3605;&#3629;&#3585; <br />
          </span></p>
        <p align="justify"><span class="style45"><span class="style48"><strong>&#3595;&#3657;&#3634;&#3621;&#3629;&#3617; &#3627;&#3619;&#3639;&#3629;&#3594;&#3632;&#3621;&#3629;&#3617;</strong></span> &#3648;&#3611;&#3655;&#3609;&#3616;&#3634;&#3594;&#3609;&#3632;&#3651;&#3626;&#3656;&#3586;&#3629;&#3591;&#3626;&#3634;&#3609;&#3604;&#3657;&#3623;&#3618;&#3621;&#3634;&#3618;&#3648;&#3593;&#3621;&#3634;&#3605;&#3634;&#3627;&#3656;&#3634;&#3591;&#3654; &#3651;&#3594;&#3657;&#3651;&#3626;&#3656;&#3586;&#3629;&#3591;&#3648;&#3604;&#3636;&#3609;&#3607;&#3634;&#3591; <br />
  &#3595;&#3657;&#3634;&#3605;&#3634;&#3627;&#3656;&#3634;&#3591;   &#3617;&#3637;&#3621;&#3633;&#3585;&#3625;&#3603;&#3632;&#3588;&#3621;&#3657;&#3634;&#3618;&#3585;&#3619;&#3632;&#3610;&#3640;&#3591;&#3627;&#3619;&#3639;&#3629; &#3648;&#3611;&#3637;&#3658;&#3618;&#3604; &#3626;&#3634;&#3609;&#3604;&#3657;&#3623;&#3618;&#3605;&#3629;&#3585;&#3604;&#3652;&#3617;&#3657;&#3652;&#3612;&#3656; &#3621;&#3634;&#3618;&#3626;&#3634;&#3609;&#3627;&#3656;&#3634;&#3591;&#3654;&#3648;&#3617;&#3657;&#3617;&#3586;&#3629;&#3610;&#3604;&#3657;&#3623;&#3618; <br />
  &#3605;&#3629;&#3585;&#3651;&#3609;&#3605;&#3633;&#3623; &#3651;&#3594;&#3657;&#3651;&#3626;&#3656;&#3586;&#3629;&#3591;&#3651;&#3627;&#3627;&#3597;&#3656;&#3654; &#3648;&#3594;&#3656;&#3609;&#3612;&#3633;&#3585; &#3627;&#3597;&#3657;&#3634; &#3617;&#3637;&#3651;&#3594;&#3657;&#3617;&#3634;&#3585;&#3649;&#3606;&#3610; &#3592;.&#3609;&#3656;&#3634;&#3609; &#3592;.&#3649;&#3614;&#3619;&#3656; <br />
  &#3595;&#3657;&#3634;&#3605;&#3634;&#3607;&#3638;&#3610;   &#3627;&#3619;&#3639;&#3629; &#3610;&#3640;&#3591;&#3605;&#3637;&#3610; &#3648;&#3611;&#3655;&#3609;&#3616;&#3634;&#3594;&#3609;&#3632;&#3588;&#3621;&#3657;&#3634;&#3618;&#3585;&#3619;&#3632;&#3610;&#3640;&#3591; &#3627;&#3619;&#3639;&#3629;&#3595;&#3657;&#3634;&#3605;&#3634;&#3627;&#3656;&#3634;&#3591; &#3649;&#3605;&#3656;&#3626;&#3634;&#3609;&#3604;&#3657;&#3623;&#3618;&#3621;&#3634;&#3618;&#3621;&#3632;&#3648;&#3629;&#3637;&#3618;&#3604;&#3607;&#3638;&#3610; &#3617;&#3637;&#3627;&#3641; <br />
  &#3652;&#3617;&#3656;&#3648;&#3586;&#3657;&#3634;&#3586;&#3629;&#3610; &#3649;&#3605;&#3656;&#3648;&#3585;&#3655;&#3610;&#3619;&#3636;&#3617;&#3651;&#3609;&#3605;&#3633;&#3623; &#3617;&#3637;&#3651;&#3594;&#3657;&#3617;&#3634;&#3585;&#3651;&#3609; &#3592;. &#3609;&#3656;&#3634;&#3609; <br />
        </span></p>
        <p align="justify"><span class="style45"><span class="style48"><strong>&#3609;&#3657;&#3635;&#3606;&#3640;&#3657;&#3591; &#3627;&#3619;&#3639;&#3629; &#3609;&#3657;&#3635;&#3607;&#3640;&#3656;&#3591; </strong></span>&#3648;&#3611;&#3655;&#3609;&#3616;&#3634;&#3594;&#3609;&#3632;&#3626;&#3634;&#3609;&#3604;&#3657;&#3623;&#3618;&#3652;&#3617;&#3657;&#3652;&#3612;&#3656;&#3618;&#3634;&#3604;&#3657;&#3623;&#3618;&#3594;&#3633;&#3609;   &#3621;&#3633;&#3585;&#3625;&#3603;&#3632;&#3588;&#3621;&#3657;&#3634;&#3618;&#3585;&#3619;&#3623;&#3618;&#3627;&#3591;&#3634;&#3618; &#3617;&#3637;&#3627;&#3641;&#3607;&#3635; <br />
  &#3604;&#3657;&#3623;&#3618;&#3652;&#3617;&#3657;&#3626; &#3635;&#3627;&#3619;&#3633;&#3610;&#3605;&#3633;&#3585;&#3609;&#3657;&#3635; &#3626;&#3634;&#3623;&#3586;&#3638;&#3657;&#3609;&#3617;&#3634;&#3592;&#3634;&#3585;&#3610;&#3656;&#3629;&#3609;&#3657;&#3635; <br />
        </span></p>
        <p align="justify"><span class="style45"><span class="style48"><strong>&#3609;&#3657;&#3635;&#3648;&#3605;&#3657;&#3634;</strong></span> &#3648;&#3611;&#3655;&#3609;&#3616;&#3634;&#3594;&#3609;&#3632;&#3626;&#3635;&#3627;&#3619;&#3633;&#3610;&#3651;&#3626;&#3656;&#3609;&#3657;&#3635;&#3648;&#3604;&#3636;&#3609;&#3607;&#3634;&#3591;&#3650;&#3604;&#3618;&#3651;&#3594;&#3657;&#3612;&#3621;&#3609;&#3657;&#3635;&#3648;&#3605;&#3657;&#3634;&#3649;&#3627;&#3657;&#3591; &#3649;&#3621;&#3657;&#3623;&#3626;&#3634;&#3609;&#3627;&#3619;&#3639;&#3629;&#3606;&#3633;&#3585;&#3627;&#3640;&#3657;&#3617;&#3604;&#3657;&#3623;&#3618;&#3627;&#3623;&#3634;&#3618; <br />
          </span></p>
        <p align="justify"><span class="style45"><span class="style48"><strong>&#3588;&#3640; &#3627;&#3619;&#3639;&#3629; &#3588;&#3619;&#3640;</strong></span> &#3648;&#3611;&#3655;&#3609;&#3616;&#3634;&#3594;&#3609;&#3632;&#3586;&#3609;&#3634;&#3604;&#3651;&#3627;&#3597;&#3656;   &#3626;&#3634;&#3609;&#3604;&#3657;&#3623;&#3618;&#3652;&#3617;&#3657;&#3652;&#3612;&#3656;&#3588;&#3621;&#3657;&#3634;&#3618;&#3585;&#3619;&#3632;&#3610;&#3640;&#3591; &#3627;&#3619;&#3639;&#3629;&#3585;&#3619;&#3632;&#3604;&#3657;&#3591;&#3586;&#3609;&#3634;&#3604;&#3651;&#3627;&#3597;&#3656; <br />
  &#3651;&#3594; &#3657;&#3626;&#3635;&#3627;&#3619;&#3633;&#3610;&#3609;&#3623;&#3604;&#3586;&#3657;&#3634;&#3623;&#3627;&#3619;&#3639;&#3629;   &#3605;&#3637;&#3586;&#3657;&#3634;&#3623;&#3648;&#3611;&#3621;&#3639;&#3629;&#3585;&#3651;&#3627;&#3657;&#3627;&#3621;&#3640;&#3604;&#3592;&#3634;&#3585;&#3619;&#3623;&#3591; <br />
        </span></p>
        <p align="justify"><span class="style45"><span class="style48"><strong>&#3623;&#3637;</strong></span> &#3648;&#3611;&#3655;&#3609;&#3614;&#3633;&#3604;&#3586;&#3609;&#3634;&#3604;&#3651;&#3627;&#3597;&#3656; &#3651;&#3594;&#3657;&#3614;&#3633;&#3604;&#3648;&#3629;&#3634;&#3648;&#3624;&#3625;&#3627;&#3597;&#3657;&#3634;&#3649;&#3621;&#3632;&#3615;&#3634;&#3591; &#3627;&#3619;&#3639;&#3629;&#3586;&#3637;&#3657;&#3619;&#3637;&#3610;&#3629;&#3629;&#3585;&#3592;&#3634;&#3585;&#3619;&#3623;&#3591;&#3586;&#3657;&#3634;&#3623; <br />
          </span></p>
        <p align="justify"><span class="style45"><span class="style48"><strong>&#3605;&#3656;&#3634;&#3591; &#3626;&#3633;&#3604; </strong></span>&#3627;&#3619;&#3639;&#3629; &#3606;&#3633;&#3591;&#3605;&#3623;&#3591;&#3586;&#3657;&#3634;&#3623; &#3619;&#3641;&#3611;&#3619;&#3656;&#3634;&#3591;&#3588;&#3621;&#3657;&#3634;&#3618;&#3648;&#3611;&#3637;&#3658;&#3618;&#3604;&#3627;&#3619;&#3639;&#3629;&#3610;&#3640;&#3591; 1   &#3605;&#3656;&#3634;&#3591; &#3648;&#3607;&#3656;&#3634;&#3585;&#3633;&#3610; 14 &#3621;&#3636;&#3605;&#3619;&#3626;&#3634;&#3609;&#3604;&#3657;&#3623;&#3618;&#3652;&#3612;&#3656;&#3649;&#3621;&#3632;&#3627;&#3623;&#3634;&#3618;</span></p>
        <p align="center"><img src="../../image/111111111.jpg" width="228" height="135" /> </p>
        <p align="left"><span class="style45"><span class="style48"><strong>&#3648;&#3611;&#3637;&#3658;&#3618;&#3604;</strong></span> &#3610;&#3634;&#3591;&#3607;&#3637;&#3656;&#3585;&#3655;&#3648;&#3619;&#3637;&#3618;&#3585;&#3623;&#3656;&#3634; &#3610;&#3640;&#3591;   &#3626;&#3634;&#3609;&#3604;&#3657;&#3623;&#3618;&#3652;&#3617;&#3657;&#3652;&#3612;&#3656;&#3588;&#3621;&#3657;&#3634;&#3618;&#3585;&#3619;&#3632;&#3610;&#3640;&#3591;&#3616;&#3634;&#3588;&#3585;&#3621;&#3634;&#3591; &#3617;&#3637;&#3586;&#3629;&#3610;&#3652;&#3617;&#3657;&#3652;&#3612;&#3656;&#3607;&#3637;&#3656;&#3611;&#3634;&#3585; &#3648;&#3611;&#3637;&#3658;&#3618;&#3604;&#3627;&#3619;&#3639;&#3629;&#3610;&#3640;&#3591; <br />
  &#3617;&#3633;&#3585;&#3607;&#3635;&#3648;&#3611;&#3655;&#3609;&#3588;&#3641;&#3656;&#3654; &#3626;&#3635;&#3627;&#3619;&#3633;&#3610;&#3627;&#3634;&#3610;&#3586;&#3657;&#3634;&#3623; &#3606;&#3633;&#3656;&#3623; &#3591;&#3634; &#3619;&#3635; &#3631;&#3621;&#3631; <br />
        </span></p>
        <p align="left"><span class="style45"><span class="style48"><strong>&#3610;&#3640;&#3656;&#3591;</strong></span> &#3627;&#3619;&#3639;&#3629;&#3610;&#3640;&#3657;&#3591;&#3586;&#3657;&#3634;&#3623;&#3648;&#3592;&#3639;&#3658;&#3629; &#3648;&#3611;&#3655;&#3609;&#3616;&#3634;&#3594;&#3609;&#3632;&#3626;&#3634;&#3609;&#3604;&#3657;&#3623;&#3618;&#3652;&#3617;&#3657;&#3652;&#3612;&#3656;   &#3607;&#3637;&#3656;&#3651;&#3627;&#3597;&#3656;&#3585;&#3623;&#3656;&#3634; &#3648;&#3611;&#3637;&#3658;&#3618;&#3604; &#3651;&#3594;&#3657;&#3626;&#3635;&#3627;&#3619;&#3633;&#3610;&#3648;&#3585;&#3655;&#3610;&#3648;&#3617;&#3621;&#3655;&#3604;&#3614;&#3633;&#3609;&#3608;&#3640;&#3660;&#3586;&#3657;&#3634;&#3623; <br />
          </span></p>
        <p align="left"><span class="style45"><span class="style47">&#3648;&#3611;&#3621;&#3648;&#3604;&#3655;&#3585;</span> &#3648;&#3611;&#3655;&#3609;&#3607;&#3637;&#3656;&#3609;&#3629;&#3609;&#3626;&#3635;&#3627;&#3619;&#3633;&#3610;&#3648;&#3604;&#3655;&#3585;   &#3626;&#3634;&#3609;&#3604;&#3657;&#3623;&#3618;&#3652;&#3617;&#3657;&#3652;&#3612;&#3656;&#3617;&#3637;&#3627;&#3641;&#3626;&#3635;&#3627;&#3619;&#3633;&#3610;&#3649;&#3586;&#3623;&#3609;&#3648;&#3614;&#3639;&#3656;&#3629;&#3651;&#3627;&#3657;&#3649;&#3585;&#3623;&#3656;&#3591;&#3652;&#3585;&#3623;&#3652;&#3604;&#3657; <br />
          </span></p>
        <p align="left"><span class="style45"><span class="style48"><strong>&#3648;&#3629;&#3636;&#3610;</strong></span> &#3648;&#3611;&#3655;&#3609;&#3616;&#3634;&#3594;&#3609;&#3632;&#3626;&#3635;&#3627;&#3619;&#3633;&#3610;&#3651;&#3626;&#3656;&#3648;&#3626;&#3639;&#3657;&#3629;&#3612;&#3657;&#3634;&#3586;&#3657;&#3634;&#3623;&#3586;&#3629;&#3591;&#3605;&#3656;&#3634;&#3591;&#3654;   &#3648;&#3611;&#3655;&#3609;&#3619;&#3641;&#3611;&#3585;&#3621;&#3656;&#3629;&#3591;&#3626;&#3637;&#3656;&#3648;&#3627;&#3621;&#3637;&#3656;&#3618;&#3617;&#3617;&#3637;&#3613;&#3634; &#3626;&#3634;&#3609;&#3604;&#3657;&#3623;&#3618;&#3652;&#3612;&#3656;&#3649;&#3621;&#3632;&#3627;&#3623;&#3634;&#3618; <br />
          </span></p>
        <p align="left"><span class="style45"><span class="style48"><strong>&#3652;&#3595; </strong></span>&#3648;&#3611;&#3655;&#3609;&#3648;&#3588;&#3619;&#3639;&#3656;&#3629;&#3591;&#3604;&#3633;&#3585;&#3592;&#3633;&#3610;&#3626;&#3633;&#3605;&#3623;&#3660;&#3609;&#3657;&#3635;&#3592;&#3635;&#3614;&#3623;&#3585; &#3585;&#3640;&#3657;&#3591; &#3611;&#3641; &#3611;&#3621;&#3634; &#3626;&#3634;&#3609;&#3604;&#3657;&#3623;&#3618;&#3652;&#3617;&#3657;&#3652;&#3612;   &#3617;&#3637;&#3619;&#3641;&#3611;&#3607;&#3619;&#3591;&#3649;&#3621;&#3632;&#3586;&#3609;&#3634;&#3604;&#3605;&#3656;&#3634;&#3591;&#3654; <br />
          </span></p>
        <p align="left"><span class="style45"><span class="style48"><strong>&#3626;&#3640;&#3656;&#3617;</strong></span> &#3648;&#3611;&#3655;&#3609;&#3648;&#3588;&#3619;&#3639;&#3656;&#3629;&#3591;&#3617;&#3639;&#3629;&#3592;&#3633;&#3611;&#3621;&#3634;&#3594;&#3609;&#3636;&#3604;&#3627;&#3609;&#3638;&#3656;&#3591; &#3619;&#3641;&#3611;&#3619;&#3656;&#3634;&#3591;&#3588;&#3621;&#3657;&#3634;&#3618;&#3585;&#3619;&#3623;&#3618;&#3588;&#3623;&#3656;&#3635;   &#3604;&#3633;&#3604;&#3604;&#3657;&#3634;&#3609;&#3649;&#3627;&#3621;&#3617;&#3648;&#3611;&#3655;&#3609;&#3594;&#3656;&#3629;&#3591;&#3626;&#3635;&#3627;&#3619;&#3633;&#3610;&#3651;&#3594;&#3657;&#3617;&#3639;&#3629; <br />
  &#3621;&#3657;&#3623;&#3591;&#3621;&#3591;&#3652;&#3611;&#3592;&#3633;&#3610;&#3611;&#3621;&#3634; &#3651;&#3594;&#3657;&#3592;&#3633;&#3610;&#3611;&#3621;&#3634;&#3651;&#3609;&#3611;&#3619;&#3636;&#3648;&#3623;&#3603;&#3609;&#3657;&#3635;&#3605;&#3639;&#3657;&#3609;&#3654; <br />
        </span></p>
        <p align="left"><span class="style45"><span class="style48"><strong>&#3586;&#3657;&#3629;&#3591; </strong></span>&#3648;&#3611;&#3655;&#3609;&#3616;&#3634;&#3594;&#3609;&#3632;&#3626;&#3635;&#3627;&#3619;&#3633;&#3610;&#3651;&#3626;&#3656;&#3626;&#3633;&#3605;&#3623;&#3660;&#3592;&#3635;&#3614;&#3623;&#3585; &#3585;&#3640;&#3657;&#3591; &#3611;&#3641;   &#3611;&#3621;&#3634; &#3619;&#3641;&#3611;&#3607;&#3619;&#3591;&#3585;&#3621;&#3617; &#3611;&#3656;&#3629;&#3591; &#3588;&#3629;&#3588;&#3629;&#3604; &#3613;&#3634;&#3588;&#3619;&#3629;&#3610;&#3617;&#3637;&#3591;&#3634; <br />
  &#3626;&#3635;&#3627;&#3619;&#3633;&#3610;&#3651;&#3626;&#3656;&#3611;&#3621;&#3634;&#3621;&#3629;&#3604;&#3621;&#3591;&#3652;&#3611;&#3650;&#3604;&#3618;&#3652;&#3617;&#3656;&#3605;&#3657;&#3629;&#3591;&#3648;&#3611;&#3636;&#3604;&#3613;&#3634;   &#3617;&#3637;&#3627;&#3641;&#3626;&#3635;&#3627;&#3619;&#3633;&#3610;&#3627;&#3636;&#3657;&#3623;&#3627;&#3619;&#3639;&#3629;&#3626;&#3632;&#3614;&#3634;&#3618;&#3610;&#3656;&#3634; <br />
        </span></p>
        <p align="left"><span class="style45"><span class="style48"><strong>&#3629;&#3637;&#3592;&#3641;&#3657; </strong></span>&#3648;&#3611;&#3655;&#3609;&#3616;&#3634;&#3594;&#3609;&#3632;&#3626;&#3634;&#3609;&#3604;&#3657;&#3623;&#3618;&#3652;&#3617;&#3657;&#3652;&#3612;&#3656; &#3617;&#3637;&#3591;&#3634;&#3626;&#3635;&#3627;&#3619;&#3633;&#3610;&#3604;&#3633;&#3585;&#3611;&#3621;&#3634;&#3650;&#3604;&#3618;&#3617;&#3637;&#3648;&#3627;&#3618;&#3639;&#3656;&#3629;&#3621;&#3656;&#3629; <br />
          </span></p>
        <p align="left"><span class="style45"><span class="style48"><strong>&#3613;&#3633;&#3585;&#3617;&#3637;&#3604;</strong></span> &#3648;&#3611;&#3655;&#3609;&#3613;&#3633;&#3585;&#3617;&#3637;&#3604; &#3627;&#3619;&#3639;&#3629;&#3611;&#3621;&#3629;&#3585;&#3617;&#3637;&#3604;   &#3626;&#3634;&#3609;&#3604;&#3657;&#3623;&#3618;&#3652;&#3617;&#3657;&#3652;&#3612;&#3656;&#3619;&#3641;&#3611;&#3619;&#3656;&#3634;&#3591;&#3649;&#3610;&#3609;&#3654; &#3617;&#3637;&#3611;&#3634;&#3585;&#3626;&#3635;&#3627;&#3619;&#3633;&#3610;&#3648;&#3626;&#3637;&#3618;&#3610;&#3617;&#3637;&#3604; &#3648;&#3614;&#3639;&#3656;&#3629;&#3611;&#3657;&#3629;&#3591;&#3585;&#3633;&#3609; <br />
  &#3588;&#3617;&#3617;&#3637;&#3604;   &#3651;&#3594;&#3657;&#3614;&#3585;&#3614;&#3634;&#3650;&#3604;&#3618;&#3588;&#3634;&#3604;&#3652;&#3623;&#3657;&#3585;&#3633;&#3610;&#3648;&#3629;&#3623;</span></p>
        <p align="left">&nbsp;</p>
        <p align="left"><span class="style45"><br />
      </span></p></td>
