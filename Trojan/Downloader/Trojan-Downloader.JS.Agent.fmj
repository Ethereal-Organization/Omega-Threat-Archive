        function doReportPost(rid,pid)

        {

                var isOpened = null;

                var url = "http://www.drinkspotapp.com/wp-content/plugins/wp-report-posts/wp-report-posts.php?req=reportform&rid="+rid+"&pid="+pid;

                isOpened = window.open(url, "", "width=300px, height=120px, resizable");

                if(isOpened == null)

                {

                        alert("Oops... Report Popup is blocked\nsDisable Your Popup Blocker");

                }

                else

                {

                        isOpened.moveTo(200,200);

                }

 

 

        }

