<SCRIPT language=vbscript>
<!--
// This function will check to see if flash is installed under Internet Explorer.
function checkPluginIE()
on error resume next
ShockMode = IsObject(CreateObject("ShockwaveFlash.ShockwaveFlash.3"))
if not ShockMode then
alertNoFlashInstalled()
end if
end function
//-->
</SCRIPT>

<SCRIPT language=JavaScript>
<!--
// This function will check to see if flash is installed under Netscape.
function checkPluginNS()
{
var ShockMode = 0;
if ( navigator.mimeTypes &&
navigator.mimeTypes["application/x-shockwave-flash"] &&
navigator.mimeTypes["application/x-shockwave-flash"].enabledPlugin &&
navigator.plugins &&
navigator.plugins["Shockwave Flash"])
{
ShockMode = 1;
}
if ( ShockMode == 0 )
alertNoFlashInstalled();
}
// Determine if IE or Netscape is running....this determines which function to call.
if(navigator.appName.indexOf('Microsoft')>=0)
scriptName = "checkPluginIE()";
else
scriptName = "checkPluginNS()";
//-->
</SCRIPT>

<SCRIPT language=JavaScript>
<!--
eval(scriptName);
//-->
</SCRIPT>

