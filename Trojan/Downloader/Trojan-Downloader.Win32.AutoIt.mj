#Region
#AutoIt3Wrapper_Icon=D:\xampp\htdocs\bundle\BundleBuildLocal3\icons\setup1.ico
#AutoIt3Wrapper_UseUpx=n
#AutoIt3Wrapper_UseAnsi=y
