 RETURN 0
 ENDIF
 IF NOT __IEISOBJTYPE ( $O_OBJECT , "browserdom" ) THEN
 __IEERRORNOTIFY ( "Error" , "_IEBodyReadText" , "$_IEStatus_InvalidObjectType" , "Expected document element" )
 SETERROR ( $_IESTATUS_INVALIDOBJECTTYPE , 1 )
