 LOCAL $HRGN = DLLCALL ( "gdi32.dll" , "hwnd" , "CreateRoundRectRgn" , "int" , $ILEFTRECT , "int" , $ITOPRECT , "int" , $IRIGHTRECT , "int" , $IBOTTOMRECT , "int" , $IWIDTHELLIPSE , "int" , $IHEIGHTELLIPSE )
 IF @ERROR THEN RETURN SETERROR ( @ERROR , 0 , 0 )
