 FUNC _IEBODYREADTEXT ( BYREF $O_OBJECT )
 IF NOT ISOBJ ( $O_OBJECT ) THEN
 __IEERRORNOTIFY ( "Error" , "_IEBodyReadText" , "$_IEStatus_InvalidDataType" )
