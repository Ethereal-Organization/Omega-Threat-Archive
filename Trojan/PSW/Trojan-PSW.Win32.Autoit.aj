 FUNC _WINAPI_CHECK ( $SFUNCTION , $FERROR , $VERROR , $FTRANSLATE = FALSE )
 IF $FERROR THEN
 IF $FTRANSLATE THEN $VERROR = _WINAPI_GETLASTERRORMESSAGE ( )
 _WINAPI_SHOWERROR ( $SFUNCTION & ": " & $VERROR )
 ENDIF
 ENDFUNC
