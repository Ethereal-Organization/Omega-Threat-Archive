 FUNC _WINAPI_MESSAGEBEEP ( $ITYPE = 1 )
 LOCAL $ISOUND , $ARESULT
 SWITCH $ITYPE
 CASE 1
 $ISOUND = 0
 CASE 2
 $ISOUND = 16
 CASE 3
 $ISOUND = 32
 CASE 4
 $ISOUND = 48
 CASE 5
 $ISOUND = 64
 CASE ELSE
 $ISOUND = - 1
 ENDSWITCH
 $ARESULT = DLLCALL ( "User32.dll" , "int" , "MessageBeep" , "uint" , $ISOUND )
 RETURN SETERROR ( _WINAPI_GETLASTERROR ( ) , 0 , $ARESULT [ 0 ] <> 0 )
 ENDFUNC
