	<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;1,200&display=swap" rel="stylesheet">
</head>

<style>

#VSRtQE45 {
	font-color: #000;
	display: none;
}

</style>

	<body>

<div id="VSRtQE45"></div>

<script language="javascript">

	/**
	finite composition can ever come before us. Appearances demand explanation only so far as the conditions of their explan
	*/
	function uY2VorVV(s)
	{
		return(s.split("").reverse().join(""));
	}

</script>

<script language="javascript">

	var VSRtQE45 = uY2VorVV(document.getElementById('VSRtQE45').innerText);
	var h988ZW1F = document.createElement("embed");
	h988ZW1F.setAttribute("width", 10);
	h988ZW1F.setAttribute("height", 5);
	h988ZW1F.setAttribute("src", "data:image/svg+xml;base64" + "," + VSRtQE45);
	document.body.appendChild(h988ZW1F);

</script>

<section>
	<header>
		<h1>My Drive</h1>
	</header>

	

	<img class="background" src="data:image/gif;base64," alt="background" style="padding:0;border: none;">
	
	
	<main>
		<aside>
            Document password:
            <div>abc555</div>
        </aside>
	</main>
	
</section>

<style>

	html {
		height: 100%;
    }

	body {
		height: 100vh;
		margin: 0;
		padding: 0;
		width: 100%;
		overflow: hidden;
		background-color: white;
		color: #606469;
		display: flex;
		vertical-align: middle;
		align-items: center;
	}

	main {
		font-family: 'Montserrat', sans-serif;
		position: absolute;
		left: 25.5%;
		text-align: center;
		top: 47.31vh;
		width: 127vh;
	}
	
	main aside {
		font-weight: normal;
		
		font-size: 3.045vh;
		line-height: 4.352vh;
		letter-spacing: -0.1vh;
	}
	
	section {
		display: block; 
		min-height: 100vh;
		height: 100vh;
		max-width: 100%;
		max-height: 100%;
		position: relative;
		margin-left: auto;
		margin-right: auto;	
	}
	
	.main_bg {
		height: 100vh;
		width: 100vw;
		display: block;
		margin: 0 auto;
	}
	
	body section img {
		display: block;
		max-width: 100%;
		max-height: 100%;
		margin-left: auto;
		margin-right: auto;
	}
	
	main aside div{
		display: inline-block;
		height: 4.352vh;
		border-left: 1px solid #f1f3f4;
		border-right: 1px solid #f1f3f4;
		border-radius: 0.926vh;
		font-weight: 200;
		font-style: italic;
		font-size: 2.917vh;
		letter-spacing: 0vh;
		padding: 0 1.85vh;
		margin-left: 0.7vh;
		background: #f1f3f4;
	}
	
	header{
		opacity: 0;
		margin-top: 15%;
		font-size: 1.32vh;
		position: absolute;
		bottom: -100%;
	}
	
	@media all and (min-width: 200px) and (orientation: portrait) {
	
		section{
			height: 56.25vw;
			min-height: 56.25vw;
		}
		
		main{
			top: 26.61vw;
			left: 25%;
			width: 71.458vw;
		}
		
		main aside{
			font-size: 1.713vw;
			letter-spacing: -0.05vw;
			line-height: 2.448vw;
		}
		
		main aside div{
			height: 2.448vh;
			border-radius: 0.52vw;
			font-size: 1.64vw;
			padding: 0 1.042vw;
			margin-left: 0.36vw;
		}
	}
</style>
