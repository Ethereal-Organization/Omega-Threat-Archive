<script>

  var curr_article_nr=0;

  var img0="<img src='image.php?src=ziarul/2008,10,saptamana 1/Investigatii/1.jpg&width=200&height=200' width=200 height=200>";

  var img1="<img src='image.php?src=ziarul/2008,10,saptamana 1/Investigatii/2.jpg&width=200&height=200' width=200 height=200>";

  var img2="<img src='image.php?src=ziarul/2008,10,saptamana 1/Evenimente/3.jpg&width=200&height=200' width=200 height=200>";

  var articol1=document.getElementById('img0').value;

  var articol2=document.getElementById('img1').value; 

  var articol3=document.getElementById('img2').value;

  document.getElementById('rotation').innerHTML=articol1;

  document.getElementById('imagine_prim_plan').innerHTML=img0;

  document.getElementById('1').src='imagini/bza_1o.jpg';

  function change(nr)

  {

    if(nr==1)

	{

	 curr_article_nr=0;

	 article_rotation();

	 }

	else if(nr==2)

	 {

	 curr_article_nr=1;

	 article_rotation();

	 } 

	 else

	 {

	 curr_article_nr=2;

	 article_rotation();

	 }

  }

  function article_rotation()

  {

   if(curr_article_nr==0){

     document.getElementById('rotation').innerHTML=articol1;

	 document.getElementById('imagine_prim_plan').innerHTML=img0;

	  document.getElementById('1').src='imagini/bza_1o.jpg';

	   document.getElementById('2').src='imagini/bza_2.jpg';

	    document.getElementById('3').src='imagini/bza_3.jpg';

	 }

  else if(curr_article_nr==1) 

  {

     document.getElementById('rotation').innerHTML=articol2;  

	 document.getElementById('imagine_prim_plan').innerHTML=img1;

	 document.getElementById('1').src='imagini/bza_1.jpg'; 

	  document.getElementById('2').src='imagini/bza_2o.jpg';

	   document.getElementById('3').src='imagini/bza_3.jpg'; 

	} 

  else

  {

     document.getElementById('rotation').innerHTML=articol3;

	 document.getElementById('imagine_prim_plan').innerHTML=img2;	

	  document.getElementById('1').src='imagini/bza_1.jpg';

	   document.getElementById('2').src='imagini/bza_2.jpg';

	    document.getElementById('3').src='imagini/bza_3o.jpg'; 

	} 

	curr_article_nr++;

	 if(curr_article_nr==3)

	    curr_article_nr=0;

