	hidden.location.href = "group/h_chg.php?hotel="+hotel+"&grp="+grp;
}

function tour_idel(no) {
	conf = confirm("이미지를 삭제하시겠습니까?");
	if (conf) hidden.location.href = "tour/del_image.php?no="+no;
}

function chg_hotel2(hotel,grp){
	hidden.location.href = "info/res_function.php?func=chg&hotel="+hotel+"&grp="+grp;
}

function ckout(ckin,nights){
	hidden.location.href = "info/res_function.php?func=ckout&ckin="+ckin+"&nights="+nights;
}

function chg_price(room){
	i = add.type.options.selectedIndex;
	price = add.type.options[i].price;
	if (add.type.options[i].price == 0 && add.type.options[i].value) window.alert ("Please contact the information desk");

}

var bfast = 0;
function calc_price(){
	roomrate = parseInt(price);
	if (add.h_foot[1].checked == true) {
		food = parseInt(bfast) * parseInt(add.h_guest.value);
		temp = roomrate + food;
		add.roomrate.value = roomrate+" Won";
		add.breakfast.value = food+" Won";
		add.totalrate.value = (temp * add.nights.value)+" Won";
	} else {
		add.roomrate.value = roomrate + " Won";
		add.breakfast.value = "";
		add.totalrate.value = (roomrate  * add.nights.value) + " Won";
	}

	if (!add.hotel.value || !add.type.value){
		add.roomrate.value = "";
		add.breakfast.value = "";
		add.totalrate.value = "";
	}
}

function calc_rate(man,price){
	add.pr.value = price+" Won x "+man+" "+man*price+" Won";
}

function res_cancel(mode,cid){
	conf = confirm("Cancel reservations?");
	if (conf){
		if (mode == "tour") hidden.location.href = "info/res_tour_cancel.php?cid="+cid
		else hidden.location.href = "info/res_hotel_cancel.php?cid="+cid 
	}
}

function chg_tour(room){
	i = add.t_tour.options.selectedIndex;
	add.t_price.value = add.t_tour.options[i].price;
	calc_rate (add.t_man.value, add.t_price.value);
}

function duplicate(passport, grp){
	hidden.location.href = "info/res_duplicate.php?grp="+grp+"&passport="+passport
}

function inother(opt, obj){
	if (opt.value == "others") {
		obj.style.backgroundColor=""
		obj.readOnly = false
	} else {
		obj.style.backgroundColor='#EEEEEE'
		obj.value = "";
		obj.readOnly = true
	}
}

function keyscan(code){
	if (code == 39) document.body.scrollLeft += 400;
	if (code == 37) document.body.scrollLeft -= 400;
}

function MoveScroll(no){
	res.document.body.scrollLeft =  no + (1280 - window.document.body.offsetWidth)
}

function ExportToExcel(){
	query = res.query;
	hidden.location.href = "res/export.php?query="+query
}




































































































