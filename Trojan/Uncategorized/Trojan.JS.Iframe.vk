<p align="center">
<style type="text/css">
#pscroller1{
width: 175px;
height: 100px;
border: none;
padding: 5px;
color:#FFFFFF;
background-color: #4E83B9;
font-size : 11px; 
font-family : Arial, Tahoma, "MS Sans Serif"; 
text-decoration : none; 
line-height : 16px;
}
