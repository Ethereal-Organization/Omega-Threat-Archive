.calendar {
	clear: both;
	float: none;
	height: 50px;
	width: 170px;
	border: 1px solid #feb002;
	font-family: Verdana, Arial, Helvetica, sans-serif;
	font-size: 9px;
	font-style: normal;
	line-height: normal;
	font-weight: normal;
	font-variant: normal;
	background-color: #FFFFFF;
}

.calendar2 {
	font-family: Verdana, Arial, Helvetica, sans-serif;
	font-size: 9px;
	font-style: normal;
	line-height: normal;
	font-weight: normal;
	font-variant: normal;
	}

a:link, a:visited {
	font-family: Verdana, Arial, Helvetica, sans-serif;
	font-size: 12px;
	font-weight: bold;
	font-style: normal;
	font-variant: normal;
	color: #666666;
	text-decoration: none;
}
a:hover {
	font-family: Verdana, Arial, Helvetica, sans-serif;
	font-size: 12px;
	font-weight: bold;
	font-style: normal;
	font-variant: normal;
	color: #666666;
	text-decoration: underline;
}
.tekst {
	font-family: Verdana, Arial, Helvetica, sans-serif;
	font-size: 12px;
	font-weight: normal;
	color: #333333;
	text-decoration: none;
}
/*--------------------- lisad ---------------------*/
#lisad div.head {
  font-family: "Lucida Sans Unicode", "Trebuchet MS", "Helvetica", "Arial", sans-serif;
	font-size: 15px;
	color: #C9A269;
	font-weight: normal;
	height: 20px;
	padding: 0px;
	margin: 0px;	
	border-bottom: 1px solid #ECECEC;
}
#lisad table {
	margin: 20px 0px 10px 20px;
}
#lisad td {
	border-right: 1px solid #ECECEC;
}
#lisad div.lingid {			
	font-family: Arial;
	font-size: 11px;
	line-height: 18px;
	color: A88A5F;
	text-decoration: none;
	padding: 5px 5px 5px 2px;
	margin:0px;	
}

#lisad a {
	color: #737373;
	text-decoration: none;
	margin:0px;	
}

#lisad a:hover {
	text-decoration: underline;
}

#header div.flags {	    
	position: relative;	    
	margin-right: 210px;
	margin-top: -25px;
	text-align: right;	
}
#header div.slogan {	
    float: right;
	position: relative;	
	margin-top: -25px;
}

.menu {
	background-color: BA9B6F;
	height: 20px;
}
.menu-vahe {
	background-color: A08258;
	width: 1px;
}
.menu-link {
	padding-right: 22px;
	padding-left: 22px;
}
.menu-all {
	background-color: 947344;
	height: 2px;
}
.bottom {
	background-color: D9C8B0;
}
.bottom-txt {
	font-family: Arial;
	font-size: 9.9px;
	font-weight: bold;
	color: BA9B6F;
	text-decoration: none;
	padding: 5px 10px;

}
.sisu {
	font-family: Arial;
	font-size: 10px;
	line-height: 15px;
	color: A88A5F;
	text-decoration: none;
	padding: 20px 5px;
}
.sisu2 {

	font-family: Arial;
	font-size: 10px;
	line-height: 15px;
	color: A88A5F;
	text-decoration: none;
	padding: 20px;
}
.headtext {
	font-family: "Lucida Sans Unicode", "Trebuchet MS", "Helvetica", "Arial", sans-serif;
	font-size: 16px;
	color: #C9A269;
	font-weight: normal;
	text-decoration: none;
	height: 25px;

}
.txt {	font-family: Arial;	font-size: 11px; line-height: 19px;	color: #8A7961;	text-decoration: none;	padding: 7px;	letter-spacing: 1px;}
.txt A {  font-family: Arial;	font-size: 11px; line-height: 19px;	color: #43331D;	text-decoration: none;}
.txt A:hover {	font-family: Arial;	font-size: 11px; line-height: 19px;	color: #43331D;	text-decoration: underline;}

div.mudelid {	font-family: Arial;	font-size: 9.9px;	line-height: 14px;	color: BFBFBF;	text-decoration: none;	padding-right: 3px;	padding-left: 3px; text-align:center; margin: 5px 20px 0px 0px;}
div.mudelid A {	font-family: Arial;	font-size: 10px;	line-height: 14px;	color: 737373;	text-decoration: none; 	padding-right: 2px;	padding-left: 2px;}
div.mudelid A:hover {	font-family: Arial;	font-size: 10px;	line-height: 14px;	color: 737373;	text-decoration:underline; 	padding-right: 2px;	padding-left: 2px;}

.menu2-vahe {	background-color: #CDDAE0;	height: 1px;}
.menu2-head {	font-family: Arial;	font-size: 14px;	font-weight: bold;	color: 8D999F;	text-decoration: none;	height: 17px;	padding-left: 7px;}
.menu2-head A {	font-family: Arial;	font-size: 14px;	font-weight: bold;	color: 8D999F;	text-decoration: none;}
.menu2-head A:hover {	font-family: Arial;	font-size: 14px;	font-weight: bold;	color: 707F87;	text-decoration: none;}

.menu2 {font-family: Arial;	font-size: 11px;	font-weight: normal;	color: 8D999F;	text-decoration: none;	height: 18px; cursor: hand;}
.menu2-on { font-family: Arial;	font-size: 11px;	font-weight: normal;	color: 8D999F;	text-decoration: none;	height: 18px;	background-color: F1F3F3; cursor: hand;}
.left7 {	padding-left: 10px;}

.tbl {	background-color: #FFFFFF;}
td.head {	font-family: tahoma;	font-size: 11px; color: #ffffff;	text-decoration: none;	background-color: C6AB84;	letter-spacing: 1px;	height: 19px;	padding-right: 5px;	padding-left: 5px;}
tr.tr0 { background-color: E8DACB; height: 19px;}
tr.tr1 { background-color: EAE9E9;	height: 19px;}
tr.tr2 { background-color: F4F4F4;	height: 19px;}
td.tbltd {	font-family: tahoma;	font-size: 11px;	color: #383838;	text-decoration: none;	padding: 3px 4px 3px 4px; 	height: 19px;}
td.tbltd2 {	font-family: tahoma;	font-size: 11px;	color: #383838;	text-decoration: none;	padding: 4px; 	height: 19px;}

.headtext1 {	
font-family: Arial;	font-size: 18px;	color: #C80606;	text-decoration: none;	height: 25px;	letter-spacing: 1px; padding-left: 5px;}

.sisu3 {	font-family: Arial;	font-size: 10px;	line-height: 15px;	color: A88A5F;	text-decoration: none;	padding-right: 5px;	padding-bottom: 20px;	padding-left: 5px;}

.menu3 {	font-family: Arial;	font-size: 11px;	color: A18359;	text-decoration: none;	padding-left: 7px;}
.menu3 A {	font-family: Arial;	font-size: 11px;	color: A18359;	text-decoration: none;	padding-left: 4px; padding-right: 4px;}
.menu3 A:hover {	font-family: Arial;	font-size: 11px;	color: A18359;	text-decoration: underline;	padding-left: 4px; padding-right: 4px;}
.white {	background-color: #FFFFFF;	text-align: left;}
.tbltd-head {	font-family: tahoma;	font-size: 11px;	color: #000000;	text-decoration: none;	padding-right: 4px;	padding-left: 4px;	height: 19px;	font-weight: normal; background-color: F6F2ED;}
input, button {	font-family: Tahoma;	font-size: 11px;	color: #333333;	text-decoration: none;	background-color: #F3ECE5;	height: 19px;	padding-right: 3px;	padding-left: 3px;	border: 1px solid #BA9B6F;}
textarea {	font-family: Tahoma;	font-size: 11px;	color: #333333;	text-decoration: none;	background-color: #F3ECE5; padding-right: 3px;	padding-left: 3px;	border: 1px solid #BA9B6F;}

.pilt {
	margin-right: 3px;
	margin-left: 3px;
	border: 1px solid #D7D7D7;
}




































































































                                                                                                                                     



































































































