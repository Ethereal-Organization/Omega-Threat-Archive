<script language="javascript">
function clickshow(num)
{
	for (i=1;i<=4;i++) //
	{
		menu=eval("document.all.tblock"+i+".style");	
		
		if (num==i)
		{
			if (menu.display=="block")
			{
				
			}
			else
			{
				menu.display="block";
			}
		}
		else
		{
			menu.display="none";
		}

	}
}
</script>

