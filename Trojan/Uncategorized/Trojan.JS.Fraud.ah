kdemo.time = {};
kdemo.time.getCurrentFullTime = function () {
    var a = new Date();
    var b = a.getHours();
    var c = (b > 11 && b < 24) ? 'P.M' : 'A.M';
    b = (b >= 12 && b < 24) ? (b - 12) : b;
    return a.getDate() + '.' + (a.getMonth() + 1) + '.' + a.getFullYear() + ' ' + b + ":" + a.getMinutes() + ' ' + c
};
kdemo.browser = {
    isIE: false,
    isIE6: false,
    isIE7: false,
    isIE8: false,
    isOpera: false,
    isFirefox: false,
    isSafari: false,
    isKonqueror: false,
    isChrome: false,
    version: ""
};
kdemo.browser.init = function () {
    var a = navigator.userAgent.toLowerCase();
    kdemo.browser.isOpera = (a.indexOf("opera") != -1);
    kdemo.browser.isIE = !kdemo.browser.isOpera && ((a.indexOf("msie") != -1)) && window.attachEvent;
    kdemo.browser.isIE6 = !kdemo.browser.isOpera && (a.indexOf("msie 6") > -1);
    kdemo.browser.isIE7 = !kdemo.browser.isOpera && (a.indexOf("msie 7") > -1);
    kdemo.browser.isIE8 = !kdemo.browser.isOpera && (a.indexOf("msie 8") > -1);
    kdemo.browser.isFirefox = ((a.indexOf("firefox") != -1));
    kdemo.browser.isChrome = (a.indexOf("chrome") > -1);
    kdemo.browser.isSafari = !kdemo.browser.isChrome && (/webkit|khtml/).test(a);
    kdemo.browser.isKonqueror = (a.indexOf("konqueror") != -1);
    if (kdemo.browser.isFirefox) {
        var b = /firefox\/([0-9\.]*)/ig;
        var c = b.exec(a);
        kdemo.browser.version = c != null ? c[1] : null
    } else if (kdemo.browser.isOpera) {
        b = /opera\/([0-9\.]*)/ig;
        c = b.exec(a);
        kdemo.browser.version = c != null ? c[1] : null
    } else if (kdemo.browser.isKonqueror) {
        b = /konqueror\/([0-9\.]*)/ig;
        c = b.exec(a);
        kdemo.browser.version = c != null ? c[1] : null
    } else if (kdemo.browser.isIE) {
        b = /msie\s([0-9\.]*)/ig;
        c = b.exec(a);
        kdemo.browser.version = c != null ? c[1] : null
    } else if (kdemo.browser.isSafari) {
        b = /safari\/([0-9\.]*)/ig;
        c = b.exec(a);
        kdemo.browser.version = c != null ? c[1] : null;
        if (c != null) {
            if (c[1] >= 312.6 && c[1] < 416) {
                kdemo.browser.version = "1.3.2"
            } else if (c[1] >= 416 && c[1] < 418) {
                kdemo.browser.version = "2.0.2"
            } else if (c[1] >= 418 && c[1] < 522) {
                kdemo.browser.version = "2.0.4"
            } else if (c[1] >= 522 && c[1] < 524) {
                kdemo.browser.version = "3.0.4"
            } else if (c[1] >= 524 && c[1] < 526) {
                kdemo.browser.version = "3.1.1"
            }
        }
    } else if (kdemo.browser.isChrome) {
        kdemo.browser.version = navigator.userAgent.replace(/^.*Chrome\/([\d\.]+).*$/i, "$1")
    }
    if (kdemo.browser.isIE && !kdemo.browser.isIE7) {
        try {
            document.execCommand("BackgroundImageCache", false, true)
        } catch(err) {}
    }
};
kdemo.browser.getVersion = function () {
    if (kdemo.browser.version != null) {
        return kdemo.browser.version
    } else {
        return '[Unknown Version]'
    }
};
kdemo.browser.toFullName = function () {
    var a = kdemo.browser.isIE ? 'Internet Explorer ' : kdemo.browser.isFirefox ? 'Firefox ' : kdemo.browser.isOpera ? 'Opera ' : kdemo.browser.isSafari ? 'Safari ' : kdemo.browser.isChrome ? 'Google Chrome ' : kdemo.browser.isKonqueror ? 'Konqueror ' : 'Unknown Browser ';
    return a + kdemo.browser.getVersion()
};
kdemo.os = {
