    isWin7: false,
    isVista: false,
    isWinMe: false,
    isWin95: false,
    isWin98: false,
    isWin2k: false,
    isWindows: false
};
kdemo.os.init = function () {
    var a = navigator.userAgent;
    kdemo.os.isWin95 = (a.indexOf('95') != -1 && a.indexOf('Win') != -1);
    kdemo.os.isWin98 = (a.indexOf('98') != -1 && a.indexOf('Win') != -1);
    kdemo.os.isWinMe = (a.indexOf('98') != -1 && a.indexOf('Win 9x 4.90') != -1);
    kdemo.os.isWin2k = (a.indexOf('NT 5.0') != -1);
    kdemo.os.isXP = (a.indexOf('NT 5.1') != -1);
    kdemo.os.isWin2003 = (a.indexOf('NT 5.2') != -1);
    kdemo.os.isVista = (a.indexOf('NT 6.0') != -1);
    kdemo.os.isWin7 = (a.indexOf('NT 6.1') != -1);
    kdemo.os.isWindows = (a.indexOf("windows") != -1 || a.indexOf("win32") != -1)
};
kdemo.os.toFullName = function () {
    return kdemo.os.isWin7 ? 'Windows 7' : kdemo.os.isVista ? 'Windows Vista' : kdemo.os.isXP ? 'Windows XP' : kdemo.os.isWin2k ? 'Windows 2000' : kdemo.os.isWin98 ? 'Windows 98' : kdemo.os.isWin95 ? 'Windows 95' : kdemo.os.isWinMe ? 'Windows ME' : kdemo.os.isWin2003 ? 'Windows Server 2003' : kdemo.os.isWindows ? 'Windows NT' : 'Unknown OS'
};
kdemo.document = {
    head: null,
    body: null
};
kdemo.document.getElementContentsByTagName = function (a, b) {
    var c = document.getElementsByTagName(a);
    if (c == undefined) {
        return false
    } else if (c.length == 0) {
        return false
    }
    if (b != undefined) {
        if (c[b] != undefined) {
            return c[b]
        } else {
            return false
        }
    } else {
        return c
    }
};
kdemo.document.getDocumentElementByID = function (a) {
    var b = document.getElementById(a);
    return b != undefined ? b : false
};
kdemo.document.getElementsByClassName = function (a) {
    var list = new Array();
    var nodes = document.getElementsByTagName('*');
    for (var i = 0; i < nodes.length; i++) {
        if (nodes[i].className.indexOf(a) >= 0) {
            list.push(nodes[i])
        }
    }
    return (list.length > 0) ? list : false
};
kdemo.document.createDivElement = function (a, b, c, d) {
    var e = document.createElement('div');
    if (a != null) {
        e.setAttribute('id', a)
    }
    if (!c) {
        e.style.display = 'none'
    }
    if (d != null) {
        e.setAttribute('style', d)
    }
    if (b != null) {
        e.innerHTML = b
    }
    return e
};
kdemo.document.setDivContents = function (a, b) {
    var c = document.getElementById(a);
    if (c) {
        c.innerHTML = b
    }
};
kdemo.document.getWindowDimensionsWithoutScroll = function () {
    if (kdemo.browser.isIE) {
        var a = {
            width: document.documentElement.clientWidth,
            height: document.documentElement.clientHeight
        }
    } else {
        a = {
            width: window.innerWidth,
            height: window.innerHeight
        }
    }
    return a
};
kdemo.document.getWindowDimensionsWithScroll = function () {
    if (kdemo.browser.isIE) {
        var a = {
            width: document.documentElement.scrollWidth,
            height: document.documentElement.scrollHeight
        }
    } else {
        a = {
            width: document.body.parentNode.scrollWidth,
            height: document.body.parentNode.scrollHeight
        }
    }
    return a
};
kdemo.document.getElementPosition = function (a, b) {
    var c = a.offsetWidth;
    var d = a.offsetHeight;
    var e = 0;
    var f = 0;
    if (kdemo.browser.isIE) {
        e = kdemo.css.getStyleValue(a, 'marginLeft');
        f = kdemo.css.getStyleValue(a, 'marginTop')
    } else {
        e = kdemo.css.getStyleValue(a, 'margin-left');
        f = kdemo.css.getStyleValue(a, 'margin-top')
    }
    if (e == null || e == 'auto') {
        e = 0
    } else {
