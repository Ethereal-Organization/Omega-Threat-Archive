}

img
{
	border: 0;
	vertical-align: middle;
}

a:link,
a:visited
{
	background: transparent;
	color: #E5C393;
	text-decoration: none;
}

a:hover,
a:active
{
	background: transparent;
	color: #E5B673;
}

#ipbwrapper
{
	margin: 0px auto 0px auto;
