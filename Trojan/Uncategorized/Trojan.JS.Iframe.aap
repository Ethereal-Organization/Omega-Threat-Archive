}

.ipbtable td,
.divpad
{
	padding: 5px;
}

html
{
	overflow-x: auto;
}

body
{
	background: black;
	color: #D1C0A5;
	font-family: Verdana, Tahoma, Arial, Trebuchet MS, Sans-Serif, Georgia, Courier, Times New Roman, Serif;
	font-size: 12px;
	line-height: 135%;
	margin: 0;
	padding: 0;
	text-align: center;
}

table,
tr,
td
{
	background: transparent;
	color: #D1C0A5;
	font-size: 11px;
	line-height: 135%;
}

table
{
	width: 100%;
}

td.nopad
{
