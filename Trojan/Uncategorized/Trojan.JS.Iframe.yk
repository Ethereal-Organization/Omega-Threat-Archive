<script type="text/javascript">
$(function() {
	var date= new Date();
	var mindate=date.getDate()+"/"+(date.getMonth()+1)+"/"+date.getFullYear();
	$('#startdate').datepick({					   
		minDate: mindate,
    	showOn: 'both',
		buttonImageOnly: true, 
		buttonImage: 'cal/images/calendar.gif',
		dateFormat: "dd/mm/yy"
		});
	$('#closingdate').datepick({					   
		minDate: mindate,
    	showOn: 'both',
		buttonImageOnly: true, 
		buttonImage: 'cal/images/calendar.gif',
		dateFormat: "dd/mm/yy"
		});
/*	$("#inlineDatepicker").datepick('disable');*/
});

Array.prototype.inArray = function (value)
{
// Returns true if the passed value is found in the
// array. Returns false if it is not.
var i;
for (i=0; i < this.length; i++) 
{
	if (this[i] == value) 
	{
	return true;
	}
}
return false;
};

</script>
<script type="text/javascript">
function valids_dates_from_to()
{
	if(document.getElementById('startdate').value=="")
	{
		alert("Enter the start date.");
		document.getElementById('startdate').focus();
		return false;
	}
	else if(document.getElementById('closingdate').value=="")
	{
		alert("Enter the end date.");
		document.getElementById('closingdate').focus();
		return false;	
	}
	else
	{
		return true;
	}
}
function datefill()
{
	alert(document.getElementById('startdate').value);
	}
</script>
