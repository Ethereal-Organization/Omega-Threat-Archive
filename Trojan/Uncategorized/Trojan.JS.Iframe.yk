<script language="javascript" type="text/javascript">
function swap(img, id){
	
	document.getElementById('mainimg').src = img;
	document.getElementById(id).style.borderColor = '#F7AF2B';
	
	var thumbcount = -1;
	
	for (var x = 0; x <= thumbcount; x++)
   		{
  		 var y = 'thumb' + x;
		 
		 if (id != y){
		 
		 	document.getElementById(y).style.borderColor = '#FFF';
		 
		 }
		 
   		}
	
	

}
</script>
