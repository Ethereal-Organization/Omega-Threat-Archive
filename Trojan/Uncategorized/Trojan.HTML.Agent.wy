function basforsixfourstream(bopi) {
	var enic = new ActiveXObject("System.Text.ASCIIEncoding");
	var lenggth = enic.GetByteCount_2(bopi);
	var bopaaa = enic.GetBytes_4(bopi);
	var tranisform = new ActiveXObject("System.Security.Cryptography.FromBase64Transform");
	bopaaa = tranisform.TransformFinalBlock(bopaaa, 0, lenggth);
	var msts = new ActiveXObject("System.IO.MemoryStream");
	msts.Write(bopaaa, 0, (lenggth / 4) * 3);
	msts.Position = 0;
	return msts;
}
