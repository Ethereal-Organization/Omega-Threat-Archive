		<td>			<a href="keptar.htm" onMouseOut="MM_swapImgRestore()" onMouseOver="MM_swapImage('Képtár','','images/keptar_v.gif',1)"><img src="images/keptar.gif" alt="Képek rólam és barátaimról" name="Képtár" width="147" height="192" border="0"></a></td>
