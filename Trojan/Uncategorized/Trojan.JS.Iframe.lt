        </div>
        <a href="http://www.carboslim.ru/page/action.html"><img src="http://www.carboslim.ru/images/akcii.gif" style="position: relative; top: 70px; left: 20px;"></a>
      </td>
      <td  valign: top; style="padding-top:  40px; ">
