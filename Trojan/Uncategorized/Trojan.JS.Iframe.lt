              <td><img src="http://www.carboslim.ru/images/gimnast.gif"></td>
              <td valign="middle"><a href="http://www.carboslim.ru/page/gimnast.html"   class="top-menu2">ОФИСНАЯ<br>
                ГИМНАСТИКА</a></td>
              <td><img src="http://www.carboslim.ru/images/news.gif"></td>
              <td valign="middle"><a href="http://www.carboslim.ru/page/myprogramme.html"   class="top-menu2">СОСТАВЬ СВОЮ<br>ПРОГРАММУ<br>ПОХУДЕНИЯ</a></td>
