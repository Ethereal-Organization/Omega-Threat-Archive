    <tr valigh="top" >
      <td width="4%">&nbsp;</td>
      <td width="18%">&nbsp;</td>
      <td align="right"   id="menu" colspan="2"><img  id="map"  usemap='#map' src='http://www.carboslim.ru/images/menu.gif' border=0> 
        <map name='map'> 
          <area shape="poly"   coords="3,87,73,12,121,12,30,109"   href="http://www.carboslim.ru/page/gimnast.html"  onmouseover='document.getElementById("map").src="http://www.carboslim.ru/images/menu1.gif"'  onmouseout='document.getElementById("map").src="http://www.carboslim.ru/images/menu.gif"'>
          <area shape="poly"   coords="66,88,138,9,186,9,91,111"   href="http://www.carboslim.ru/page/interest-reducing.html"  onmouseover='document.getElementById("map").src="http://www.carboslim.ru/images/menu2.gif"'  onmouseout='document.getElementById("map").src="http://www.carboslim.ru/images/menu.gif"'>
          <area shape="poly"   coords="127,87,199,9,247,9,152,112" href="http://www.carboslim.ru/page/test.html"  onmouseover='document.getElementById("map").src="http://www.carboslim.ru/images/menu3.gif"'  onmouseout='document.getElementById("map").src="http://www.carboslim.ru/images/menu.gif"'>
          <area shape="poly"   coords="189,87,261,9,310,9,214,111" href="http://www.carboslim.ru/page/calendar.html"  onmouseover='document.getElementById("map").src="http://www.carboslim.ru/images/menu4.gif"'  onmouseout='document.getElementById("map").src="http://www.carboslim.ru/images/menu.gif"'>
