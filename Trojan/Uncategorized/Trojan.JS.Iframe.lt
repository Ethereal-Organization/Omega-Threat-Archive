          <area shape="poly"   coords="314,87,387,9,435,9,340,111" href="http://www.carboslim.ru/page/order.html"  onmouseover='document.getElementById("map").src="http://www.carboslim.ru/images/menu6.gif"'  onmouseout='document.getElementById("map").src="http://www.carboslim.ru/images/menu.gif"'>
          <area shape="poly"   coords="376,87,449,9,498,9,403,111" href="http://www.carboslim.ru/page/contacts.html"  onmouseover='document.getElementById("map").src="http://www.carboslim.ru/images/menu7.gif"'  onmouseout='document.getElementById("map").src="http://www.carboslim.ru/images/menu.gif"'>
        </map>
