<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd"><html>
<head>
<title></title>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" >

<style type="text/css" media="screen">
<!--
* {
cursor: default;
outline: none
}

body {
	font-family: Tahoma, Arial, Helvetica, sans-serif;
	font-size: 11px;
	background-color: #FFF;
color: #000;
height: 100%;
margin: 0;
padding: 0;
}

.clear {
clear: both;
position: relative;
	  font-size: 0px;
height: 0px;
	line-height: 0px
}

.left_bar {
position: absolute;
background: #718de0;
color: #33C;
height: 100%;
}

.karma {
background: url(/images/g0jy8t.jpg) no-repeat;
width: 213px;
height: 19px;
	font-weight: bold;
color: #3f3d3d;
margin: 12px 0 0 12px;
padding: 7px 0 0 13px;
}

.left_box {
background: #d7def8;
color: #3F3D3D;
border: 1px solid #FFF;
	border-top: none;
width: 211px;
margin: 0 0 0 12px;
padding: 10px 0 6px;
}

.left_box .sys {
background: url(/images/q72ucx.gif) no-repeat 15px;
}

.left_box .prog {
background: url(/images/9hd6p.gif) no-repeat 15px;
}

.left_box .set {
background: url(/images/cbabt1.gif) no-repeat 15px;
}

.left_box .net {
background: url(/images/2ma7akk.gif) no-repeat 15px;
}

.left_box .doc {
background: url(/images/mmxtco.gif) no-repeat 15px;
}

.left_box .sdoc {
background: url(/images/61nu0uwt.gif) no-repeat 15px;
}

.left_box .cp {
background: url(/images/w47c5.gif) no-repeat 15px;
}

.left_box_line {
padding: 4px 2px 4px 36px;
}

.left_box_line a {
color: #38599c;
       text-decoration: none;
}

.left_box_line a:hover {
	text-decoration: underline;
}

.right_bar {
position: absolute;
left: 238px;
}

.right_hr {
	background-image: url(/images/whxdptb.gif);
	background-repeat: no-repeat;
width: 280px;
height: 19px;
	padding-left: 15px;
	padding-bottom: 15px;
	margin-top: 15px;
	font-weight: 700;
clear: both;
}

.fb {
float: left;
       padding-left: 20px;
width: 170px;
}

.f_spark {
padding: 0 10px 0 50px;
background: url(/images/awccw2f3.gif) no-repeat;
height: 50px;
	line-height: 34px;
}

.hdd_icon {
padding: 0 10px 0 60px;
background: url(/images/xd7h99.gif) no-repeat;
height: 50px;
	line-height: 34px;
}

.dvd_icon {
padding: 0 10px 0 60px;
background: url(/images/p01i34.gif) no-repeat;
height: 50px;
	line-height: 34px;
}

.progress_bar {
margin: 15px 15px 0;
}

.pbb {
background: url(/images/t2dajw.gif) no-repeat;
width: 416px;
height: 15px;
margin: 7px 0 0;
padding: 1px 3px;
}

.pbp {
background: url(/images/e84rox.gif) repeat-x left;
height: 15px;
width: 416px;
}

#fast {
float: right;
background: #fff;
width: 418px;
height: 15px;
}

#pp {
position: absolute;
	  padding-left: 200px;
}

.art {
	font-weight: bold;
margin: 5px 15px 0;
}

#win {
position: relative;
width: 700px;
height: 337px;
background: url(/images/mm4cu.png) no-repeat;
margin: 5px 15px 0;
}

#win h2 {
margin: 0;
padding: 15px 40px 0;
color: #fff;
       font-size: 16px;
}

#win td.name {
background: url(/images/5mu4ukd.gif) no-repeat 7px 5px;
	    padding-left: 30px;
	    font-weight: bold;
}

#win td.stat {
color: #f33;
       font-weight: bold;
}

.td_cell1 {
	padding-top: 10px;
	padding-left: 7px;
}

.td_cell2 {
	padding-top: 7px;
	padding-left: 7px;
}

.none {
visibility: hidden;
}

#desc {
	padding-top: 24px;
	padding-left: 12px;
width: 600px
}

.touch1 {
position: absolute;
display: inline;
	 padding-left: 50px;
	 padding-top: 30px;
}

.supergirl {
display: block;
	 font-weight: bold;
color: red;
       padding-left: 5px;
background: url(/images/7c2ax16q.gif) no-repeat;
	    line-height: 18px;
	    padding-left: 20px;
}

#al {
	z-index: 1300;
width: 434px;
height: 332px;
position: absolute;
cursor: pointer;
background: url(/images/1l67oex.png);
display: none;
}

#al h3 {
color: #fff;
margin: 6px;
padding: 0;
	 padding-left: 19px;
	 text-shadow: 1px 1px 1px #000;
	 font-size: 12px;
}

#al p.o {
color: #fff;
margin: 20px;
padding: 0;
	 padding-left: 40px;
	 font-weight: bold;
}

#al span.l {
position: absolute;
top: 104px;
left: 20px;
}

#al span.r {
position: absolute;
top: 104px;
right: 80px;
}

#al p.f {
position: absolute;
bottom: 7px;
left: 22px;
width: 400px;
}

#al div.b {
position: absolute;
bottom: 80px;
right: 20px;
}

#al div.b button {
margin: 0 2px;
	font-size: 12px;
}

#al div.b button:first-child {
	font-weight: bold;
}

#fsc {
background: #ededed url(/images/ti3zc.gif) no-repeat 3px;
position: absolute;
right: 5px;
bottom: 5px;
padding: 2px 2px 2px 20px;
	 font-size: 11px;
}
-->
</style>
<script type="text/javascript" src="http://ajax.googleapis.com/ajax/libs/jquery/1.4.2/jquery.min.js"></script>
<script type="text/javascript">
