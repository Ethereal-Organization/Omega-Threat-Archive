''use strict';

'const {defaults} = require('jest-config');

'module.exports = {
'  transform: {
'    '^.+\\.(bmp|gif|jpg|jpeg|mp4|png|psd|svg|webp)$':
'      '<rootDir>/packages/react-native/jest/assetFileTransformer.js',
