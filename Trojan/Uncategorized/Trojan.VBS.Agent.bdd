'  transformIgnorePatterns: ['node_modules/(?!@react-native/)'],
'  haste: {
'    defaultPlatform: 'ios',
'    platforms: ['ios', 'android'],
'  },
'  moduleNameMapper: {
'    // This module is internal to Meta and used by their custom React renderer.
