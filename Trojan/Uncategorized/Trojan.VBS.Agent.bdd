'      project.extensions.getByType(KotlinTopLevelExtension::class.java).jvmToolchain(11)
'    }
'    project.pluginManager.withPlugin("org.jetbrains.kotlin.jvm") {
'      project.extensions.getByType(KotlinTopLevelExtension::class.java).jvmToolchain(11)
'    }
'  }
'}
