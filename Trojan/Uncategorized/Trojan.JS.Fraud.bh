            kdemo.alerts.draggableItem.div = kdemo.instructions.instructionsDIV;
            kdemo.alerts.draggableItem.background = null;
            if (kdemo.landings.property.isPreLandingActive) {
                kdemo.landings.hidePreLanding()
            } else if (kdemo.landings.property.isCentralLandingActive) {
                kdemo.landings.hideCentralLanding()
            } else if (kdemo.landings.property.isPostLandingActive) {
                kdemo.landings.hidePostLanding()
            }
            kdemo.layouts.removeAllLayers();
