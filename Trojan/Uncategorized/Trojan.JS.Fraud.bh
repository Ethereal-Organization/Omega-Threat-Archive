            kdemo.document.body.appendChild(kdemo.instructions.instructionsDIV);
            var a = kdemo.document.getElementPosition(kdemo.instructions.instructionsDIV, 'absolute');
            if (!kdemo.browser.isOpera) {
                kdemo.instructions.instructionsDIV.style.left = a.left + "px";
                kdemo.instructions.instructionsDIV.style.top = a.top + "px"
            }
        } else {
            kdemo.instructions.instructionsDIV.style.display = 'block'
        }
        if (!kdemo.common.isExitAlertDialogInIEUsed && !kdemo.browser.isFirefox) {
            kdemo.instructions.processInstructionWithoutPopup()
        } else if (kdemo.common.isExitAlertDialogInIEUsed && !kdemo.browser.isFirefox) {}
        if (kdemo.browser.isIE7) {
            kdemo.document.getDocumentElementByID(kdemo.constants.instructions.defaultIdIEInstructionsBordersContent).style.paddingLeft = "0px";
            kdemo.document.getDocumentElementByID(kdemo.constants.instructions.defaultIdIEInstructionsBordersContent).style.paddingRight = "0px";
            kdemo.document.getDocumentElementByID(kdemo.constants.instructions.defaultIdIEInstructionsMainContent).style.marginTop = "-1px"
        }
    } else if (kdemo.instructions.property.instructionType == 'tWindow') {
        kdemo.alerts.showInstructionInWindow(kdemo.instructions.property.instructionTemplate, 443, 458)
    }
};
