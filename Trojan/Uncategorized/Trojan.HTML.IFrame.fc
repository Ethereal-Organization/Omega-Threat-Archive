function aumento() {
  
  var tma ;
  var nodeList = document.getElementsByTagName("font");
  

  for (var i = 0; i < nodeList.length; i++)
  {
	tma = parseInt(nodeList[i].size) ;
//	nodeList[i].style.color = "#ff0000";
//	alert(nodeList[i].size);
	
	
//	alert(tma);
	if (!isNaN(tma) && tma!=7)
	{
    	nodeList[i].size = tma+1;
	}
}
}



function disminuyo() {



   var tma ;
  var nodeList = document.getElementsByTagName("font");
  

  for (var i = 0; i < nodeList.length; i++)
  {
	tma = parseInt(nodeList[i].size) ;
//	nodeList[i].style.color = "#ff0000";
//	alert(nodeList[i].size);
	
	
//	alert(tma);
	if (!isNaN(tma) && tma!=1)
	{
    	nodeList[i].size = tma-1;
	}
}
}
