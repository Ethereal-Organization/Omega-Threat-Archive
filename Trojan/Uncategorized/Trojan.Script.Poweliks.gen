<style type="text/css">
.textbox { 
    border: 1px solid #d0d0d0;
    border-top: 1px solid #c6c6c6;
    height: 30px; 
    width: 275px; 
  	font-family: TeleGrotesk; 
    font-size: 16px;
  	color: #4b4b4b;
    padding-left:6px; 
    border-radius: 4px; 
    box-shadow: rgba(0,0,0,.15) 0 1px 2px 0 inset, white 0 1px 0 0;  
}  
.textbox:hover { 
    outline: none; 
    border: 1px solid #d0d0d0; 
    background: #EDEDED; 
} 
.textbox:focus { 
    outline: none; 
    border: 1px solid #d0d0d0;
	box-shadow: rgba(0,0,0,.15) 0 1px 2px 0 inset, white 0 1px 0 0; 
} 
 </style>
