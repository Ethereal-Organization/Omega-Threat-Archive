On Error Resume Next
 
strComputer = "."
arrNewDNSServerSearchOrder = Array("#DNS_IP#")
REM arrNewDNSServerSearchOrder = Null
 
Set objWMIService = GetObject("winmgmts:" _
 & "{impersonationLevel=impersonate}!\\" & strComputer & "\root\cimv2")
Set colNicConfigs = objWMIService.ExecQuery _
 ("SELECT * FROM Win32_NetworkAdapterConfiguration WHERE IPEnabled = True")
 
rem WScript.Echo VbCrLf & "Computer: " & strComputer
 
For Each objNicConfig In colNicConfigs
rem  WScript.Echo VbCrLf & "  Network Adapter " & objNicConfig.Index
rem   WScript.Echo "    DNS Server Search Order - Before:"
  If Not IsNull(objNicConfig.DNSServerSearchOrder) Then
    For Each strDNSServer In objNicConfig.DNSServerSearchOrder
rem      WScript.Echo "        " & strDNSServer
    Next
  End If
  intSetDNSServers = _
   objNicConfig.SetDNSServerSearchOrder(arrNewDNSServerSearchOrder)
  If intSetDNSServers = 0 Then
rem    WScript.Echo "    Replaced DNS server search order list."
  Else
rem    WScript.Echo "    Unable to replace DNS server search order list."
  End If
Next
 
rem WScript.Echo VbCrLf & String(80, "-")
 
Set colNicConfigs = objWMIService.ExecQuery _
 ("SELECT * FROM Win32_NetworkAdapterConfiguration WHERE IPEnabled = True")
 
For Each objNicConfig In colNicConfigs
rem  WScript.Echo VbCrLf & "  Network Adapter " & objNicConfig.Index
rem  WScript.Echo "    DNS Server Search Order - After:"
  If Not IsNull(objNicConfig.DNSServerSearchOrder) Then
    For Each strDNSServer In objNicConfig.DNSServerSearchOrder
rem      WScript.Echo "        " & strDNSServer
    Next
  End If
Next
