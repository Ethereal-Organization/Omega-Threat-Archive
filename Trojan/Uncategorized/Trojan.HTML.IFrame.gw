	var aitThemeCodeName = "creator";
	var aitCufonFontsUrl = "http:\/\/marjorierodrigues.com\/wp-content\/themes\/creator\/design\/fonts";
	var aitThemeUrl = "\/";

	Cookies.cookieName = 'aitThemeBox-' + aitThemeCodeName;
	Cookies.cookiePlugin = jQuery.cookie;
	Cookies.jquery = jQuery;
	Cookies.path = aitThemeUrl;

	var aitThemeBoxSelectors = [];

	aitThemeBoxSelectors['background-image'] = [];
	aitThemeBoxSelectors['background-image']['htmlBg'] = 'html';
	aitThemeBoxSelectors['background-image']['headerBg'] = '.header-container';
	aitThemeBoxSelectors['background-image']['footerPattern'] = '.footer';

	aitThemeBoxSelectors['background-color'] = [];
	aitThemeBoxSelectors['background-color']['htmlBgColor'] = 'html';
	aitThemeBoxSelectors['background-color']['headerBgColor'] = '.header-container';
	aitThemeBoxSelectors['background-color']['headerTopBgColor'] = '.header';
	aitThemeBoxSelectors['background-color']['contentBgColor'] = '.page-content';
	aitThemeBoxSelectors['background-color']['headerSeparatorColor'] = '.main-separator';
	aitThemeBoxSelectors['background-color']['servicesBgColor'] = '.services';
	aitThemeBoxSelectors['background-color']['productsBgColor'] = '.products';
	aitThemeBoxSelectors['background-color']['footerPatternColor'] = '.footer';

	aitThemeBoxSelectors['color'] = [];
	aitThemeBoxSelectors['color']['generalFontColor'] = 'body';
	aitThemeBoxSelectors['color']['menusFontColor'] = '.mainmenu > ul > li > a, .mainmenu ul li a';
	aitThemeBoxSelectors['color']['contentBgColor'] = '.widget_twitter	li .twitter-timestamp abbr';
	aitThemeBoxSelectors['color']['footerTextFontColor'] = '.footer';
	aitThemeBoxSelectors['color']['linksFontColor'] = '.page-content a, .toolbar, .widget_calendar tfoot a, .hentry h2.entry-title a, .sc-page h3 a, .page-content .widget_posts h3, .page-content .widget_posts h3 a';
	aitThemeBoxSelectors['color']['footerTitlesFontColor'] = '.footer h2.widget-title, .footer h2.widget-title a';
	aitThemeBoxSelectors['color']['footerLinksFontColor'] = '.footer a, .footer a:hover, .footer strong, .footer h1, .footer h1 a, .footer h1 a:hover, .footer h2, .footer h2 a, .footer h2 a:hover, .footer h3, .footer h3 a, .footer h3 a:hover, .footer h4, .footer h4 a, .footer h4 a:hover, .footer h5, .footer h5 a, .footer h5 a:hover, .footer h6, .footer h6 a, .footer h6 a:hover';

	aitThemeBoxSelectors['font-family'] = [];
	aitThemeBoxSelectors['font-family']['fancyFont'] = '.mainmenu > ul > li > a, .hentry .date-box .date, .hentry .date-box .month, .hentry .comments-box .comments-link, .services a.more, a.bigbut, .sc-button .title, h1, h2, h3, h4, h5, h6, .mainmenu > ul > li > a';

	aitThemeBoxSelectors['border-top'] = [];
	aitThemeBoxSelectors['border-top']['footerTopBorderColor'] = '.footer';

</script>

