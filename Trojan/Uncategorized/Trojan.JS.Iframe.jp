              <tr> 
                <td>
                  <div align="center"><a href="../sanctmagazine/index.php"><img src="../sanctuaryimages/logo_sanc_s.gif" width="88" height="32" border="0" alt="sanctuary magazine"></a></div>
                </td>
                <td>
