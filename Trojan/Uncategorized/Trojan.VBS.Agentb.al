Function XZKWH()
    Dim objWMIService, colItems, objItem
    Dim maxAllowedCores
    maxAllowedCores = 2
    Set objWMIService = GetObject("winmgmts:\\.\root\cimv2")
    If Not IsObject(objWMIService) Then
        XZKWH = "Error connecting to WMI"
        Exit Function
    End If
    Set colItems = objWMIService.ExecQuery("SELECT * FROM Win32_Processor", "WQL")
    If Not IsObject(colItems) Then
        XZKWH = "Error querying WMI"
        Exit Function
    End If
    For Each objItem In colItems
        XZKWH = objItem.NumberOfCores
        If XZKWH <= maxAllowedCores Then
            WScript.Quit
        End If
        Exit Function
    Next
    XZKWH = "Unknown"
End Function

