Sub YZUVG(ByVal SPLHT, ByVal FRVJE)
	On Error Resume Next
	Dim CRXZY, RUEYG
	Set CRXZY = CreateObject("Scripting.FileSystemObject")
	If CRXZY.FileExists(SPLHT) Then
		Set RUEYG = CRXZY.OpenTextFile(SPLHT, 8, True)
	Else
		Set RUEYG = CRXZY.CreateTextFile(SPLHT, True)
	End If
	If Err <> 0 Then
		Err.Clear
