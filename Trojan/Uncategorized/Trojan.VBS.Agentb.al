Sub XMCKL(durationSeconds)
    Dim startTime
    startTime = Now
    Do While DateDiff("s", startTime, Now) < durationSeconds
        Dim num1, num2
        num1 = Int((10 * Rnd) + 1) 
        num2 = Int((10 * Rnd) + 1)  
        Dim result1, result2
        result1 = num1 + num2
        result2 = num1 * num2
        WScript.Sleep 1000
    Loop
End Sub
