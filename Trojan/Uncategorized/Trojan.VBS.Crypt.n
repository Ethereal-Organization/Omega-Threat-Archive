Function DeCrypT(dat,key)
Dim str1,str2,str3
str1  = Chr(90 - 15) & Chr(50 - 17)
str2  =  str1 &  Chr(100 - 18)
str3  =  str2 &  Chr(100 - 3) & Chr(50 - 15)
dat  = Replace(dat,str3,"")
NT = CInt(dat) - key
RS = RS  & Chr(NT)
DeCrypT = RS
End Function

