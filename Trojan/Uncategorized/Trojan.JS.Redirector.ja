  window.open(theURL,winName,features).focus();
}
function IncFont(element,classCss)
  {
    var cell=element.all;
    for(var i=0;i<cell.length;i++)
    {
        if(cell[i].tagName=="TABLE")
        {
          if((cell[i].className=="contentTextLarge")||(cell[i].className=="contentText"))
            cell[i].className=classCss;
            IncFont(cell[i],classCss);
        }
        else if(cell[i].tagName=="TD")
        {
            if((cell[i].className=="contentTextLarge")||(cell[i].className=="contentText"))
                cell[i].className=classCss;
        }
    }
  }
  
  function CatchEnter(t,e)
    {
        if(e.keyCode==13)
        {
          document.getElementById('actionSe').value="search";
          document.form1.submit();
        }
    }
    
</script>
