/* Step 1: Build an Animation */
@-webkit-keyframes aniload {
from {opacity:0;}
to   {opacity:1;}
}
@-moz-keyframes aniload {
from {opacity:0;}
to   {opacity:1;}
}
@-ms-keyframes aniload {
from {opacity:0;}
to   {opacity:1;}
}
@keyframes aniload {
from {opacity:0;}
to   {opacity:1;}
}
/* Step 1: Build the Animation */
@-webkit-keyframes unikbanget {
from {-webkit-transform:translate(0px, 1000px)}
to   {-webkit-transform:translate(0px, 0px)}
}
@-moz-keyframes unikbanget {
from {-moz-transform:translate(0px, 1000px)}
to   {-moz-transform:translate(0px, 0px)}
}
@-ms-keyframes unikbanget {
from {-ms-transform:translate(0px, 1000px)}
to   {-ms-transform:translate(0px, 0px)}
}
@-o-keyframes unikbanget {
from {-ms-transform:translate(0px, 1000px)}
to   {-ms-transform:translate(0px, 0px)}
}
@keyframes unikbanget {
from {transform:translate(0px, 1000px)}
to   {transform:translate(0px, 0px)}
}
body {
-webkit-animation:aniload 2s;
-moz-animation:aniload 2s;
-ms-animation:aniload 2s;
animation:aniload 2s;
}
