/* -- CSS RESET -- */
html, body, div, span, applet, object, iframe, h1, h2, h3, h4, h5, h6, p, blockquote, pre, a, abbr, acronym, address, big, cite, code, del, dfn, em, font, img, ins, kbd, q, s, samp, small, strike, strong, sub, sup, tt, var,
b, u, i, center, dl, dt, dd, ol, ul, li, form, label,
table, caption, tbody, tfoot, thead, tr, th, td{margin:0;  padding:0;  border:0; outline:0;  vertical-align:baseline;  background:transparent
}
/* ELEMEN UTAMA */
body {
font: 100% Arial, Helvetica, Sans-serif;
color: #222;
text-align: left;
background-image: url(data:image/png;base64,);
background-color: gainsboro;
-webkit-transition: all .5s ease-in;
-moz-transition: all .5s ease-in;
-ms-transition: all .5s ease-in;
transition: all .5s ease-in;
}
#wrapper { background-image: url(data:image/png;base64,); background-attachment: fixed;
-moz-box-shadow:0px 0px 10px 2px rgba(119, 119, 119, 0.75);
-webkit-box-shadow:0px 0px 10px 2px rgba(119, 119, 119, 0.75);
box-shadow:0px 0px 10px 2px rgba(119, 119, 119, 0.75);
border-right:1px solid #ddd; border-left:1px solid #ddd; font-size:14px;
margin: 30px auto -45px auto;
width:970px; overflow:hidden;
-webkit-transition: all .5s ease-in;
-moz-transition: all .5s ease-in;
-ms-transition: all .5s ease-in;
transition: all .5s ease-in;
}
#kotak-kontent {margin:0; padding-bottom: 50px; overflow:hidden;border-top: 2px solid #CCC;
-webkit-transition: all .5s ease-in;
-moz-transition: all .5s ease-in;
-ms-transition: all .5s ease-in;
transition: all .5s ease-in;
}
/* HEADER */
#kepala { background:#000; height:auto; margin:0; padding:10px; overflow:hidden;border: 2px solid white;border-top:none;
-webkit-transition: all .5s ease-in;
-moz-transition: all .5s ease-in;
-ms-transition: all .5s ease-in;
transition: all .5s ease-in;
}
#kepala-kanan{background:black; float:left; width:212px; margin:0px 5px 0px 0px; padding:0; height:90px; overflow:hidden;
}
#kepala-kiri{background:white;float:right; width:728px; height:90px; text-align:center; overflow:hidden;
}
#kepala-kanan img { margin:0; padding:0;
}
#kepala-kiri img {width:728px; height:90px; margin:0; padding:0;
}
#kepala-kanan h1.title {font:24px georgia, serif; font-weight:bold; color:#2b801c; text-shadow:1px 1px #ddd; text-align:center; margin:0px; padding:6px 0 8px;
}
#kepala-kanan h1.logo, #kepala-kanan p.logo {margin:0; padding:0;
}
#kepala-kanan .description { text-align:center; color:#666; margin:0; padding:4px 0 8px;
}
#Header1{margin-top:24px;
}
/* TEXT AND HEADING */
h1{font-size:30px;}h2{font-size:24px;}h3{font-size:20px;}h4{font-size:18px;}h5{font-size:16px;}h6{font-size:14px;
}
p{ padding-bottom:13px
}
h1.title a, p.title a{color:#2b801c;
}
p.title {font-weight:bold; font:26px georgia, serif; text-align:center; text-shadow:1px 1px #ddd; margin:0; padding:6px 0 8px;
}
.post ul{margin: 0 0 13px 28px; list-style-type:disc
}
.post ol{margin:0 0 13px 28px; list-style-type:decimal
}
.post ul li, ol li{padding-bottom:3px
}
.post table {border-collapse:collapse; margin:0 auto 10px;
}
.post table, .post th, .post td { padding:3px 6px; border:1px solid #ccc; vertical-align:top;
}
.post table th { background:#e5e5e5;
}
.post blockquote { background: url(data:image/png;base64,) no-repeat scroll 15px 15px transparent;
border: 1px solid #EEEEEE;
color: #777777;
font-family: Georgia,"Times New Roman",Times,serif;
font-size: 15px;
font-style: italic;
line-height: 20px;
margin-bottom: 20px;
padding: 15px 15px 15px 60px;
border-left: 3px solid #ddd;
clear:both;
}
img{max-width:100%;
}
.widget-content ul { list-style-type:none; margin:0; padding:0
}
/* LINK LINK */
a:link {
color:#2B8012;
text-decoration:none;
}
a:visited {
color:#2B8012;
text-decoration:none;
}
.mobile-post-outer a:visited{
}
a:hover{text-decoration:underline overline; color:rgb(43, 128, 18);-webkit-transition: 0.5s;
-moz-transition: 0.5s;
-o-transition: 0.5s;
-ms-transition: 0.5s;
transition: 0.5s;}
#footer a:hover, #sidebar .widget-content ul li a:hover, .post-footer a:hover {color:#2B8012;
}
a.ngkot { -webkit-border-radius: 10px; -moz-border-radius: 10px; border-radius: 10px; -moz-box-shadow:1px 1px 5px rgba(1,1,1,.1); -webkit-box-shadow:1px 1px 5px rgba(1,1,1,.1); box-shadow:1px 1px 5px rgba(1,1,1,.1); background:#4d8e0c; font-size:13px; color:#fff; text-shadow:1px 1px #196d09; margin:8px 0; display:block; padding:2px 8px;
}
a.ngkot:hover { background:#196d09;
}
.post h2.post-title a, .post h2.post-title a:visited, .post h1.post-title, .post h1.post-title a{color:#2B8012;
}
.post h2.post-title a:hover{color:rgb(43, 128, 18);
}
/* KONTEN POSTING */
#posting{ float:left; width:640px; margin:0px 0px 0px 10px; padding:0;-webkit-transition: all .5s ease-in;
-moz-transition: all .5s ease-in;
-ms-transition: all .5s ease-in;
transition: all .5s ease-in;
}
#kotak-posting { padding:10px;
margin:0; border-right:1px solid #ccc;
overflow:hidden; word-wrap:break-word;
background: white;
border-left: 1px solid #CCC;
border-bottom: 1px solid #CCC;-webkit-transition: all .5s ease-in;
-moz-transition: all .5s ease-in;
-ms-transition: all .5s ease-in;
transition: all .5s ease-in;
}
.post h1.post-title {border: 1px solid #CCC;
border-bottom: 0px; text-align:center;font-size:17px; font-weight:bold; text-shadow:1px 1px #ddd;font-variant: small-caps;padding:5px;}
.post h2.post-title { font-size:16px; font-weight:bold; margin:0 0 6px 0; text-shadow:1px 1px #ddd;font-variant: small-caps;}
.post-body { text-align: justify; line-height:1.5;
margin:0; padding:0;color: #666666;
}
.post-body a:link, a:visited, a:hover{color: #2B8012;}
#blog-pager-newer-link {
clear:both;
float:left
}
#blog-pager-older-link {
clear:both;
float:right
}
.home {width:80px; margin:0 auto; text-align:center;
}
.status-msg-wrap, .status-msg-border{display:none;
}
#under_kontent {
position: relative;
clear: both;
margin: 0px auto 0px;
color: #000000;
width: 100%;
font-size: 89%;
text-transform: capitalize;
}
#under_kontent h2{font-family: Harrington;
font-size: 25px;
color: #333;
Gtext-align: left;
padding: 4px 0 2px;
text-shadow: 1px 1px white;margin-top:20px;width:307px;}
#under_kontent .widget-content {
background: transparent;
margin: 0px;
padding: 10px 5px 5px 5px;
margin-bottom: 10px;
}
#under_kontent .widget-content ul li {
border-bottom: 1px dashed #aaa;
margin: 0 3px 0px 3px;
padding: 0px 0px 6px 0px;
}
#under_kontent .widget-content ul li a {
font-weight: bold;
color: #2b8012;
text-shadow: 1px 1px #ddd;
}
#underkontent, #serkiri {
width: 306.5px;
margin-left: 10px;
float: left;
}
#underkontent2, #serkanan {
width: 306.5px;
margin-left: 13px;
float: left;
}
#serbaserbi a h2{color:#000;}
.serbaserbiall li {
margin: 0;
padding: 5px 0;
line-height: 1.5em;
text-transform: capitalize;
border-bottom: 1px dotted #BABABA;
}
#serkiri .widget-content, #serkanan .widget-content, #sidebarportal .widget-content {
padding: 10px;
color: #666;
line-height: 1.5em;
font-family: Georgia,Arial,Verdana;
font-size: 13px;
}
#serkiri .widget.HTML, #serkanan .widget.HTML, #sidebarportal .widget.HTML{
border: 1px solid #C9C7C7;
background: #F4F4F4;
margin-bottom: 15px !important;
border-image: initial;
-webkit-border-top-left-radius: 30px;
-webkit-border-top-right-radius: 10px;
-moz-border-radius-topleft: 30px;
-moz-border-radius-topright: 30px;
border-top-left-radius: 30px;
border-top-right-radius: 30px;
position:relative
overflow: hidden;
}
#serbaserbi {
position: relative;
clear: both;
margin: 0px auto 0px;
color: #000000;
float: left;
padding: 10px 0;
width: 100%;
}
.serbaserbiall h2 {
margin: 0px;
padding: 5px;
font-size: 26px;
text-shadow: 1px 1px 1px white;
border-top: 1px solid white;
border-right: 1px solid white;
border-left: 1px solid white;
border-bottom: 1px solid #BABABA;
background: #E4E4E4;
font-family: Harrington;
text-align: center;
-webkit-border-top-left-radius: 10px;
-webkit-border-top-right-radius: 10px;
-moz-border-radius-topleft: 10px;
-moz-border-radius-topright: 10px;
border-top-left-radius: 10px;
border-top-right-radius: 10px;
}
img.label_thumb{
float:left;
padding:3px;
border:1px solid #8f8f8f;
background:#D2D0D0;
margin-right:7px;
height:55px;
width:55px;
}
img.label_thumb:hover{
background:#f7f6f6;
}
.label_with_thumbs {
float: left;
width: 100%;
min-height: 70px;
margin: 0px 10px 2px 0px;
padding: 0;
}
ul.label_with_thumbs li {
padding:8px 0;
min-height:65px;
margin-bottom:10px;
}
.label_with_thumbs a {color: #2b8012 !important;
text-shadow: 1px 1px #ddd;}
.label_with_thumbs strong {}
/* SIDEBAR */
#sidebar{float:right; width:320px; margin:0; padding:0;text-transform: uppercase;
font-size: 80%;-webkit-transition: all .5s ease-in;
-moz-transition: all .5s ease-in;
-ms-transition: all .5s ease-in;
transition: all .5s ease-in;
}
#sidebarportal{float:right; width:300px; margin:0; padding:0;text-transform: capitalize;
font-size: 80%;-webkit-transition: all .5s ease-in;
-moz-transition: all .5s ease-in;
-ms-transition: all .5s ease-in;
transition: all .5s ease-in;
}
#kotak-sidebar { padding:0; margin:10px;
overflow:hidden;
word-wrap:break-word; -webkit-transition: all .5s ease-in;
-moz-transition: all .5s ease-in;
-ms-transition: all .5s ease-in;
transition: all .5s ease-in;
}
#kotak-sidebar-bawah { padding:0; margin:0px 10px 10px 10px;
overflow:hidden;
word-wrap:break-word;-webkit-transition: all .5s ease-in;
-moz-transition: all .5s ease-in;
-ms-transition: all .5s ease-in;
transition: all .5s ease-in;
}
#kotak-sidebar-kiri {float:left; margin:0px 5px 10px 10px; padding:0; width:145px; overflow:hidden;-webkit-transition: all .5s ease-in;
-moz-transition: all .5s ease-in;
-ms-transition: all .5s ease-in;
transition: all .5s ease-in;
}
#kotak-sidebar-kanan {float:right; margin:0px 10px 10px 5px; width:145px; overflow:hidden;-webkit-transition: all .5s ease-in;
-moz-transition: all .5s ease-in;
-ms-transition: all .5s ease-in;
transition: all .5s ease-in;
}
#sidebar h2, #sidebar h3 { font-family: Harrington;
font-size:25px; color:#333; text-align:left; padding:4px 0 2px; border-bottom: 2px solid rgb(190, 190, 190);margin-top: 25px;text-shadow:1px 1px white;
}
#sidebar .widget-content { background:transparent; margin:0px; padding: 10px 5px 5px 5px; margin-bottom: 10px;
}
#sidebar .widget-content ul li { border-bottom: 1px dashed #aaa; margin:0 0 8px 10px; padding:0px 0px 6px 0px;
}
#sidebar .widget-content ul li a {font-weight:bold; color:#2b8012; text-shadow:1px 1px #ddd;
}
#sidebar .item-snippet {font-size:12px;
}
#sidebar .item-thumbnail { background:#fff; margin:3px 8px 8px 0px; padding:5px; border:1px solid #ddd; -moz-box-shadow:1px 1px 5px rgba(1,1,1,.1); -webkit-box-shadow:1px 1px 5px rgba(1,1,1,.1); box-shadow:1px 1px 5px rgba(1,1,1,.1);
}
/* LAIN LAIN */
.clear{clear:both;}
.breadcrumbs { background:#fff; text-align: left; padding:3px 0; margin:0 0 10px 0; font-size:13px; line-height: 1.4em;  border-bottom:1px dotted #ccc;
}
/* FOOTER */
#footerz{background:#fff; color:#333; text-align:center; height:auto; font-size:13px; padding-top:5px; border-top: #AAA solid 3px;margin:0px;
}
#footer a, #footerz a{color:#666;
}
/* NAVIGASI */
#navigation {float:left;margin-right: 5px; list-style: none; height: 36px; margin:0; padding:0;
}
#navigation li { position:relative; float: left; height: 36px;
}
#navigation li a.pertama, #navigation li a.pertama:hover { border-left:medium none !important;
}
#navigation li a, #navigation li a:link, #navigation li a:visited {
display: block;
float: left;
height: 36px;
color: #333;
line-height: 36px;
padding: 0 9px 0 9px;
border-right: solid 1px #EEE;
font-weight: bold;
font-variant: small-caps;
font-size: 15px;
}
#navigation li a:hover, #navigation li a:focus, #navigation li a:active { background:#4d8e0c; color:#fff;
}
#navigasi { height:36px; max-width:100%; background:#fff url(data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABQAAAAmCAMAAADz5UuZAAAAD1BMVEXj4ODv7O339fX7+fj///8siO65AAAAJUlEQVR42u3IoQEAMAgAoE39/2YfIFhsEnlzH5wBzgRnweXlajYJoApR1cBcIgAAAABJRU5ErkJggg==) repeat-x; margin:0; padding:0px; border-top:1px solid #ddd; border-bottom: 2px solid #ccc;
}
#navigasi #search{ width:220px; float:right; margin:5px 10px 5px 10px;
}
#navigasi #search input[type="text"] {height:24px; line-height:24px; background: url(http://3.bp.blogspot.com/-qcqxuwepuw8/T7Ts0Iso9VI/AAAAAAAAAkg/oGskZqNwrZY/s1600/search_icon.gif) no-repeat 8px 1px #fff; border: 0 none; font: bold 12px; color: #333; width: 172px; padding: 0 15px 0 32px; -webkit-border-radius: 12px; -moz-border-radius: 12px; border-radius: 12px; border:1px solid #eee; -webkit-box-shadow: 0px 1px 0px rgba(255, 255, 255, 0.3) , inset 0px 1px 3px rgba(0, 0, 0, 0.2); -moz-box-shadow: 0px 1px 0px rgba(255, 255, 255, 0.3) , inset 0px 1px 3px rgba(0, 0, 0, 0.2); box-shadow: 0px 1px 0px rgba(255, 255, 255, 0.3) , inset 0px 1px 3px rgba(0, 0, 0, 0.2); -webkit-transition: all 0.7s ease 0 s; -moz-transition: all 0.7s ease 0s; -o-transition: all 0.7s ease 0s; transition: all 0.7s ease 0s;
}
#navigasi #search input[type="text"]:focus { width: 172px;
}
#blog-pager {
clear: both;
text-transform: uppercase;
font-size: 13px;
-webkit-border-radius: 4px;
-moz-border-radius: 4px;
border-radius: 4px;
margin: 6px 0 0;
padding: 10px 5px 5px 5px;
border: 1px solid #DDD;
background: #f6f6f6;
box-shadow: inset 0 1px 0 rgb(255, 255, 255),0 0 1px rgb(255, 255, 255);
}
