<style>
 .footer-outer{display:none}
#autonav {
  position:fixed;
  top:0px;
  right:0px;
  left:0px;
  z-index:99;
  margin:0px 0px;
  padding:0px 0px;
  font:normal 11px Arial,Sans-Serif;
  color:white  !important;
   text-transform:uppercase;font-weight:bold;
width:100%;
border-bottom: 2px solid rgba(51, 51, 51, 0.9);
  -webkit-box-shadow:0px 1px 7px rgba(0,0,0,0.4);
  -moz-box-shadow:0px 1px 7px rgba(0,0,0,0.4);
  box-shadow:0px 1px 7px rgba(0,0,0,0.4);
}

#autonav ul {
margin: 0px 0px;
padding: 0px 0px;
height: 30px;
background-color: rgba(105, 105, 105, 0.9) !important;
}

#autonav ul li {
  list-style:none;
  display:inline;
  float:left;
  margin:0px 0px;
  padding:0px 0px;
  position:relative;
}

#autonav ul li a {
display: block;
line-height: 30px;
height: 30px;
overflow: hidden;
margin: 0px 0px;
padding: 0px 15px;
border-left: 1px solid rgb(149, 151, 151);
border-right: 1px solid rgb(0, 0, 0);
text-decoration: none;
text-shadow: 0px -1px 0px rgba(0,0,0,0.4);
color: white !important;
font-weight: bold;
}

#autonav ul li a:hover,
#autonav ul li:hover > a {
 background-color:rgb(68, 68, 68) !important;;
}


#autonav ul ul {
  position:absolute;
  width:340px;
  height:auto;
  top:100%;
  left:0px;
  z-index:99;
  background-color:#222  !important;
  background-image: url(data:image/png;base64,); background-attachment: fixed;
  -webkit-box-shadow:0px 1px 3px rgba(0,0,0,0.7);
  -moz-box-shadow:0px 1px 3px rgba(0,0,0,0.7);
  box-shadow:0px 1px 3px rgba(0,0,0,0.7);
  overflow:visible !important;
  display:none;
}

#autonav ul ul.komentar{
  right:0px;
  left:auto;

}

#autonav ul ul.pages{
  right:0px;
  left:auto;
width:85px !important;
}

