  content:"";
  width:0px;
  height:0px;
  border:7px solid transparent;
  border-bottom-color:#111  !important;
  position:absolute;
  top:-14px;
  right:24px;
  left: auto;
}

#autonav ul ul.pages:before {
  content:"";
  width:0px;
  height:0px;
  border:7px solid transparent;
  border-bottom-color:#111  !important;
  position:absolute;
  top:-14px;
  right:24px;
  left: auto;
}

