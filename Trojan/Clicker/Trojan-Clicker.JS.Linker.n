<SCRIPT LANGUAGE="JavaScript">
var adExpiration = 60;
var currentDate = new Date();
currentDate.setTime(currentDate.getTime() + 86400000);
        adExpiration = currentDate.toGMTString();

function SetCookie(sName, sValue, sExpire){
        var expireCode = "";
        if (sExpire) { expireCode =  "expires=" + sExpire + ";" }
        document.cookie = sName + "=" + escape(sValue) + ";" + expireCode
        }
        SetCookie("cood","03", adExpiration);
        SetCookie("total","1", adExpiration);
        SetCookie("popper","1", adExpiration);

</script>


