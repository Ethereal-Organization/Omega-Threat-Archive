 IF NOT $ISCOLORREF THEN
 $I_TRANSCOLOR = INT ( BINARYMID ( $I_TRANSCOLOR , 3 , 1 ) & BINARYMID ( $I_TRANSCOLOR , 2 , 1 ) & BINARYMID ( $I_TRANSCOLOR , 1 , 1 ) )
 ENDIF
