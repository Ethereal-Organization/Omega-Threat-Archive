 FUNC _WINAPI_GETOBJECT ( $HOBJECT , $ISIZE , $POBJECT )
 LOCAL $ARESULT = DLLCALL ( "gdi32.dll" , "int" , "GetObjectW" , "handle" , $HOBJECT , "int" , $ISIZE , "ptr" , $POBJECT )
 IF @ERROR THEN RETURN SETERROR ( @ERROR , @EXTENDED , 0 )
 RETURN $ARESULT [ 0 ]
