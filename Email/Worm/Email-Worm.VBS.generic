AUWAHCOGHVEKB(MDNZRVCFCUDAPOVWSJGL,1)=AUWAHCOGHVEKB(MDNZRVCFCUDAPOVWSJGL,1)&mid(IPKIXHRRAL,KKURJENGESPVIIZBNJEHDIHFIFUJUFSPEZKPPHVHAMFPZBLRYYQLUIQHIUKIYCRAVQKRTSFY,1)
